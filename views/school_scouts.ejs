<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scouts & Groups - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style>
        .scout-card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 0.75rem; background: var(--card); transition: var(--transition-base); }
        .scout-card:hover { box-shadow: var(--shadow-soft); }
        .scout-name { font-weight: 600; font-size: 1.1rem; color: var(--foreground); }
        .scout-meta { font-size: 0.9rem; color: var(--muted-foreground); margin-top: 0.25rem; }
        .badge-section { margin-top: 0.5rem; }
        .badge { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; margin-right: 0.25rem; }
        .badge-primary { background: var(--primary); color: var(--primary-foreground); }
        .badge-secondary { background: var(--secondary); color: var(--secondary-foreground); }
        .empty-state { text-align: center; padding: 3rem 1rem; color: var(--muted-foreground); }
        .empty-state svg { width: 64px; height: 64px; margin-bottom: 1rem; opacity: 0.5; }
        .action-btns { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
        .tab-container { border-bottom: 1px solid var(--border); margin-bottom: 1rem; display: flex; gap: 1rem; }
        .tab-btn { border: none; background: none; padding: 0.75rem 1rem; cursor: pointer; border-bottom: 2px solid transparent; font-weight: 500; color: var(--muted-foreground); }
        .tab-btn.active { border-bottom-color: var(--primary); color: var(--primary); }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }
        .group-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .group-stats { display: flex; gap: 1rem; font-size: 0.9rem; color: var(--muted-foreground); }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path><path d="M3 6h18"></path><path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Scouts & Groups</h1>
                <div class="header-actions">
                    <button type="button" class="btn btn-primary" id="addScoutBtn">+ Add Scout</button>
                </div>
            </header>

            <div class="dashboard-content">
                <div class="stats-section" style="margin-bottom: 1.5rem;">
                    <div class="stat-card" style="flex:1;max-width:200px;">
                        <span class="stat-value" id="totalScouts"><%= scouts ? scouts.length : 0 %></span>
                        <span class="stat-label">Total Scouts</span>
                    </div>
                    <div class="stat-card" style="flex:1;max-width:200px;">
                        <span class="stat-value"><%= groups ? groups.length : 0 %></span>
                        <span class="stat-label">Active Groups</span>
                    </div>
                </div>

                <div class="tab-container">
                    <button class="tab-btn active" data-tab="groups">Groups</button>
                    <button class="tab-btn" data-tab="scouts">All Scouts</button>
                </div>

                <div id="groupsTab" class="tab-panel active">
                    <% if (!groups || groups.length === 0) { %>
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <p>No scout groups configured yet. Add scouts and groups will be auto-created from sections.</p>
                        </div>
                    <% } else { %>
                        <div class="groups-list">
                            <% if (groups && groups.length > 0) { %>
                                <% groups.forEach(group => { %>
                                <div class="scout-card">
                                    <div class="group-header">
                                        <div>
                                            <h3 class="scout-name"><%= group.name %></h3>
                                             <div class="scout-meta">
                                                 Leader: <%= group.leaderName || 'Not assigned' %> • <%= group.memberCount || 0 %> members • <%= group.advancementLevel || 'N/A' %>
                                             </div>
                                             <% if (group.meetingSchedule) { %>
                                                 <div class="scout-meta">Meets: <%= group.meetingSchedule.day || 'TBD' %> at <%= group.meetingSchedule.time || 'TBD' %> (<%= group.meetingSchedule.location || 'TBD' %>)</div>
                                             <% } %>
                                        </div>
                                        <div class="group-stats">
                                            <span class="badge badge-primary"><%= group.memberCount || 0 %> scouts</span>
                                            <span class="badge badge-secondary"><%= group.advancementLevel || 'N/A' %></span>
                                        </div>
                                    </div>
                                </div>
                        <% }) %>
                        <% } else { %>
                            <div class="empty-state">
                                <p>No scouts found.</p>
                            </div>
                        <% } %>
                    </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>

                <div id="scoutsTab" class="tab-panel">
                    <div class="scouts-list" id="scoutsList">
                        <% if (scouts && scouts.length > 0) { %>
                            <% scouts.forEach(scout => { %>
                            <div class="scout-card" data-id="<%= scout._id %>">
                                <div class="scout-header">
                                    <h3 class="scout-name"><%= scout.fullName || 'Unnamed Scout' %></h3>
                                    <span class="badge badge-primary"><%= scout.scoutSection || 'Unassigned' %></span>
                                </div>
                                <div class="scout-meta">
                                    Gender: <%= scout.gender || 'N/A' %> • DOB: <%= scout.dateOfBirth ? new Date(scout.dateOfBirth).toLocaleDateString() : 'N/A' %> • Age: <%= scout.dateOfBirth ? Math.floor((new Date() - new Date(scout.dateOfBirth)) / (365.25*24*60*60*1000)) : 'N/A' %>
                                </div>
                                <div class="scout-meta">
                                    Parent: <%= scout.parentContact?.name || 'Unknown' %> (<a href="tel:<%= scout.parentContact?.phone || '' %>"><%= scout.parentContact?.phone || 'N/A' %></a>)
                                </div>
                                <div class="action-btns">
                                    <button class="btn btn-sm btn-outline edit-scout-btn" data-id="<%= scout._id %>" data-name="<%= scout.fullName %>" data-section="<%= scout.scoutSection %>">Edit</button>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Add/Edit Scout Modal -->
    <div id="scoutModal" class="modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
        <div class="modal-content" style="background:var(--card);padding:2rem;border-radius:var(--radius);max-width:500px;width:90%;max-height:90vh;overflow-y:auto;">
            <h3 id="modalTitle">Add Scout</h3>
            <form id="scoutForm" class="form-grid" style="gap:0.75rem;margin-top:1rem;">
                <input type="hidden" id="scoutId">
                <div class="form-group">
                    <label for="fullName">Full Name *</label>
                    <input type="text" id="fullName" name="fullName" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="dateOfBirth">Date of Birth *</label>
                    <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="gender">Gender *</label>
                    <select id="gender" name="gender" class="form-input" required>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="parentName">Parent/Guardian Name</label>
                    <input type="text" id="parentName" name="parentName" class="form-input">
                </div>
                <div class="form-group">
                    <label for="parentPhone">Parent Phone *</label>
                    <input type="tel" id="parentPhone" name="parentPhone" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="parentEmail">Parent Email *</label>
                    <input type="email" id="parentEmail" name="parentEmail" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="scoutSection">Scout Section *</label>
                    <select id="scoutSection" name="scoutSection" class="form-input" required>
                        <option value="Sungura">Sungura</option>
                        <option value="Chipukizi">Chipukizi</option>
                        <option value="Mwamba">Mwamba</option>
                        <option value="Rover">Rover</option>
                    </select>
                </div>
                <div class="form-actions" style="grid-column:1/-1;display:flex;gap:0.5rem;justify-content:flex-end;">
                    <button type="button" class="btn btn-secondary" id="cancelScoutBtn">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Tab switching
            const tabs = document.querySelectorAll('.tab-btn');
            const panels = document.querySelectorAll('.tab-panel');
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    panels.forEach(p => p.classList.remove('active'));
                    tab.classList.add('active');
                    document.getElementById(tab.dataset.tab + 'Tab').classList.add('active');
                });
            });

            // Modal handling
            const modal = document.getElementById('scoutModal');
            const form = document.getElementById('scoutForm');
            const addBtn = document.getElementById('addScoutBtn');
            const cancelBtn = document.getElementById('cancelScoutBtn');
            const editButtons = document.querySelectorAll('.edit-scout-btn');

            function openModal() { modal.style.display = 'flex'; }
            function closeModal() { modal.style.display = 'none'; form.reset(); document.getElementById('scoutId').value=''; }

            addBtn?.addEventListener('click', openModal);
            cancelBtn?.addEventListener('click', closeModal);
            window.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

            editButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const id = btn.dataset.id;
                    const name = btn.dataset.name;
                    const section = btn.dataset.section;
                    document.getElementById('scoutId').value = id;
                    document.getElementById('fullName').value = name;
                    document.getElementById('scoutSection').value = section;
                    // In full implementation, prefill all fields via API
                    openModal();
                });
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                const scoutId = data.scoutId;

                const url = scoutId ? `/api/school/scouts/${scoutId}` : '/api/school/scouts';
                const method = scoutId ? 'PUT' : 'POST';

                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await res.json();
                if (result.success) {
                    alert('Scout saved successfully');
                    closeModal();
                    location.reload();
                } else {
                    alert('Error: ' + result.error);
                }
            });
        });
    </script>
</body>
</html>
