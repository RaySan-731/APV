<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice <%= invoice.invoiceNumber %> - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../../partials/sidebar', { user, page: 'finance/invoices' }) %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Invoice Details</h1>
                <div class="btn-toolbar">
                    <a href="/finance/invoices" class="btn btn-outline-secondary btn-sm">Back to List</a>
                    <a href="/finance/invoices/<%= invoice._id %>/download" class="btn btn-primary btn-sm ms-2">Download PDF</a>
                </div>
            </header>

            <div class="container-fluid mt-4">
                <!-- Invoice Header -->
                <div class="card mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h3 class="text-primary"><%= invoice.invoiceNumber %></h3>
                                <p class="mb-1"><strong>School:</strong> <%= invoice.schoolId?.name || 'Unknown' %></p>
                                <p class="mb-1"><strong>Issue Date:</strong> <%= new Date(invoice.issueDate).toLocaleDateString() %></p>
                                <p class="mb-1"><strong>Due Date:</strong> <%= new Date(invoice.dueDate).toLocaleDateString() %></p>
                                <p class="mb-0"><strong>Status:</strong> 
                                    <span class="badge bg-<%= 
                                        invoice.status === 'paid' ? 'success' :
                                        invoice.status === 'overdue' ? 'danger' :
                                        invoice.status === 'partial' ? 'warning' :
                                        invoice.status === 'cancelled' ? 'secondary' :
                                        'primary'
                                    %>">
                                        <%= invoice.status %>
                                    </span>
                                </p>
                            </div>
                            <div class="col-md-6 text-end">
                                <h4>KES <%= invoice.totalAmount.toLocaleString() %></h4>
                                <p class="text-muted">Amount Paid: KES <%= invoice.amountPaid.toLocaleString() %></p>
                                <p class="text-danger fw-bold">Balance: KES <%= invoice.balance.toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Invoice Items -->
                <div class="card mb-4">
                    <div class="card-header"><h5 class="mb-0">Invoice Items</h5></div>
                    <div class="card-body">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>Description</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% invoice.items.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <%= item.description %>
                                            <% if (item.eventId) { %>
                                                <br><small class="text-muted">Event: <%= item.eventId?.name %></small>
                                            <% } %>
                                        </td>
                                        <td class="text-center"><%= item.quantity %></td>
                                        <td class="text-end">KES <%= item.unitPrice.toLocaleString() %></td>
                                        <td class="text-end">KES <%= item.total.toLocaleString() %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Subtotal:</th>
                                    <th class="text-end">KES <%= invoice.subtotal.toLocaleString() %></th>
                                </tr>
                                <tr>
                                    <th colspan="3" class="text-end">Total:</th>
                                    <th class="text-end">KES <%= invoice.totalAmount.toLocaleString() %></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <!-- Payment History -->
                <% if (payments && payments.length > 0) { %>
                    <div class="card mb-4">
                        <div class="card-header"><h5 class="mb-0">Payment History</h5></div>
                        <div class="card-body">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Amount</th>
                                        <th>Method</th>
                                        <th>Reference</th>
                                        <th>Notes</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% payments.forEach(payment => { %>
                                        <tr>
                                            <td><%= new Date(payment.paymentDate).toLocaleDateString() %></td>
                                            <td class="text-success fw-bold">KES <%= payment.amount.toLocaleString() %></td>
                                            <td><%= payment.method.replace('_', ' ') %></td>
                                            <td><%= payment.reference || '-' %></td>
                                            <td><%= payment.notes || '-' %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% } %>

                <!-- Payment Instructions -->
                <div class="card mb-4">
                    <div class="card-header"><h5 class="mb-0">Payment Instructions</h5></div>
                    <div class="card-body">
                        <p><strong>Bank:</strong> <%= invoice.bankDetails?.bankName || 'APV Ventures Ltd' %></p>
                        <p><strong>Account Name:</strong> <%= invoice.bankDetails?.accountName || 'Arrow-Park Ventures' %></p>
                        <p><strong>Account Number:</strong> <%= invoice.bankDetails?.accountNumber || '' %></p>
                        <p><strong>Branch:</strong> <%= invoice.bankDetails?.branch || '' %></p>
                        <p><strong>M-Pesa Till:</strong> <%= invoice.bankDetails?.mpesaTillNumber || '' %></p>
                    </div>
                </div>

                <!-- Record Payment (if not fully paid) -->
                <% if (invoice.status !== 'paid' && invoice.status !== 'cancelled') { %>
                    <div class="card">
                        <div class="card-body">
                            <form action="/finance/invoices/<%= invoice._id %>/payments" method="POST" enctype="multipart/form-data" class="payment-form" data-invoice="<%= invoice._id %>" data-balance="<%= invoice.balance %>" data-invoice-number="<%= invoice.invoiceNumber %>">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label">Payment Amount (KES)</label>
                                        <input type="number" name="amount" class="form-control payment-amount" max="<%= invoice.balance %>" step="0.01" min="0.01" required>
                                        <small class="text-muted">Outstanding: KES <%= invoice.balance.toLocaleString() %></small>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Payment Date</label>
                                        <input type="date" name="paymentDate" class="form-control payment-date" value="<%= new Date().toISOString().split('T')[0] %>" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Payment Method</label>
                                        <select name="method" class="form-select payment-method" required>
                                            <option value="mpesa">M-Pesa</option>
                                            <option value="bank_transfer">Bank Transfer</option>
                                            <option value="cheque">Cheque</option>
                                            <option value="cash">Cash</option>
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Reference <span class="text-muted cash-hint" style="display:none;">(optional — auto-generated for cash)</span></label>
                                        <input type="text" name="reference" class="form-control payment-reference" placeholder="e.g. MPESA-XXXX or Receipt #">
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Receipt / Proof of Payment <span class="text-muted cash-hint" style="display:none;">(not required for cash)</span></label>
                                        <input type="file" name="receipt" class="form-control payment-receipt" accept="image/jpeg,image/png,image/gif,application/pdf,.doc,.docx,.xls,.xlsx">
                                    </div>
                                    <div class="col-md-3 received-by-field" style="display:none;">
                                        <label class="form-label">Received By <span class="text-danger">*</span></label>
                                        <input type="text" name="received_by" class="form-control" placeholder="Name of person who handed over the cash">
                                        <small class="text-muted">Required for all cash payments.</small>
                                    </div>
                                    <div class="col-md-12">
                                        <div class="modal-payment-msg" style="display:none;"></div>
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end">
                                        <button type="submit" class="btn btn-success w-100 payment-submit-btn">Record Payment</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                <% } %>

            </div>
        </main>
    </div>

    <script src="/js/main.js"></script>
    <script>
    function showToast(message, type, duration) {
        duration = duration || 3000;
        type = type || 'info';
        var toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        toast.textContent = message;
        toast.style.cssText = 'position:fixed;top:20px;right:20px;padding:1rem 1.5rem;border-radius:6px;color:#fff;font-weight:500;z-index:10000;opacity:0;transform:translateY(-20px);transition:all 0.3s ease;';
        if (type === 'success')  toast.style.backgroundColor = '#198754';
        else if (type === 'error') toast.style.backgroundColor = '#dc3545';
        else if (type === 'warning') toast.style.backgroundColor = '#ffc107';
        else                          toast.style.backgroundColor = '#6c757d';
        document.body.appendChild(toast);
        setTimeout(function () { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; }, 10);
        setTimeout(function () {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-20px)';
            setTimeout(function () { toast.remove(); }, 300);
        }, duration);
    }

    document.addEventListener('DOMContentLoaded', function () {
        console.log('[payment-detail] DOMContentLoaded — starting payment form wiring');

        function updatePaymentModal(form) {
            var method  = form.querySelector('.payment-method');
            var isCash  = method && method.value === 'cash';
            var refRow  = form.querySelector('.payment-reference');
            var recRow  = form.querySelector('.received-by-field');
            var refHint = null;
            form.querySelectorAll('.cash-hint').forEach(function (el) { refHint = el; });

            if (refRow) { refRow.style.display = isCash ? '' : 'none'; }
            if (recRow) { recRow.style.display = isCash ? '' : 'none'; }
            if (refHint) refHint.style.display = isCash ? 'inline' : 'none';
        }

        function showMsg(form, type, html) {
            var el = form.querySelector('.modal-payment-msg');
            if (el) {
                el.className = 'alert alert-' + (type === 'error' ? 'error' : 'success');
                el.innerHTML  = html;
                el.style.display = 'block';
            }
        }

        function setSubmitState(btn, busy) {
            if (!btn) return;
            if (busy) { btn.dataset._orig = btn.textContent; btn.textContent = 'Recording\u2026'; btn.disabled = true; }
            else       { btn.textContent = btn.dataset._orig || 'Record Payment'; btn.disabled = false; }
        }

        document.querySelectorAll('.payment-form').forEach(function (form) {
            updatePaymentModal(form);
            var pm = form.querySelector('.payment-method');
            if (pm) pm.addEventListener('change', function () { updatePaymentModal(form); });

            form.addEventListener('submit', function (e) {
                var balance = parseFloat(form.dataset.balance || '0');
                var amount  = parseFloat(form.querySelector('.payment-amount').value || '0');

                if (isNaN(amount) || amount <= 0 || amount > balance) return;

                e.preventDefault();
                console.log('[payment-detail] submit intercepted, amount=', amount);

                var btn  = form.querySelector('.payment-submit-btn');
                var msg  = form.querySelector('.modal-payment-msg');
                setSubmitState(btn, true);

                fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
                .then(function (resp) { console.log('[payment-detail] response status:', resp.status); return resp.json(); })
                .then(function (data) {
                    console.log('[payment-detail] response data:', data);
                    if (data.success) {
                        showToast('Payment recorded successfully!', 'success');
                        setTimeout(function () { location.href = '/finance/invoices'; }, 1800);
                    } else {
                        showMsg(form, 'error', data.error || 'Failed to record payment.');
                        setSubmitState(btn, false);
                    }
                })
                .catch(function (err) {
                    console.error('[payment-detail] fetch error:', err);
                    showMsg(form, 'error', 'Network error: ' + err.message);
                    setSubmitState(btn, false);
                });
            });
        });
    });
    </script>
</body>
</html>

