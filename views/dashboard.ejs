                                            <label>Street Address<input type="text" name="street" placeholder="123 Main St"></label>
                                            <label>City<input type="text" name="city" placeholder="Nairobi"></label>
                                            <label>Subcounty<input type="text" name="state" placeholder="e.g., Dagoretti North"></label>
                                            <label>Zip/Postal Code<input type="text" name="zipCode" placeholder="00100"></label>
                                            <label>Country<input type="text" name="country" value="Kenya"></label>
                                        </div>

                                        <!-- Step 3: Emergency Contact -->
                                        <div id="staff-step-2" class="onboarding-step" style="display: none;">
                                            <h4>Emergency Contact</h4>
                                            <p style="font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 1rem;">Contact information for emergencies</p>
                                            <label>Contact Name<input type="text" name="emergencyContactName" placeholder="Jane Doe"></label>
                                            <label>Relationship<input type="text" name="emergencyContactRelationship" placeholder="e.g., Spouse, Parent"></label>
                                            <label>Contact Phone<input type="tel" name="emergencyContactPhone" placeholder="+254700000000"></label>
                                            <label>Contact Email<input type="email" name="emergencyContactEmail" placeholder="emergency@example.com"></label>
                                        </div>

                                        <!-- Step 4: Review & Submit -->
                                        <div id="staff-step-3" class="onboarding-step" style="display: none;">
                                            <h4>Review & Submit</h4>
                                            <p style="font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 1rem;">Please verify all information before submitting.</p>
                                            <div id="staffOnboardingSummary" style="background: var(--muted); padding: 1rem; border-radius: var(--radius); font-size: 0.9rem; line-height: 1.6;">
                                                <!-- Summary populated by JS -->
                                            </div>
                                        </div>
                                    </div>

                                    <div id="staffOnboardingMessage" class="message" style="display: none; margin-top: 1rem;"></div>

                                    <div class="modal-footer" style="justify-content: space-between;">
