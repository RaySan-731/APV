<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Students & Groups - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style nonce="<%= cspNonce %>">
        .student-card { border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 0.75rem; background: var(--card); transition: var(--transition-base); }
        .student-card:hover { box-shadow: var(--shadow-soft); }
        .student-name { font-weight: 600; font-size: 1.1rem; color: var(--foreground); }
        .student-meta { font-size: 0.9rem; color: var(--muted-foreground); margin-top: 0.25rem; }
        .badge-section { margin-top: 0.5rem; }
        .badge { display: inline-block; padding: 0.25rem 0.5rem; border-radius: 999px; font-size: 0.75rem; font-weight: 600; margin-right: 0.25rem; }
        .badge-primary { background: var(--primary); color: var(--primary-foreground); }
        .badge-secondary { background: var(--secondary); color: var(--secondary-foreground); }
        .empty-state { text-align: center; padding: 3rem 1rem; color: var(--muted-foreground); }
        .empty-state svg { width: 64px; height: 64px; margin-bottom: 1rem; opacity: 0.5; }
        .action-btns { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
        .tab-container { border-bottom: 1px solid var(--border); margin-bottom: 1rem; display: flex; gap: 1rem; }
        .tab-btn { border: none; background: none; padding: 0.75rem 1rem; cursor: pointer; border-bottom: 2px solid transparent; font-weight: 500; color: var(--muted-foreground); }
        .tab-btn.active { border-bottom-color: var(--primary); color: var(--primary); }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }
        .group-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; }
        .group-stats { display: flex; gap: 1rem; font-size: 0.9rem; color: var(--muted-foreground); }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path><path d="M3 6h18"></path><path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Students & Groups</h1>
                <div class="header-actions">
                     <button type="button" class="btn btn-primary" id="addStudentBtn">+ Add Student</button>
                </div>
            </header>

            <div class="dashboard-content">
                <div class="stats-section" style="margin-bottom: 1.5rem;">
                    <div class="stat-card" style="flex:1;max-width:200px;">
                         <span class="stat-value" id="totalStudents"><%= students ? students.length : 0 %></span>
                        <span class="stat-label">Total Students</span>
                    </div>
                    <div class="stat-card" style="flex:1;max-width:200px;">
                        <span class="stat-value"><%= groups ? groups.length : 0 %></span>
                        <span class="stat-label">Active Groups</span>
                    </div>
                </div>

                <div class="tab-container">
                    <button class="tab-btn active" data-tab="groups">Groups</button>
                    <button class="tab-btn" data-tab="students">All Students</button>
                </div>

                <div id="groupsTab" class="tab-panel active">
                    <% if (!groups || groups.length === 0) { %>
                        <div class="empty-state">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                            <p>No Student Groups configured yet. Add Students and groups will be auto-created from sections.</p>
                        </div>
                    <% } else { %>
                        <div class="groups-list">
                            <% if (groups && groups.length > 0) { %>
                                <% groups.forEach(group => { %>
                                <div class="student-card">
                                    <div class="group-header">
                                        <div>
                                            <h3 class="student-name"><%= group.name %></h3>
                                             <div class="student-meta">
                                                 Leader: <%= group.leaderName || 'Not assigned' %> • <%= group.memberCount || 0 %> members • <%= group.advancementLevel || 'N/A' %>
                                             </div>
                                             <% if (group.meetingSchedule) { %>
                                                 <div class="student-meta">Meets: <%= group.meetingSchedule.day || 'TBD' %> at <%= group.meetingSchedule.time || 'TBD' %> (<%= group.meetingSchedule.location || 'TBD' %>)</div>
                                             <% } %>
                                        </div>
                                        <div class="group-stats">
                                             <span class="badge badge-primary"><%= group.memberCount || 0 %> students</span>
                                            <span class="badge badge-secondary"><%= group.advancementLevel || 'N/A' %></span>
                                        </div>
                                    </div>
                                </div>
                        <% }) %>
                        <% } else { %>
                            <div class="empty-state">
                                 <p>No students found.</p>
                            </div>
                        <% } %>
                    </div>
                        <% } %>
                    </div>
                    <% } %>
                </div>

                <div id="studentsTab" class="tab-panel">
                    <div class="students-list" id="studentsList">
                        <% if (students && students.length > 0) { %>
                            <% students.forEach(student => { %>
                            <div class="student-card" data-id="<%= student._id %>">
                                <div class="student-header">
                                    <h3 class="student-name"><%= student.fullName || 'Unnamed Student' %></h3>
                                    <span class="badge badge-primary"><%= student.scoutSection || 'Unassigned' %></span>
                                </div>
                                <div class="student-meta">
                                    Gender: <%= student.gender || 'N/A' %> • DOB: <%= student.dateOfBirth ? new Date(student.dateOfBirth).toLocaleDateString() : 'N/A' %> • Age: <%= student.dateOfBirth ? Math.floor((new Date() - new Date(student.dateOfBirth)) / (365.25*24*60*60*1000)) : 'N/A' %>
                                </div>
                                <div class="student-meta">
                                    Parent: <%= student.parentContact?.name || 'Unknown' %> (<a href="tel:<%= student.parentContact?.phone || '' %>"><%= student.parentContact?.phone || 'N/A' %></a>)
                                </div>
                                <div class="student-meta">
                                    Trainer: <%= student.assignedTrainerName || 'Unassigned' %>
                                </div>
                                <div class="action-btns">
                                    <button class="btn btn-sm btn-outline edit-student-btn"
                                            data-id="<%= student._id %>"
                                            data-name="<%= student.fullName %>"
                                            data-yeargroup="<%= student.scoutSection %>"
                                            data-trainer="<%= student.assignedTrainer?._id || student.assignedTrainer || '' %>">
                                        Edit
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </main>
    </div>

     <!-- Add/Edit Student Modal -->
    <div id="studentModal" class="modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
        <div class="modal-content" style="background:var(--card);padding:2rem;border-radius:var(--radius);max-width:500px;width:90%;max-height:90vh;overflow-y:auto;">
            <h3 id="modalTitle">Add Student</h3>
            <form id="studentForm" class="form-grid" style="gap:0.75rem;margin-top:1rem;">
                <input type="hidden" id="studentId">
                <div class="form-group">
                    <label for="fullName">Full Name *</label>
                    <input type="text" id="fullName" name="fullName" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="dateOfBirth">Date of Birth *</label>
                    <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="gender">Gender *</label>
                    <select id="gender" name="gender" class="form-input" required>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="parentName">Parent/Guardian Name</label>
                    <input type="text" id="parentName" name="parentName" class="form-input">
                </div>
                <div class="form-group">
                    <label for="parentPhone">Parent Phone *</label>
                    <input type="tel" id="parentPhone" name="parentPhone" class="form-input" required>
                </div>
                <div class="form-group">
                    <label for="parentEmail">Parent Email *</label>
                    <input type="email" id="parentEmail" name="parentEmail" class="form-input" required>
                </div>
                  <div class="form-group">
                      <label for="yearGroup">Year Group *</label>
                      <select id="yearGroup" name="scoutSection" class="form-input" required>
                          <option value="Sungura">Sungura</option>
                          <option value="Chipukizi">Chipukizi</option>
                          <option value="Mwamba">Mwamba</option>
                          <option value="Rover">Rover</option>
                      </select>
                  </div>
                 <div class="form-group">
                     <label for="assignedTrainer">Assigned Trainer</label>
                     <select id="assignedTrainer" name="assignedTrainer" class="form-input">
                         <option value="">— Unassigned —</option>
                         <!-- Trainers will be populated by JavaScript -->
                     </select>
                 </div>
                <div class="form-actions" style="grid-column:1/-1;display:flex;gap:0.5rem;justify-content:flex-end;">
                     <button type="button" class="btn btn-secondary" id="cancelStudentBtn">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', function() {
            // Tab switching
            const tabs = document.querySelectorAll('.tab-btn');
            const panels = document.querySelectorAll('.tab-panel');
            tabs.forEach(tab => {
                tab.addEventListener('click', () => {
                    tabs.forEach(t => t.classList.remove('active'));
                    panels.forEach(p => p.classList.remove('active'));
                    tab.classList.add('active');
                    document.getElementById(tab.dataset.tab + 'Tab').classList.add('active');
                });
            });

            // Modal handling
            const modal = document.getElementById('studentModal');
            const form = document.getElementById('studentForm');
            const addBtn = document.getElementById('addStudentBtn');
            const cancelBtn = document.getElementById('cancelStudentBtn');
            const editButtons = document.querySelectorAll('.edit-student-btn');
            const trainerSelect = document.getElementById('assignedTrainer');

            // Populate trainers dropdown
            const trainers = <%- JSON.stringify(trainers || []) %>;
            trainers.forEach(trainer => {
              const option = document.createElement('option');
              option.value = trainer._id;
              option.textContent = trainer.name;
              trainerSelect.appendChild(option);
            });

            function openModal() { modal.style.display = 'flex'; }
            function closeModal() { modal.style.display = 'none'; form.reset(); document.getElementById('studentId').value=''; }

            addBtn?.addEventListener('click', () => {
              trainerSelect.value = ''; // Reset to unassigned for new students
              openModal();
            });
            cancelBtn?.addEventListener('click', closeModal);
            window.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

            editButtons.forEach(btn => {
              btn.addEventListener('click', async () => {
                const id = btn.dataset.id;
                const name = btn.dataset.name;
                const yeargroup = btn.dataset.yeargroup;
                document.getElementById('studentId').value = id;
                document.getElementById('fullName').value = name;
                document.getElementById('yearGroup').value = yeargroup;
                // Prefill trainer if available
                const trainerId = btn.dataset.trainer || '';
                trainerSelect.value = trainerId;
                openModal();
              });
            });

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                const studentId = data.studentId;

                // Convert empty assignedTrainer to null
                if (data.assignedTrainer === '') {
                  data.assignedTrainer = null;
                }

                const url = studentId ? `/api/school/students/${studentId}` : '/api/school/students';
                const method = studentId ? 'PUT' : 'POST';

                const res = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await res.json();
                if (result.success) {
                    alert('Student saved successfully');
                    closeModal();
                    location.reload();
                } else {
                    alert('Error: ' + result.error);
                }
            });
        });
    </script>
</body>
</html>

