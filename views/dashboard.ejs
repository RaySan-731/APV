                                            <option value="admin">Admin</option>
                                            <option value="coordinator">Coordinator</option>
                                        </select></label>
                                        <label>Department<input type="text" id="editDepartment" name="department" maxlength="50" pattern="[A-Za-z0-9\s\-&,]+" title="Department must contain only letters, numbers, spaces, hyphens, ampersands or commas."></label>
                                        <label>Status<select id="editStatus" name="status">
                                            <option value="Active">Active</option>
                                            <option value="On Leave">On Leave</option>
