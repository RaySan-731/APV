<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Invoice - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../../partials/sidebar', { user, page: 'finance/invoices' }) %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Create Invoice</h1>
                <a href="/finance/invoices" class="btn btn-outline-secondary btn-sm">Back to List</a>
            </header>

            <div class="container-fluid mt-4">
                <div class="card">
                    <div class="card-body">
                        <div id="uninvoiceError" style="color:var(--danger);margin:0.5rem 0;font-size:0.875rem;"></div>
                        <form action="/finance/invoices/create" method="POST">
                            <div class="mb-3">
                                <label class="form-label">School *</label>
                                <select name="schoolId" class="form-select" required>
                                    <option value="">Select school</option>
                                    <% schools.forEach(s => { %>
                                        <option value="<%= s._id %>" data-student-count="<%= s.studentCount || 0 %>"><%= s.name %></option>
                                    <% }); %>
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Invoice Type *</label>
                                <select name="invoiceType" id="invoiceType" class="form-select" required onchange="toggleFields()">
                                    <option value="custom">Custom</option>
                                    <option value="event">From Events</option>
                                    <option value="service_package">From Service Package</option>
                                </select>
                            </div>

                            <div id="eventFields" style="display:none;">
                                <div class="mb-3">
                                    <label class="form-label">Select Events (completed or in progress)</label>
                                    <select name="relatedEvents[]" class="form-select" multiple size="5">
                                        <option value="">Load uninvoiced events</option>
                                    </select>
                                    <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                                </div>
                            </div>

                            <div id="packageFields" style="display:none;">
                                <div class="mb-3">
                                    <label class="form-label">Service Package</label>
                                    <select name="servicePackageId" class="form-select">
                                        <option value="">Load uninvoiced packages</option>
                                    </select>
                                </div>
                            </div>

                            <div id="customFields">
                                <div class="mb-3">
                                    <label class="form-label">Select Events to build Custom Line Items</label>
                                    <select id="customEventSelect" class="form-select" multiple size="5">
                                        <option value="">Load uninvoiced events</option>
                                    </select>
                                    <small class="text-muted">Hold Ctrl/Cmd to select multiple events. Custom JSON will be generated automatically.</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Custom Line Items (JSON)</label>
                                    <textarea name="customItems" id="customItemsTextarea" class="form-control" rows="4" placeholder=''></textarea>
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Issue Date</label>
                                    <input type="date" name="issueDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Due Date</label>
                                    <input type="date" name="dueDate" class="form-control" value="<%= new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0] %>">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Currency</label>
                                    <select name="currency" class="form-select">
                                        <option value="KES">KES</option>
                                        <option value="USD">USD</option>
                                        <option value="EUR">EUR</option>
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes</label>
                                <textarea name="notes" class="form-control" rows="2"></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary">Generate Invoice</button>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
    function toggleFields() {
        const type = document.getElementById('invoiceType').value;
        document.getElementById('eventFields').style.display = type === 'event' ? 'block' : 'none';
        document.getElementById('packageFields').style.display = type === 'service_package' ? 'block' : 'none';
        document.getElementById('customFields').style.display = type === 'custom' ? 'block' : 'none';

        if (type === 'custom') {
            updateCustomItemsTextarea();
        }
    }

    function getSelectedStudentCount() {
        const schoolSelect = document.querySelector('select[name="schoolId"]');
        const selected = schoolSelect ? schoolSelect.options[schoolSelect.selectedIndex] : null;
        return selected && selected.dataset ? (parseFloat(selected.dataset.studentCount || '0') || 0) : 0;
    }

    function getSelectedSchoolId() {
        const schoolSelect = document.querySelector('select[name="schoolId"]');
        return schoolSelect ? schoolSelect.value : null;
    }

    /** Rebuild a multi-select element's option list so that only events whose
     *  data-target-school-ids includes the currently selected school are visible;
     *  hide and deselect all others. Options sorted newest-first by start date. */
    function filterEventsSelect(selectEl) {
        if (!selectEl) return;
        const schoolId = getSelectedSchoolId();

        // Reorder: recently dated events last (so Hebrew text reads left-to-right at bottom)
        Array.from(selectEl.options).sort((a, b) => {
            const aDate = new Date((b.dataset?.eventDate || 0));
            const bDate = new Date((b.dataset?.eventDate || 0));
            return aDate - bDate;
        });

        Array.from(selectEl.options).forEach(opt => {
            if (opt.value === '') return; // keep the empty placeholder option alone
            const targetIds = JSON.parse(opt.getAttribute('data-target-school-ids') || '[]');
            if (schoolId && targetIds.length === 0) {
                opt.hidden = true;
                opt.selected = false;
            } else if (!schoolId) {
                opt.hidden = true;
                opt.selected = false;
            } else if (targetIds.includes(schoolId)) {
                opt.hidden = false;
            } else {
                opt.hidden = true;
                opt.selected = false;
            }
        });
    }

    function filterAllEventDropDowns() {
        filterEventsSelect(document.querySelector('select[name="relatedEvents"]'));
        filterEventsSelect(document.getElementById('customEventSelect'));
    }

    function buildCustomItemsFromSelectedEvents() {
        const schoolStudentCount = getSelectedStudentCount();
        const selectEl = document.getElementById('customEventSelect');
        if (!selectEl) return [];

        const selectedOptions = Array.from(selectEl.selectedOptions || []);
        const quantity = schoolStudentCount > 0 ? schoolStudentCount : 1;

        return selectedOptions.map(opt => {
            const name = opt.textContent.trim();
            const costPerParticipant = parseFloat(opt.dataset.costPerParticipant || '0') || 0;
            return {
                description: `Event: ${name}`,
                quantity,
                unitPrice: costPerParticipant
            };
        });
    }

    function updateCustomItemsTextarea() {
        const type = document.getElementById('invoiceType').value;
        const textarea = document.getElementById('customItemsTextarea');
        if (!textarea || type !== 'custom') return;

        textarea.value = JSON.stringify(buildCustomItemsFromSelectedEvents(), null, 2);
    }

    /** Fetch uninvoiced events and packages for the currently selected school
     *  and rebuild the select elements. Falls back gracefully if the request fails. */
    async function loadUninvoicedItems() {
        const schoolId = getSelectedSchoolId();
        if (!schoolId) {
            // No school selected — clear the event/package selects and textarea
            clearAllItems();
            return;
        }

        try {
            const resp = await fetch(`/finance/invoices/uninvoiced-items?schoolId=${encodeURIComponent(schoolId)}`);
            let errBody = null;
            if (!resp.ok) {
              try { errBody = await resp.json(); } catch (e) { /* ignore */ }
              const msg = (errBody && errBody.error) || 'Failed to load uninvoiced items';
              const el = document.getElementById('uninvoiceError');
              if (el) el.textContent = msg;
              clearAllItems();
              return;
            }

            const data = await resp.json();

            // ── Rebuild the Events multi-selects ──────────────────────────
            ['relatedEvents', 'customEventSelect'].forEach(selId => {
                const sel = selId === 'relatedEvents'
                    ? document.querySelector('select[name="relatedEvents"]')
                    : document.getElementById(selId);
                if (!sel) return;

                const schoolIdForFilter = schoolId; // capture for closure
                const firstOpt = sel.options[0] ? sel.options[0].outerHTML : '';
                sel.innerHTML = '';
                if (firstOpt) sel.appendChild(new DOMParser().parseFromString(firstOpt, 'text/html').body.firstChild);

                (data.events || []).forEach(ev => {
                    const opt = document.createElement('option');
                    opt.value = ev._id;
                    opt.textContent = `${ev.name} — ${ev.startDate ? new Date(ev.startDate).toLocaleDateString() : 'No date'}`;
                    opt.setAttribute('data-cost-per-participant', ev.costPerParticipant || 0);
                    opt.setAttribute('data-target-school-ids', JSON.stringify(
                        (ev.targetSchools || []).map(ts => ts.schoolId?.toString() || '')
                    ));
                    opt.setAttribute('data-event-date', ev.startDate || '');
                    sel.appendChild(opt);
                });

                sel.value = '';
                if (selId === 'relatedEvents') filterEventsSelect(sel);
            });

            // ── Rebuild the Service Package select ─────────────────────────
            const pkgSel = document.querySelector('select[name="servicePackageId"]');
            if (pkgSel) {
                const firstPkgOpt = pkgSel.options[0] ? pkgSel.options[0].outerHTML : '';
                pkgSel.innerHTML = '';
                if (firstPkgOpt) pkgSel.appendChild(new DOMParser().parseFromString(firstPkgOpt, 'text/html').body.firstChild);

                (data.packages || []).forEach(pkg => {
                    const opt = document.createElement('option');
                    opt.value = pkg._id;
                    opt.textContent = `${pkg.displayName} (${pkg.pricingModel})`;
                    pkgSel.appendChild(opt);
                });
            }

            updateCustomItemsTextarea();
        } catch (err) {
            console.error('Error loading uninvoiced items:', err);
            clearAllItems();
            const el = document.getElementById('uninvoiceError');
            if (el) el.textContent = err.message || 'An unexpected error occurred.';
        }
    }

    function clearAllItems() {
        ['relatedEvents', 'customEventSelect'].forEach(selId => {
            const sel = selId === 'relatedEvents'
                ? document.querySelector('select[name="relatedEvents"]')
                : document.getElementById(selId);
            if (sel) { sel.innerHTML = '<option value="">Load uninvoiced events</option>'; }
        });
        const pkgSel = document.querySelector('select[name="servicePackageId"]');
        if (pkgSel) pkgSel.innerHTML = '<option value="">Select package</option>';
        updateCustomItemsTextarea();
    }

    // Initialise on page load
    toggleFields();
    filterAllEventDropDowns();
    updateCustomItemsTextarea();

    // Fetch uninvoiced items whenever the school changes
    document.querySelector('select[name="schoolId"]').addEventListener('change', () => {
        loadUninvoicedItems();
    });

    // Update custom JSON whenever the custom-event selection changes
    document.getElementById('customEventSelect').addEventListener('change', () => updateCustomItemsTextarea());

    // Load uninvoiced items on initial render if a school is pre-selected
    if (getSelectedSchoolId()) loadUninvoicedItems();
    </script>

    <script src="/js/main.js"></script>
</body>
</html>

