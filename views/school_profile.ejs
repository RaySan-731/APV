<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Profile - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">School Profile</h1>
            </header>

            <div class="dashboard-content school-profile">
                <div class="card">
                    <div class="card-header">
                        <h2><%= school?.name || 'School' %> Profile</h2>
                        <button type="button" class="btn btn-outline btn-sm" id="editToggleBtn">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="margin-right:4px;vertical-align:-1px;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            Edit Profile
                        </button>
                    </div>
                    <div class="card-body">
                        <div id="profileViewMode">
                            <div class="profile-grid">
                                <div class="profile-section">
                                    <h3>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                                        Contact Information
                                    </h3>
                                    <dl class="profile-dl">
                                        <dt>School Name</dt>
                                        <dd><%= school?.name %></dd>
                                        <dt>Contact Person</dt>
                                        <dd><%= school?.contactPerson?.name %></dd>
                                        <dt>Admin Email</dt>
                                        <dd><a href="mailto:<%= school?.contactPerson?.email %>"><%= school?.contactPerson?.email %></a></dd>
                                        <dt>Phone</dt>
                                        <dd><a href="tel:<%= school?.contactPerson?.phone %>"><%= school?.contactPerson?.phone %></a></dd>
                                        <dt>Address</dt>
                                        <dd><%= school?.address?.street || 'N/A' %>, <%= school?.address?.city || 'N/A' %>, <%= school?.address?.country || 'N/A' %></dd>
                                    </dl>
                                </div>
                                <div class="profile-section">
                                    <h3>
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path></svg>
                                        Service Details
                                    </h3>
                                    <dl class="profile-dl">
                                        <dt>Zone</dt>
                                        <dd><%= school?.zone || 'Not set' %></dd>
                                        <dt>Region</dt>
                                        <dd><%= school?.region || 'Not set' %></dd>
                                        <dt>Onboarding Date</dt>
                                        <dd><%= school?.onboardingDate ? new Date(school.onboardingDate).toLocaleDateString() : 'Not set' %></dd>
                                        <dt>Service Status</dt>
                                        <dd><span class="status-badge status-<%= school?.serviceStatus || 'active' %>"><%= school?.serviceStatus ? school.serviceStatus.replace('_',' ') : 'Active' %></span></dd>
                                        <dt>Assigned Trainer</dt>
                                        <dd><%= trainer?.name || 'Not assigned' %> (<%= trainer?.email || '' %>)</dd>
                                    </dl>
                                </div>
                            </div>
                        </div>

                        <div id="profileEditMode" style="display: none;">
                            <div class="edit-form-header">
                                <h4>Update Contact Details</h4>
                                <p>Only editable contact fields are shown below. Other information is managed by the founder team.</p>
                            </div>
                            <form id="profileEditForm" class="form-grid">
                                <div class="form-group">
                                    <label for="phone">Phone Number</label>
                                    <input type="tel" id="phone" name="phone" class="form-input" value="<%= school?.contactPerson?.phone || '' %>" placeholder="+254 700 000 000">
                                </div>
                                <div class="form-group">
                                    <label for="adminEmail">Admin Email</label>
                                    <input type="email" id="adminEmail" name="adminEmail" class="form-input" value="<%= school?.contactPerson?.email || '' %>" placeholder="admin@school.ac.ke">
                                </div>
                                <div class="form-group">
                                    <label for="logo">Logo URL (optional)</label>
                                    <input type="url" id="logo" name="logo" class="form-input" value="<%= school?.logoUrl || '' %>" placeholder="https://...">
                                </div>
                                <div class="form-actions">
                                    <button type="button" class="btn btn-secondary" id="cancelEditBtn">Cancel</button>
                                    <button type="submit" class="btn btn-primary">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', function() {
            const editToggle = document.getElementById('editToggleBtn');
            const viewMode = document.getElementById('profileViewMode');
            const editMode = document.getElementById('profileEditMode');
            const cancelBtn = document.getElementById('cancelEditBtn');
            const form = document.getElementById('profileEditForm');

            editToggle?.addEventListener('click', () => {
                viewMode.style.display = 'none';
                editMode.style.display = 'block';
            });

            cancelBtn?.addEventListener('click', () => {
                editMode.style.display = 'none';
                viewMode.style.display = 'block';
            });

            form?.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());

                const res = await fetch('/api/school/profile', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await res.json();
                if (result.success) {
                    alert('Profile updated successfully');
                    location.reload();
                } else {
                    alert('Error: ' + result.error);
                }
            });
        });
    </script>
</body>
</html>
