                     <script nonce="<%= cspNonce %>">
 function toggleSchoolStatusDropdown(badgeEl) {
     var dropdown = badgeEl.parentElement.querySelector('.school-status-dropdown');
     var isOpen = dropdown.classList.contains('show');
     document.querySelectorAll('.school-status-dropdown.show').forEach(function(d) { d.classList.remove('show'); });
     document.querySelectorAll('.school-status-badge.dropdown-open').forEach(function(b) { b.classList.remove('dropdown-open'); });
     if (!isOpen) {
         dropdown.classList.add('show');
         badgeEl.classList.add('dropdown-open');
   }
 }

 window.updateSchoolStatus = async function(schoolId, value, field, btn) {
     try {
         var resp = await fetch('/api/schools/' + schoolId + '/status', {
             method: 'POST',
             headers: { 'Content-Type': 'application/json' },
             body: JSON.stringify({ [field]: value })
         });
         var data = await resp.json();
         if (data.success) {
             location.reload();
         } else {
             showToast(data.error || 'Failed to update status', 'error');
         }
     } catch (err) {
         showToast('Network error: ' + err.message, 'error');
     }
 };

  // ---------- SCHOOLS EXPORT ----------
  function toggleSchoolsExportMenu() {
   document.getElementById('schoolsExportMenu').classList.toggle('show');
  }

  function buildSchoolsExportUrl(format) {
  const params = new URLSearchParams();
  var searchEl = document.getElementById('schoolSearch');
  var statusEl = document.getElementById('statusFilter');
  var serviceStatusEl = document.getElementById('serviceStatusFilter');
  var zoneEl = document.getElementById('zoneFilter');
  if (searchEl && searchEl.value.trim()) params.set('search', searchEl.value.trim());
  if (statusEl && statusEl.value) params.set('status', statusEl.value);
  if (serviceStatusEl && serviceStatusEl.value) params.set('serviceStatus', serviceStatusEl.value);
  if (zoneEl && zoneEl.value) params.set('zone', zoneEl.value);
  params.set('format', format);
  return '/api/trainer/schools/export?' + params.toString();
}

// Sync filter values from URL on page load so export URL builder sees the correct values
(function syncSchoolsFilters() {
  var searchEl = document.getElementById('schoolSearch');
  var statusEl = document.getElementById('statusFilter');
  var serviceStatusEl = document.getElementById('serviceStatusFilter');
  var zoneEl = document.getElementById('zoneFilter');
  var params = new URLSearchParams(window.location.search);
  if (searchEl && params.get('search')) searchEl.value = params.get('search');
  if (statusEl && params.get('status')) statusEl.value = params.get('status');
  if (serviceStatusEl && params.get('serviceStatus')) serviceStatusEl.value = params.get('serviceStatus');
  if (zoneEl && params.get('zone')) zoneEl.value = params.get('zone');
})();

document.addEventListener('DOMContentLoaded', function() {
  var csvLink = document.getElementById('exportSchoolsCsvLink');
  var pdfLink = document.getElementById('exportSchoolsPdfLink');
  if (csvLink) csvLink.href = buildSchoolsExportUrl('csv');
  if (pdfLink) pdfLink.href = buildSchoolsExportUrl('pdf');
});

document.addEventListener('click', function(e) {
  var menu = document.getElementById('schoolsExportMenu');
  if (menu && !e.target.closest('.export-dropdown')) {
    menu.classList.remove('show');
  }
});

  // ---------- PROGRAM ALLOCATION MODAL (from school actions dropdown) ----------
  function openProgramAllocationModal(schoolId, schoolName, enrolledProgramIds) {
    document.getElementById('programAllocationSchoolId').value = schoolId;
    document.getElementById('modalSchoolName').textContent = schoolName;
    var select = document.getElementById('programAllocationSelect');
    for (var i = 0; i < select.options.length; i++) {
      select.options[i].selected = (enrolledProgramIds && enrolledProgramIds.indexOf(select.options[i].value) !== -1);
    }
    document.getElementById('programAllocationMessage').style.display = 'none';
    document.getElementById('programAllocationModal').style.display = 'flex';
  }

  function closeProgramAllocationModal() {
    document.getElementById('programAllocationModal').style.display = 'none';
  }

  async function saveProgramAllocation() {
    var schoolId = document.getElementById('programAllocationSchoolId').value;
    var select = document.getElementById('programAllocationSelect');
    var programIds = [];
    for (var i = 0; i < select.selectedOptions.length; i++) {
      programIds.push(select.selectedOptions[i].value);
    }
    var messageEl = document.getElementById('programAllocationMessage');
    messageEl.style.display = 'none';
    try {
      var resp = await fetch('/api/schools/' + schoolId + '/update-programs', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ programIds: programIds })
      });
      var data = await resp.json();
      if (data.success) {
        messageEl.textContent = '✓ ' + (data.message || 'Programs saved successfully!');
        messageEl.className = 'message success';
        messageEl.style.display = 'block';
        setTimeout(function() {
          closeProgramAllocationModal();
          window.location.reload();
        }, 1200);
      } else {
        messageEl.textContent = '✗ ' + (data.error || 'Error saving programs');
        messageEl.className = 'message error';
        messageEl.style.display = 'block';
      }
    } catch (err) {
      console.error('Error saving program allocation:', err);
      messageEl.textContent = '✗ Network error';
      messageEl.className = 'message error';
      messageEl.style.display = 'block';
    }
  }

  // ---------- DELETE SCHOOL MODAL ----------
  function openDeleteSchoolModal(schoolId, schoolName) {
    document.getElementById('deleteSchoolId').value = schoolId;
    document.getElementById('deleteSchoolName').textContent = schoolName;
    document.getElementById('deleteSchoolModal').style.display = 'flex';
  }

  function closeDeleteSchoolModal() {
    document.getElementById('deleteSchoolModal').style.display = 'none';
  }

  async function deleteSchool() {
    var schoolId = document.getElementById('deleteSchoolId').value;
    if (!schoolId) return;
    try {
      var resp = await fetch('/api/schools/' + schoolId + '/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      var data = await resp.json();
      if (data.success) {
        closeDeleteSchoolModal();
        showToast(data.message || 'School deleted successfully', 'success');
        setTimeout(function() { window.location.reload(); }, 1500);
      } else {
        showToast(data.error || 'Failed to delete school', 'error');
      }
    } catch (err) {
      console.error('Error deleting school:', err);
      showToast('Network error: ' + err.message, 'error');
    }
  }
                    </script>
