<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Invoice - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../../partials/sidebar', { user, page: 'finance/invoices' }) %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Create Invoice <span class="page-subtitle">Generate a new billing document for a school</span></h1>
                <a href="/finance/invoices" class="btn btn-outline-secondary btn-sm">Back to List</a>
            </header>

            <div class="container-fluid mt-4 invoices-create-page">
                <div class="card">
                    <div class="card-body">
                        <div id="uninvoiceError" style="color:var(--danger);margin:0.5rem 0;font-size:0.875rem;"></div>
                        <form action="/finance/invoices/create" method="POST">

                            <!-- School & Type -->
                            <div class="form-section">
                                <div class="section-header">
                                    <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16"></path>
                                        <path d="M3 7h18"></path>
                                    </svg>
                                    <span>School &amp; Invoice Type</span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">School *</label>
                                    <select name="schoolId" class="form-select" required>
                                        <option value="">Select school</option>
                                        <% schools.forEach(s => { %>
                                            <option value="<%= s._id %>" data-student-count="<%= s.studentCount || 0 %>"><%= s.name %></option>
                                        <% }); %>
                                    </select>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Invoice Type *</label>
                                    <select name="invoiceType" id="invoiceType" class="form-select" required onchange="toggleFields()">
                                        <option value="custom">Custom</option>
                                        <option value="event">From Events</option>
                                        <option value="service_package">From Service Package</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Line Items Configuration -->
                            <div class="form-section">
                                <div class="section-header">
                                    <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                        <line x1="16" y1="17" x2="8" y2="17"></line>
                                    </svg>
                                    <span>Line Items Configuration</span>
                                </div>

                                <div id="eventFields" style="display:none;">
                                    <div class="mb-3">
                                        <label class="form-label">Select Events</label>
                                        <select name="relatedEvents" class="form-select" multiple size="5">
                                            <option value="" disabled>Select one or more events to bill</option>
                                        </select>
                                        <small class="text-muted">Hold Ctrl/Cmd to select multiple</small>
                                    </div>
                                </div>

                                <div id="packageFields" style="display:none;">
                                    <div class="mb-3">
                                        <label class="form-label">Service Package</label>
                                        <select name="servicePackageId" class="form-select">
                                            <option value="">Load uninvoiced packages</option>
                                        </select>
                                    </div>
                                </div>

                                <div id="customFields">
                                    <div class="mb-3">
                                        <label class="form-label">Select Events to build Custom Line Items</label>
                                        <select id="customEventSelect" class="form-select" multiple size="5">
                                            <option value="">Load uninvoiced events</option>
                                        </select>
                                        <small class="text-muted">Hold Ctrl/Cmd to select multiple events. Custom JSON will be generated automatically.</small>
                                    </div>

                                    <textarea name="customItems" id="customItemsTextarea" style="display:none;" rows="4"></textarea>
                                </div>
                            </div>

                            <!-- Billing Details -->
                            <div class="form-section">
                                <div class="section-header">
                                    <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <span>Billing Details</span>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-4">
                                        <label class="form-label">Issue Date</label>
                                        <input type="date" name="issueDate" class="form-control" value="<%= new Date().toISOString().split('T')[0] %>">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Due Date</label>
                                        <input type="date" name="dueDate" class="form-control" value="<%= new Date(Date.now() + 30*24*60*60*1000).toISOString().split('T')[0] %>">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Currency</label>
                                        <select name="currency" class="form-select">
                                            <option value="KES">KES</option>
                                            <option value="USD">USD</option>
                                            <option value="EUR">EUR</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Total Invoice Amount</label>
                                    <div class="input-group">
                                        <span class="input-group-text" id="currencyContext">KES</span>
                                        <input type="number"
                                               name="totalAmount"
                                               id="totalAmountInput"
                                               class="form-control"
                                               placeholder="Enter invoice amount or leave blank to use calculated line total"
                                               min="0"
                                               step="0.01">
                                    </div>
                                    <div class="form-text">If you enter a value here, it will override the calculated invoice total.</div>
                                </div>
                            </div>

                            <!-- Live Preview -->
                            <div class="form-section">
                                <div class="section-header">
                                    <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <span>Invoice Preview</span>
                                </div>

                                <div class="invoice-preview">
                                    <div class="invoice-preview-header">
                                        <span>Calculated subtotal</span>
                                        <strong id="subtotalDisplay">KES 0.00</strong>
                                    </div>
                                    <div class="invoice-preview-row">
                                        <span>Manual override</span>
                                        <strong id="overrideDisplay">KES 0.00</strong>
                                    </div>
                                    <div class="invoice-preview-total">
                                        <span>Invoice total</span>
                                        <strong id="totalDisplay">KES 0.00</strong>
                                    </div>
                                </div>
                            </div>

                            <!-- Additional Information -->
                            <div class="form-section">
                                <div class="section-header">
                                    <svg class="section-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                        <polyline points="14 2 14 8 20 8"></polyline>
                                        <line x1="16" y1="13" x2="8" y2="13"></line>
                                    </svg>
                                    <span>Additional Information</span>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label">Notes</label>
                                    <textarea name="notes" class="form-control" rows="2"></textarea>
                                </div>

                                <button type="submit" class="btn btn-primary">Generate Invoice</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
    function calculateTotalAmount() {
        const type = document.getElementById('invoiceType')?.value || 'custom';
        let subtotal = 0;

        if (type === 'custom') {
            try {
                const items = JSON.parse(document.getElementById('customItemsTextarea')?.value || '[]');
                subtotal = Array.isArray(items)
                    ? items.reduce((sum, item) => sum + ((parseFloat(item.quantity) || 1) * (parseFloat(item.unitPrice) || 0)), 0)
                    : 0;
            } catch {
                subtotal = 0;
            }
        }

        if (type === 'event') {
            const schoolStudentCount = getSelectedStudentCount();
            const sel = document.querySelector('select[name="relatedEvents"]');
            if (sel) {
                subtotal = Array.from(sel.selectedOptions)
                    .filter(o => o.value && o.value !== '')
                    .reduce((sum, opt) => {
                        const qty = schoolStudentCount > 0 ? schoolStudentCount : 1;
                        const rate = parseFloat(opt.getAttribute('data-cost-per-participant') || '0') || 0;
                        return sum + (rate * qty);
                    }, 0);
            }
        }

        if (type === 'service_package') {
            const pkgSel = document.querySelector('select[name="servicePackageId"]');
            if (pkgSel) {
                const selectedOpt = pkgSel.options[pkgSel.selectedIndex];
                const rate = parseFloat(selectedOpt?.dataset?.rate || '0') || 0;
                const pricingModel = selectedOpt?.dataset?.pricingModel || 'fixed';
                const quantity = pricingModel === 'per_student' ? Math.max(getSelectedStudentCount(), 1) : 1;
                subtotal = rate * quantity;
            }
        }

        return subtotal;
    }

    function refreshInvoicePreview() {
        const subtotal = calculateTotalAmount();
        const input = document.getElementById('totalAmountInput');
        const override = parseFloat(input?.value || '0') || 0;
        const total = override > 0 ? override : subtotal;

        document.getElementById('subtotalDisplay').textContent = `${getCurrencyPrefix()} ${subtotal.toFixed(2)}`;
        document.getElementById('overrideDisplay').textContent = `${getCurrencyPrefix()} ${override > 0 ? override.toFixed(2) : '0.00'}`;
        document.getElementById('totalDisplay').textContent = `${getCurrencyPrefix()} ${total.toFixed(2)}`;
    }

    function getCurrencyPrefix() {
        const currencySelect = document.querySelector('select[name="currency"]');
        return currencySelect ? currencySelect.value : 'KES';
    }

    function updateTotalAmount() {
        const input = document.getElementById('totalAmountInput');
        if (!input) return;
        const calculated = calculateTotalAmount();
        if (!input.value || parseFloat(input.value) === 0) {
            input.value = calculated > 0 ? calculated.toFixed(2) : '';
        }
        refreshInvoicePreview();

        const currencySelect = document.querySelector('select[name="currency"]');
        const ctx = document.getElementById('currencyContext');
        if (currencySelect && ctx) ctx.textContent = currencySelect.value || 'KES';
    }
    function toggleFields() {
        const type = document.getElementById('invoiceType').value;
        document.getElementById('eventFields').style.display = type === 'event' ? 'block' : 'none';
        document.getElementById('packageFields').style.display = type === 'service_package' ? 'block' : 'none';
        document.getElementById('customFields').style.display = type === 'custom' ? 'block' : 'none';

        if (type === 'custom') {
            updateCustomItemsTextarea();
        }
        if (type === 'event') {
            filterEventsSelect(document.querySelector('select[name="relatedEvents"]'));
        }
        if (type === 'service_package') {
            updateTotalAmount();
        }
    }

    function getSelectedStudentCount() {
        const schoolSelect = document.querySelector('select[name="schoolId"]');
        const selected = schoolSelect ? schoolSelect.options[schoolSelect.selectedIndex] : null;
        return selected && selected.dataset ? (parseFloat(selected.dataset.studentCount || '0') || 0) : 0;
    }

    function getSelectedSchoolId() {
        const schoolSelect = document.querySelector('select[name="schoolId"]');
        return schoolSelect ? schoolSelect.value : null;
    }

    /** Rebuild a multi-select element's option list so that only events whose
     *  data-target-school-ids includes the currently selected school are visible;
     *  hide and deselect all others. Options sorted newest-first by start date. */
    function filterEventsSelect(selectEl) {
        if (!selectEl) return;
        const schoolId = getSelectedSchoolId();

        // Reorder: recently dated events last (so Hebrew text reads left-to-right at bottom)
        Array.from(selectEl.options).sort((a, b) => {
            const aDate = new Date((b.dataset?.eventDate || 0));
            const bDate = new Date((b.dataset?.eventDate || 0));
            return aDate - bDate;
        });

        Array.from(selectEl.options).forEach(opt => {
            if (opt.value === '') return; // keep the empty placeholder option alone
            const targetIds = JSON.parse(opt.getAttribute('data-target-school-ids') || '[]');
            if (schoolId && targetIds.length === 0) {
                opt.hidden = true;
                opt.selected = false;
            } else if (!schoolId) {
                opt.hidden = true;
                opt.selected = false;
            } else if (targetIds.includes(schoolId)) {
                opt.hidden = false;
            } else {
                opt.hidden = true;
                opt.selected = false;
            }
        });
    }

    function filterAllEventDropDowns() {
        filterEventsSelect(document.querySelector('select[name="relatedEvents"]'));
    }

    function buildCustomItemsFromSelectedEvents() {
        const schoolStudentCount = getSelectedStudentCount();
        const selectEl = document.getElementById('customEventSelect');
        if (!selectEl) return [];

        const selectedOptions = Array.from(selectEl.selectedOptions || []);
        const quantity = schoolStudentCount > 0 ? schoolStudentCount : 1;

        return selectedOptions.map(opt => {
            const name = opt.textContent.trim();
            const costPerParticipant = parseFloat(opt.dataset.costPerParticipant || '0') || 0;
            return {
                description: `Event: ${name}`,
                quantity,
                unitPrice: costPerParticipant
            };
        });
    }

    function updateCustomItemsTextarea() {
        const type = document.getElementById('invoiceType').value;
        const textarea = document.getElementById('customItemsTextarea');
        if (!textarea || type !== 'custom') return;

        textarea.value = JSON.stringify(buildCustomItemsFromSelectedEvents(), null, 2);
        updateTotalAmount(); // recalculate total whenever the JSON changes
    }

    /** Fetch uninvoiced events and packages for the currently selected school
     *  and rebuild the select elements. Falls back gracefully if the request fails. */
    async function loadUninvoicedItems() {
        const schoolId = getSelectedSchoolId();
        if (!schoolId) {
            // No school selected — clear the event/package selects and textarea
            clearAllItems();
            return;
        }

        try {
            const resp = await fetch(`/finance/invoices/uninvoiced-items?schoolId=${encodeURIComponent(schoolId)}`);
            let errBody = null;
            if (!resp.ok) {
              try { errBody = await resp.json(); } catch (e) { /* ignore */ }
              const msg = (errBody && errBody.error) || 'Failed to load uninvoiced items';
              const el = document.getElementById('uninvoiceError');
              if (el) el.textContent = msg;
              clearAllItems();
              return;
            }

            const data = await resp.json();

            // ── Rebuild the Events multi-selects ──────────────────────────
            ['relatedEvents', 'customEventSelect'].forEach(selId => {
                const sel = selId === 'relatedEvents'
                    ? document.querySelector('select[name="relatedEvents"]')
                    : document.getElementById(selId);
                if (!sel) return;

                const schoolIdForFilter = schoolId; // capture for closure
                const firstOpt = sel.options[0] ? sel.options[0].outerHTML : '';
                sel.innerHTML = '';
                if (firstOpt) sel.appendChild(new DOMParser().parseFromString(firstOpt, 'text/html').body.firstChild);

                (data.events || []).forEach(ev => {
                    const opt = document.createElement('option');
                    opt.value = ev._id;
                    opt.textContent = `${ev.name} — ${ev.startDate ? new Date(ev.startDate).toLocaleDateString() : 'No date'}`;
                    opt.setAttribute('data-cost-per-participant', ev.costPerParticipant || 0);
                    const tsList = (ev.targetSchools || []).map(ts => {
                        if (!ts || !ts.schoolId) return '';
                        return typeof ts.schoolId === 'object' ? ts.schoolId.toString() : String(ts.schoolId);
                    }).filter(Boolean);
                    opt.setAttribute('data-target-school-ids', JSON.stringify(tsList));
                    opt.setAttribute('data-event-date', ev.startDate || '');
                    sel.appendChild(opt);
                });

                sel.value = '';
                if (selId === 'relatedEvents') filterEventsSelect(sel);
            });

            // ── Rebuild the Service Package select ─────────────────────────
            const pkgSel = document.querySelector('select[name="servicePackageId"]');
            if (pkgSel) {
                const firstPkgOpt = pkgSel.options[0] ? pkgSel.options[0].outerHTML : '';
                pkgSel.innerHTML = '';
                if (firstPkgOpt) pkgSel.appendChild(new DOMParser().parseFromString(firstPkgOpt, 'text/html').body.firstChild);

                (data.packages || []).forEach(pkg => {
                    const opt = document.createElement('option');
                    opt.value = pkg._id;
                    opt.textContent = `${pkg.displayName} (${pkg.pricingModel})`;
                    opt.dataset.pricingModel = pkg.pricingModel || 'fixed';
                    opt.dataset.rate = pkg.pricingModel === 'per_student'
                        ? (pkg.ratePerStudent || 0)
                        : (pkg.monthlyRetainer || 0);
                    pkgSel.appendChild(opt);
                });
            }

            updateCustomItemsTextarea();
            updateTotalAmount();
        } catch (err) {
            console.error('Error loading uninvoiced items:', err);
            clearAllItems();
            const el = document.getElementById('uninvoiceError');
            if (el) el.textContent = err.message || 'An unexpected error occurred.';
        }
    }

    function clearAllItems() {
        ['relatedEvents', 'customEventSelect'].forEach(selId => {
            const sel = selId === 'relatedEvents'
                ? document.querySelector('select[name="relatedEvents"]')
                : document.getElementById(selId);
            if (sel) { sel.innerHTML = '<option value="">Load uninvoiced events</option>'; }
        });
        const pkgSel = document.querySelector('select[name="servicePackageId"]');
        if (pkgSel) pkgSel.innerHTML = '<option value="">Select package</option>';
        updateCustomItemsTextarea();
    }

    // Initialise on page load
    toggleFields();
    updateCustomItemsTextarea();
    updateTotalAmount();

    // Fetch uninvoiced items whenever the school changes
    document.querySelector('select[name="schoolId"]').addEventListener('change', (e) => {
        updateTotalAmount();
        loadUninvoicedItems();
    });

    // Recalculate total when invoice type changes (toggleFields also runs via onchange attr)
    document.getElementById('invoiceType').addEventListener('change', () => {
        toggleFields();
        updateTotalAmount();
    });

    // Update totals when custom-event selection changes
    document.getElementById('customEventSelect').addEventListener('change', () => {
        updateCustomItemsTextarea();
        updateTotalAmount();
    });

    // Update totals when related events or package selection changes
    const relatedEventsSelect = document.querySelector('select[name="relatedEvents"]');
    if (relatedEventsSelect) {
        relatedEventsSelect.addEventListener('change', updateTotalAmount);
    }
    const packageSelect = document.querySelector('select[name="servicePackageId"]');
    if (packageSelect) {
        packageSelect.addEventListener('change', updateTotalAmount);
    }
    const totalInput = document.getElementById('totalAmountInput');
    if (totalInput) {
        totalInput.addEventListener('input', refreshInvoicePreview);
    }
    const currencySelect = document.querySelector('select[name="currency"]');
    if (currencySelect) {
        currencySelect.addEventListener('change', refreshInvoicePreview);
    }

    // Load uninvoiced items on initial render if a school is pre-selected
    if (getSelectedSchoolId()) loadUninvoicedItems();
    </script>

    <script src="/js/main.js"></script>
</body>
</html>

