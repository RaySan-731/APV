<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoices - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../../partials/sidebar', { user, page: 'finance/invoices' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Invoices</h1>
                <div class="btn-toolbar">
                    <a href="/finance/invoices/create" class="btn btn-primary btn-sm">New Invoice</a>
                    <a href="/finance/dashboard" class="btn btn-outline-secondary btn-sm ms-2">Dashboard</a>
                </div>
            </header>

            <div class="container-fluid mt-4">
                <!-- Summary Stats -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Total Invoices</h6>
                                <p class="fs-4"><%= summary.totalCount || 0 %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Total Amount</h6>
                                <p class="fs-4">KES <%= (summary.totalAmount || 0).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Collected</h6>
                                <p class="fs-4 text-success">KES <%= (summary.totalPaid || 0).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-light">
                            <div class="card-body">
                                <h6 class="card-title">Outstanding</h6>
                                <p class="fs-4 text-danger">KES <%= (summary.totalOutstanding || 0).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Filters -->
                <form method="GET" class="row g-3 mb-4">
                    <div class="col-md-3">
                        <select name="schoolId" class="form-select">
                            <option value="">All Schools</option>
                            <% schools.forEach(s => { %>
                                <option value="<%= s._id %>" <%= filters.schoolId == s._id ? 'selected' : '' %>><%= s.name %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="issued" <%= filters.status === 'issued' ? 'selected' : '' %>>Issued</option>
                            <option value="sent" <%= filters.status === 'sent' ? 'selected' : '' %>>Sent</option>
                            <option value="partial" <%= filters.status === 'partial' ? 'selected' : '' %>>Partial</option>
                            <option value="paid" <%= filters.status === 'paid' ? 'selected' : '' %>>Paid</option>
                            <option value="overdue" <%= filters.status === 'overdue' ? 'selected' : '' %>>Overdue</option>
                            <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="startDate" class="form-control" value="<%= filters.startDate || '' %>">
                    </div>
                    <div class="col-md-2">
                        <input type="date" name="endDate" class="form-control" value="<%= filters.endDate || '' %>">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-secondary w-100">Filter</button>
                    </div>
                </form>

                <!-- Invoices Table -->
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Invoice #</th>
                                        <th>School</th>
                                        <th>Date</th>
                                        <th>Due Date</th>
                                        <th>Amount</th>
                                        <th>Paid</th>
                                        <th>Balance</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% invoices.forEach(inv => { %>
                                        <tr class="<%= inv.status === 'overdue' ? 'table-danger' : inv.status === 'paid' ? 'table-success' : '' %>">
                                            <td><%= inv.invoiceNumber %></td>
                                            <td><% if (inv.schoolId) { %><a href="/schools/<%= inv.schoolId._id %>"><%= inv.schoolId.name %></a><% } else { %><span class="text-muted">School deleted</span><% } %></td>
                                            <td><%= new Date(inv.issueDate).toLocaleDateString() %></td>
                                            <td><%= new Date(inv.dueDate).toLocaleDateString() %></td>
                                            <td>KES <%= inv.totalAmount.toLocaleString() %></td>
                                            <td>KES <%= inv.amountPaid.toLocaleString() %></td>
                                            <td class="<%= inv.balance > 0 ? 'text-danger fw-bold' : '' %>">
                                                KES <%= inv.balance.toLocaleString() %>
                                            </td>
                                            <td>
                                                <span class="badge bg-<%= 
                                                    inv.status === 'paid' ? 'success' :
                                                    inv.status === 'overdue' ? 'danger' :
                                                    inv.status === 'partial' ? 'warning' :
                                                    inv.status === 'cancelled' ? 'secondary' :
                                                    'primary'
                                                %>">
                                                    <%= inv.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="/finance/invoices/<%= inv._id %>" class="btn btn-outline-primary">View</a>
                                                    <a href="/finance/invoices/<%= inv._id %>/download" class="btn btn-outline-secondary" target="_blank">PDF</a>
                                                    <% if (inv.status !== 'paid' && inv.status !== 'cancelled') { %>
                                                        <button type="button" class="btn btn-outline-success" onclick="openPaymentModal('<%= inv._id %>')">
                                                            Record Payment
                                                        </button>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- Payment Modal -->
                                        <div class="modal-overlay" id="paymentModal<%= inv._id %>" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form action="/finance/invoices/<%= inv._id %>/payments" method="POST" enctype="multipart/form-data" class="payment-form" data-invoice="<%= inv._id %>" data-balance="<%= inv.balance %>" data-invoice-number="<%= inv.invoiceNumber %>">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Record Payment - <%= inv.invoiceNumber %></h5>
                                                            <button type="button" class="btn-close close-modal-btn" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label">Amount (KES)</label>
                                                                <input type="number" name="amount" class="form-control payment-amount" max="<%= inv.balance %>" step="0.01" min="0.01" required>
                                                                <small class="text-muted">Outstanding balance: KES <%= inv.balance.toLocaleString() %></small>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Payment Date</label>
                                                                <input type="date" name="paymentDate" class="form-control payment-date" value="<%= new Date().toISOString().split('T')[0] %>" required>
                                                            </div>
                                                            <div class="mb-3">
                                                                <label class="form-label">Payment Method</label>
                                                                <select name="method" class="form-select payment-method" required>
                                                                    <option value="mpesa">M-Pesa</option>
                                                                    <option value="bank_transfer">Bank Transfer</option>
                                                                    <option value="cheque">Cheque</option>
                                                                    <option value="cash">Cash</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3 reference-field">
                                                                <label class="form-label">Reference <span class="text-muted cash-hint" style="display:none;">(optional — auto-generated for cash)</span></label>
                                                                <input type="text" name="reference" class="form-control payment-reference" placeholder="e.g. MPESA-XXXX or Receipt #">
                                                            </div>
                                                            <div class="mb-3 receipt-field">
                                                                <label class="form-label">Receipt / Proof of Payment <span class="text-muted cash-hint" style="display:none;">(not required for cash)</span></label>
                                                                <input type="file" name="receipt" class="form-control payment-receipt" accept="image/jpeg,image/png,image/gif,application/pdf,.doc,.docx,.xls,.xlsx">
                                                                <small class="text-muted">Accepted: JPG, PNG, PDF, DOC, XLS (max 5 MB)</small>
                                                            </div>
                                                            <div class="mb-3 received-by-field" style="display:none;">
                                                                <label class="form-label">Received By <span class="text-danger">*</span></label>
                                                                <input type="text" name="received_by" class="form-control" placeholder="Name of person who handed over the cash">
                                                                <small class="text-muted">Required for all cash payments.</small>
                                                            </div>
                                                            <div class="modal-payment-msg" style="display:none;"></div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary close-modal-btn">Cancel</button>
                                                            <button type="submit" class="btn btn-primary payment-submit-btn">Record Payment</button>
                                                        </div>
    </form>
                </div>
                                            </div>
                                        </div>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <% if (pagination.pages > 1) { %>
                            <nav class="mt-4">
                                <ul class="pagination">
                                    <% for (let i = 1; i <= pagination.pages; i++) { %>
                                        <li class="page-item <%= i === pagination.page ? 'active' : '' %>">
                                            <a class="page-link" href="?page=<%= i %>&schoolId=<%= filters.schoolId %>&status=<%= filters.status %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>"><%= i %></a>
                                        </li>
                                    <% } %>
                                </ul>
                            </nav>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/main.js"></script>
    <script>
    function showToast(message, type, duration) {
        duration = duration || 3000;
        type = type || 'info';
        var toast = document.createElement('div');
        toast.className = 'toast toast-' + type;
        toast.textContent = message;
        toast.style.cssText = 'position:fixed;top:20px;right:20px;padding:1rem 1.5rem;border-radius:6px;color:#fff;font-weight:500;z-index:10000;opacity:0;transform:translateY(-20px);transition:all 0.3s ease;';
        if (type === 'success')  toast.style.backgroundColor = '#198754';
        else if (type === 'error') toast.style.backgroundColor = '#dc3545';
        else if (type === 'warning') toast.style.backgroundColor = '#ffc107';
        else                          toast.style.backgroundColor = '#6c757d';
        document.body.appendChild(toast);
        setTimeout(function () { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; }, 10);
        setTimeout(function () {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-20px)';
            setTimeout(function () { toast.remove(); }, 300);
        }, duration);
    }

    function openPaymentModal(invoiceId) {
        var el = document.getElementById('paymentModal' + invoiceId);
        if (el) { el.style.display = 'flex'; }
    }

    document.addEventListener('DOMContentLoaded', function () {
        console.log('[payment] DOMContentLoaded — starting payment form wiring');

        document.querySelectorAll('.modal-overlay').forEach(function (overlay) {
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay) overlay.style.display = 'none';
            });
            overlay.querySelectorAll('.close-modal-btn').forEach(function (btn) {
                if (btn) btn.addEventListener('click', function () { overlay.style.display = 'none'; });
            });
        });

        function updatePaymentModal(form) {
            var method  = form.querySelector('.payment-method');
            var isCash  = method && method.value === 'cash';
            var refRow  = form.querySelector('.reference-field');
            var recRow  = form.querySelector('.received-by-field');
            if (refRow) {
                refRow.style.display = isCash ? '' : 'none';
                var refInput = refRow.querySelector('.payment-reference');
                if (refInput) refInput.required = !isCash;
            }
            if (recRow) {
                recRow.style.display = isCash ? '' : 'none';
                var recInput = recRow.querySelector('[name="received_by"]');
                if (recInput) recInput.required = isCash;
            }
        }

        function showMsg(form, type, html) {
            var el = form.querySelector('.modal-payment-msg');
            if (el) {
                el.className = 'alert alert-' + (type === 'error' ? 'error' : 'success');
                el.innerHTML  = html;
                el.style.display = 'block';
            }
        }

        function setSubmitState(btn, busy) {
            if (!btn) return;
            if (busy) { btn.dataset._orig = btn.textContent; btn.textContent = 'Recording\u2026'; btn.disabled = true; }
            else       { btn.textContent = btn.dataset._orig || 'Record Payment'; btn.disabled = false; }
        }

        document.querySelectorAll('.payment-form').forEach(function (form) {
            updatePaymentModal(form);
            var pm = form.querySelector('.payment-method');
            if (pm) pm.addEventListener('change', function () { updatePaymentModal(form); });

            form.addEventListener('submit', function (e) {
                var balance = parseFloat(form.dataset.balance || '0');
                var amount  = parseFloat(form.querySelector('.payment-amount').value || '0');

                if (isNaN(amount) || amount <= 0 || amount > balance) return; // let HTML5 field UI surface this

                e.preventDefault();
                console.log('[payment] submit intercepted, amount=', amount);

                var btn  = form.querySelector('.payment-submit-btn');
                var msg  = form.querySelector('.modal-payment-msg');
                setSubmitState(btn, true);

                fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' })
                .then(function (resp) { console.log('[payment] response status:', resp.status); return resp.json(); })
                .then(function (data) {
                    console.log('[payment] response data:', data);
                    if (data.success) {
                        showToast('Payment recorded successfully!', 'success');
                        setTimeout(function () { location.href = '/finance/invoices'; }, 1800);
                    } else {
                        showMsg(form, 'error', data.error || 'Failed to record payment. Please try again.');
                        setSubmitState(btn, false);
                    }
                })
                .catch(function (err) {
                    console.error('[payment] fetch error:', err);
                    showMsg(form, 'error', 'Network error: ' + err.message + '. Please try again.');
                    setSubmitState(btn, false);
                });
            });
        });
    });
    </script>
</body>
</html>

