<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trainer Cost Report - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { user, page: 'finance/reports' }) %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Trainer Cost Report</h1>
                <div class="btn-toolbar">
                    <a href="/finance/reports" class="btn btn-outline-secondary btn-sm">Back</a>
                    <form action="/finance/reports/export" method="POST" class="d-inline">
                        <input type="hidden" name="reportType" value="trainer_costs">
                        <input type="hidden" name="startDate" value="<%= startDate %>">
                        <input type="hidden" name="endDate" value="<%= endDate %>">
                        <button type="submit" class="btn btn-outline-success btn-sm ms-2">Export CSV</button>
                    </form>
                </div>
            </header>

            <div class="container-fluid mt-4">
                <div class="card">
                    <div class="card-body">
                        <h4 class="mb-4">
                            Trainer Costs
                            <small class="text-muted">
                                <%= new Date(startDate).toLocaleDateString() %> - <%= new Date(endDate).toLocaleDateString() %>
                            </small>
                        </h4>

                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Trainer</th>
                                        <th class="text-center">Events</th>
                                        <th class="text-center">Total Days</th>
                                        <th class="text-end">Daily Rate</th>
                                        <th class="text-end">Est. Cost</th>
                                        <th class="text-end">Actual Paid</th>
                                        <th class="text-end">Variance</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% reportData.forEach((t, idx) => { 
                                        const variance = (t.estimatedCost || 0) - (t.actualPaid || 0);
                                        const varianceClass = variance >= 0 ? 'text-success' : 'text-danger';
                                    %>
                                        <tr>
                                            <td><%= t.trainerName || 'Unknown' %></td>
                                            <td class="text-center"><%= t.eventsCount %></td>
                                            <td class="text-center"><%= t.totalDays %></td>
                                            <td class="text-end">KES <%= t.dailyRate?.toLocaleString() || 0 %></td>
                                            <td class="text-end fw-bold">KES <%= (t.estimatedCost || 0).toLocaleString() %></td>
                                            <td class="text-end">KES <%= (t.actualPaid || 0).toLocaleString() %></td>
                                            <td class="text-end <%= varianceClass %>">
                                                <%= variance >= 0 ? '+' : '' %>KES <%= variance.toLocaleString() %>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                                <tfoot>
                                    <tr class="table-primary">
                                        <th colspan="4">TOTAL</th>
                                        <th class="text-end">KES <%= reportData.reduce((sum, t) => sum + (t.estimatedCost || 0), 0).toLocaleString() %></th>
                                        <th class="text-end">KES <%= reportData.reduce((sum, t) => sum + (t.actualPaid || 0), 0).toLocaleString() %></th>
                                        <th></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
