<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financial Reports - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style>
        .report-card {
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }
        .report-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }
        .report-icon {
            width: 48px;
            height: 48px;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../../partials/sidebar', { user, page: 'finance/reports' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Financial Reports</h1>
                <div class="btn-toolbar">
                    <a href="/finance/dashboard" class="btn btn-outline-secondary btn-sm">Back to Dashboard</a>
                </div>
            </header>

            <div class="container-fluid mt-4">
                <!-- Quick Stats -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body text-center">
                                <h6 class="card-title">This Month Revenue</h6>
                                <p class="fs-4 mb-0 text-success">KES <%= (monthlyStats.revenue || 0).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body text-center">
                                <h6 class="card-title">This Month Expenses</h6>
                                <p class="fs-4 mb-0 text-danger">KES <%= (monthlyStats.expenses || 0).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body text-center">
                                <h6 class="card-title">Net Income</h6>
                                <p class="fs-4 mb-0 <%= (monthlyStats.netIncome || 0) >= 0 ? 'text-success' : 'text-danger' %>">
                                    KES <%= (monthlyStats.netIncome || 0).toLocaleString() %>
                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card">
                            <div class="card-body text-center">
                                <h6 class="card-title">Outstanding</h6>
                                <p class="fs-4 mb-0 text-warning">KES <%= (monthlyStats.outstanding || 0).toLocaleString() %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Report Categories -->
                <div class="row g-4">
                    <!-- Profit & Loss Reports -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Profit & Loss Reports</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('profit_loss', 'month')">
                                            <svg class="report-icon text-success mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z"/>
                                            </svg>
                                            <h6 class="mb-2">Monthly P&L</h6>
                                            <p class="text-muted small">Current month profit & loss summary</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('profit_loss', 'quarter')">
                                            <svg class="report-icon text-primary mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.293l-3-3a1 1 0 00-1.414 0l-3 3a1 1 0 001.414 1.414L9 9.414V13a1 1 0 102 0V9.414l1.293 1.293a1 1 0 001.414-1.414z" clip-rule="evenodd"/>
                                            </svg>
                                            <h6 class="mb-2">Quarterly P&L</h6>
                                            <p class="text-muted small">3-month profit & loss analysis</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('profit_loss', 'year')">
                                            <svg class="report-icon text-info mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                                            </svg>
                                            <h6 class="mb-2">Annual P&L</h6>
                                            <p class="text-muted small">Year-to-date profit & loss</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('profit_loss', 'custom')">
                                            <svg class="report-icon text-warning mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M3 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm0 4a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                            <h6 class="mb-2">Custom P&L</h6>
                                            <p class="text-muted small">Select custom date range</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Revenue & Performance Reports -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Revenue & Performance Reports</h6>
                            </div>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('school_revenue', 'month')">
                                            <svg class="report-icon text-success mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.84L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.84l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
                                            </svg>
                                            <h6 class="mb-2">School Revenue</h6>
                                            <p class="text-muted small">Revenue breakdown by school</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('trainer_costs', 'month')">
                                            <svg class="report-icon text-primary mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/>
                                            </svg>
                                            <h6 class="mb-2">Trainer Costs</h6>
                                            <p class="text-muted small">Staff and trainer expenses</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('payment_methods', 'month')">
                                            <svg class="report-icon text-info mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M4 4a2 2 0 00-2 2v4a2 2 0 002 2V6h10a2 2 0 00-2-2H4zm2 6a2 2 0 012-2h8a2 2 0 012 2v4a2 2 0 01-2 2H8a2 2 0 01-2-2v-4zm6 4a2 2 0 100-4 2 2 0 000 4z"/>
                                            </svg>
                                            <h6 class="mb-2">Payment Methods</h6>
                                            <p class="text-muted small">Payment method analysis</p>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="report-card card h-100 p-3 text-center" onclick="generateReport('outstanding_invoices', 'all')">
                                            <svg class="report-icon text-warning mx-auto" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                            </svg>
                                            <h6 class="mb-2">Outstanding</h6>
                                            <p class="text-muted small">Overdue and pending invoices</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Reports -->
                <div class="card mt-4">
                    <div class="card-header">
                        <h6 class="card-title mb-0">Recent Reports</h6>
                    </div>
                    <div class="card-body">
                        <% if (recentReports && recentReports.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Report Type</th>
                                        <th>Period</th>
                                        <th>Generated</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% recentReports.forEach(report => { %>
                                    <tr>
                                        <td><%= report.type.replace('_', ' ').toUpperCase() %></td>
                                        <td><%= report.period %></td>
                                        <td><%= new Date(report.generatedAt).toLocaleDateString() %></td>
                                        <td>
                                            <a href="<%= report.downloadUrl %>" class="btn btn-sm btn-outline-primary">Download</a>
                                        </td>
                                    </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                        <p class="text-muted text-center py-3">No recent reports. Generate your first report above.</p>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Custom Date Range Modal -->
    <div class="modal fade" id="customDateModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Date Range</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="customDateForm">
                        <div class="mb-3">
                            <label for="startDate" class="form-label">Start Date</label>
                            <input type="date" class="form-control" id="startDate" required>
                        </div>
                        <div class="mb-3">
                            <label for="endDate" class="form-label">End Date</label>
                            <input type="date" class="form-control" id="endDate" required>
                        </div>
                        <input type="hidden" id="reportType">
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="generateCustomReport()">Generate Report</button>
                </div>
            </div>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        function generateReport(type, period) {
            if (period === 'custom') {
                document.getElementById('reportType').value = type;
                new bootstrap.Modal(document.getElementById('customDateModal')).show();
            } else {
                window.location.href = `/finance/reports/${type}?period=${period}`;
            }
        }

        function generateCustomReport() {
            const type = document.getElementById('reportType').value;
            const startDate = document.getElementById('startDate').value;
            const endDate = document.getElementById('endDate').value;

            if (!startDate || !endDate) {
                alert('Please select both start and end dates');
                return;
            }

            if (new Date(startDate) > new Date(endDate)) {
                alert('Start date cannot be after end date');
                return;
            }

            window.location.href = `/finance/reports/${type}?startDate=${startDate}&endDate=${endDate}`;
        }
    </script>

    <script src="/js/main.js"></script>
</body>
</html>
