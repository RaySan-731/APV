<%
/**
 * Reports Center
 * Founder/Admin view for all wrap-up reports + other system reports
 * Path: views/reports/custom_builder.ejs
 */
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports Center - APV</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style nonce="<%= cspNonce %>">
        .reports-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
        .stat-card { background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.25rem; min-width: 140px; }
        .stat-number { font-size: 1.75rem; font-weight: 700; line-height: 1; }
        .report-row:hover { background: var(--muted); }
        .report-modal { max-width: 900px; width: 95%; }
        .report-section { margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border); }
        .report-section:last-child { border-bottom: none; }
        .badge-sm { font-size: 0.7rem; padding: 0.1rem 0.4rem; }
        .filter-bar { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1rem; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path><path d="M3 6h18"></path><path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Reports Center</h1>
                <div class="user-info"><span>Welcome, <%= user.name %></span></div>
            </header>

            <div class="dashboard-content">

                <!-- Stats -->
                <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
                    <div class="stat-card">
                        <div class="stat-number"><%= submittedReports.length %></div>
                        <div style="font-size: 0.85rem; color: var(--muted-foreground);">Wrap-up Reports Submitted</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= scheduledReports.length %></div>
                        <div style="font-size: 0.85rem; color: var(--muted-foreground);">Active Scheduled Reports</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-number"><%= submittedReports.filter(r => r.review?.reportSubmittedAt && (Date.now() - new Date(r.review.reportSubmittedAt).getTime()) < 30*24*60*60*1000).length %></div>
                        <div style="font-size: 0.85rem; color: var(--muted-foreground);">Submitted in Last 30 Days</div>
                    </div>
                </div>

                <!-- Post-Event Wrap-Up Reports -->
                <div class="content-card" style="margin-bottom: 2rem;">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center;">
                        <h3>Post-Event Wrap-Up Reports</h3>
                        <input type="text" id="reportSearch" placeholder="Search events or trainers..." 
                               style="padding: 0.4rem 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); min-width: 220px;"
                               onkeyup="filterReports()">
                    </div>
                    <div class="card-content">
                        <% if (submittedReports.length === 0) { %>
                            <p class="placeholder-text">No wrap-up reports have been submitted yet.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="data-table" id="reportsTable">
                                    <thead>
                                        <tr>
                                            <th>Event</th>
                                            <th>Date</th>
                                            <th>Trainer(s)</th>
                                            <th>Submitted</th>
                                            <th>Attendees</th>
                                            <th>Satisfaction</th>
                                            <th style="width: 120px;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="reportsBody">
                                        <!-- Populated by JS -->
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Automated / Scheduled Reports -->
                <div class="content-card" style="margin-bottom: 2rem;">
                    <div class="card-header">
                        <h3>Automated &amp; Scheduled Reports</h3>
                    </div>
                    <div class="card-content">
                        <% if (scheduledReports.length === 0) { %>
                            <p class="placeholder-text">No automated reports are currently scheduled.</p>
                        <% } else { %>
                            <div class="table-responsive">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Type</th>
                                            <th>Frequency</th>
                                            <th>Next Run</th>
                                            <th>Created By</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% scheduledReports.forEach(report => { %>
                                            <tr>
                                                <td><strong><%= report.name %></strong></td>
                                                <td><span class="badge badge-secondary"><%= report.reportType %></span></td>
                                                <td><%= report.frequency %></td>
                                                <td><%= new Date(report.nextSendAt).toLocaleDateString() %></td>
                                                <td><%= report.createdBy?.name || 'System' %></td>
                                                <td><span class="badge badge-success">Active</span></td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Quick Links to Other Reports -->
                <div class="content-card">
                    <div class="card-header"><h3>Other Reports &amp; Analytics</h3></div>
                    <div class="card-content" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
                        <a href="/dashboard/analytics#trainer-performance" class="btn btn-outline" style="padding: 1rem; text-align: left; display: block;">
                            <strong>Trainer Performance</strong><br>
                            <small>Analytics dashboard</small>
                        </a>
                        <a href="/dashboard/analytics#event-engagement" class="btn btn-outline" style="padding: 1rem; text-align: left; display: block;">
                            <strong>Event Effectiveness</strong><br>
                            <small>Analytics dashboard</small>
                        </a>
                        <a href="/dashboard/analytics#school-participation" class="btn btn-outline" style="padding: 1rem; text-align: left; display: block;">
                            <strong>School Engagement</strong><br>
                            <small>Analytics dashboard</small>
                        </a>
                        <a href="/finance/dashboard" class="btn btn-outline" style="padding: 1rem; text-align: left; display: block;">
                            <strong>Financial Reports</strong><br>
                            <small>Finance dashboard &amp; exports</small>
                        </a>
                        <a href="/dashboard/reports/builder" class="btn btn-outline" style="padding: 1rem; text-align: left; display: block; opacity: 0.6;">
                            <strong>Custom Report Builder</strong><br>
                            <small>(Legacy - coming soon)</small>
                        </a>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Full Wrap-Up Report Modal -->
    <div id="reportModal" class="modal-overlay" style="display: none; align-items: center; justify-content: center; z-index: 9999;">
        <div class="modal-content report-modal" style="max-height: 90vh; overflow-y: auto; background: var(--card);">
            <div class="modal-header" style="position: sticky; top: 0; background: var(--card); z-index: 10;">
                <h3 id="modalEventTitle">Post-Event Wrap-Up Report</h3>
                <button onclick="closeReportModal()" class="close-btn">&times;</button>
            </div>
            <div class="modal-body" id="modalReportBody" style="padding: 1.25rem;">
                <!-- Dynamically rendered report content -->
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" onclick="closeReportModal()">Close</button>
                <button class="btn btn-outline" onclick="exportReportCSV()">Export CSV</button>
                <button class="btn btn-primary" onclick="exportReportPDF()">Export PDF</button>
            </div>
        </div>
    </div>

    <script nonce="<%= cspNonce %>">
        // Data injected by server
        window.submittedReports = <%- JSON.stringify(submittedReports || []) %>;

        function formatDate(d) {
            if (!d) return '—';
            return new Date(d).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function renderReportsTable(filteredReports) {
            const tbody = document.getElementById('reportsBody');
            if (!tbody) return;

            tbody.innerHTML = '';

            if (!filteredReports || filteredReports.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding: 2rem; color: var(--muted-foreground);">No matching reports found.</td></tr>';
                return;
            }

            filteredReports.forEach((event, index) => {
                const review = event.review || {};
                const trainers = (event.trainers || []).map(t => t.trainerId?.name || 'Unknown').join(', ');
                const submitted = review.reportSubmittedAt ? formatDate(review.reportSubmittedAt) : '—';
                const actual = review.actualAttendeeCount || '—';
                const reg = review.registeredAttendeeCount ? ` / ${review.registeredAttendeeCount}` : '';
                const sat = review.satisfactionRatings 
                    ? `★${review.satisfactionRatings.trainerSatisfaction || 0} / ${review.satisfactionRatings.scoutSatisfaction || 0}` 
                    : '—';

                const row = document.createElement('tr');
                row.className = 'report-row';
                row.innerHTML = `
                    <td><strong>${event.name}</strong></td>
                    <td>${formatDate(event.endDate)}</td>
                    <td>${trainers}</td>
                    <td>${submitted}</td>
                    <td>${actual}${reg}</td>
                    <td>${sat}</td>
                    <td>
                        <button class="btn btn-sm btn-primary" onclick="showFullReport(${index})">View Full</button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function filterReports() {
            const term = (document.getElementById('reportSearch')?.value || '').toLowerCase().trim();
            if (!window.submittedReports) return;

            const filtered = window.submittedReports.filter(ev => {
                const name = (ev.name || '').toLowerCase();
                const trainers = (ev.trainers || []).map(t => (t.trainerId?.name || '')).join(' ').toLowerCase();
                return name.includes(term) || trainers.includes(term);
            });

            renderReportsTable(filtered);
        }

        // Show detailed wrap-up report in modal
        function showFullReport(index) {
            const event = window.submittedReports[index];
            if (!event) return;

            const review = event.review || {};
            const modal = document.getElementById('reportModal');
            const body = document.getElementById('modalReportBody');
            const title = document.getElementById('modalEventTitle');

            title.textContent = `${event.name} — Wrap-Up Report`;

            let html = `
                <div style="margin-bottom: 1rem; color: var(--muted-foreground);">
                    <strong>Submitted:</strong> ${review.reportSubmittedAt ? new Date(review.reportSubmittedAt).toLocaleString() : '—'} 
                    ${review.reportSubmittedBy?.name ? `by ${review.reportSubmittedBy.name}` : ''}
                </div>
            `;

            // Attendance
            html += `
                <div class="report-section">
                    <h4>1. Attendance</h4>
                    <p><strong>Actual Attendees:</strong> ${review.actualAttendeeCount ?? 'Not recorded'}</p>
                    <p><strong>Registered:</strong> ${review.registeredAttendeeCount ?? 'N/A'}</p>
                </div>
            `;

            // Activity Summary
            if (review.activitySessions && review.activitySessions.length) {
                html += `<div class="report-section"><h4>2. Activity Summary</h4><ul>`;
                review.activitySessions.forEach(s => {
                    html += `<li><strong>${s.name}</strong> (${s.durationMinutes || 0} min, ${s.participationLevel || 'medium'}) — ${s.description || ''}</li>`;
                });
                html += `</ul></div>`;
            }

            if (review.newToolsUsed || review.newMethodsUsed) {
                html += `<p><strong>New Tools/Methods:</strong> ${[review.newToolsUsed, review.newMethodsUsed].filter(Boolean).join(' / ')}</p>`;
            }

            // Outcomes
            html += `<div class="report-section"><h4>3. Outcomes &amp; Impact</h4>`;
            if (review.scoutEngagement) html += `<p><strong>Scout Engagement:</strong> ${review.scoutEngagement}</p>`;
            if (review.skillsGained?.length) html += `<p><strong>Skills Gained:</strong> ${review.skillsGained.join(', ')}</p>`;
            if (review.notableAchievements) html += `<p><strong>Notable Achievements:</strong> ${review.notableAchievements}</p>`;
            html += `</div>`;

            // Challenges
            html += `<div class="report-section"><h4>4. Challenges &amp; Issues</h4>`;
            if (review.logisticalIssues) html += `<p><strong>Logistical:</strong> ${review.logisticalIssues}</p>`;
            if (review.behavioralIssues) html += `<p><strong>Behavioral:</strong> ${review.behavioralIssues}</p>`;
            if (review.suggestionsForImprovement) html += `<p><strong>Suggestions:</strong> ${review.suggestionsForImprovement}</p>`;
            html += `</div>`;

            // Satisfaction
            if (review.satisfactionRatings) {
                html += `
                    <div class="report-section"><h4>5. Satisfaction Ratings</h4>
                    <p><strong>Trainer:</strong> ${'★'.repeat(review.satisfactionRatings.trainerSatisfaction || 0)}</p>
                    <p><strong>Scouts:</strong> ${'★'.repeat(review.satisfactionRatings.scoutSatisfaction || 0)}</p>
                    </div>
                `;
            }

            // Follow-up
            if (review.recommendedNextTraining || review.scoutsNeedingSupport || review.adminTasks) {
                html += `<div class="report-section"><h4>6. Follow-Up Actions</h4>`;
                if (review.recommendedNextTraining) html += `<p><strong>Recommended Next Training:</strong> ${review.recommendedNextTraining}</p>`;
                if (review.scoutsNeedingSupport) html += `<p><strong>Scouts Needing Support:</strong> ${review.scoutsNeedingSupport}</p>`;
                if (review.adminTasks) html += `<p><strong>Admin Tasks:</strong> ${review.adminTasks}</p>`;
                html += `</div>`;
            }

            // Narrative
            if (review.trainerReport) {
                html += `
                    <div class="report-section">
                        <h4>7. Event Report Narrative</h4>
                        <div style="white-space: pre-wrap; background: var(--muted); padding: 1rem; border-radius: var(--radius);">
                            ${review.trainerReport}
                        </div>
                    </div>
                `;
            }

            body.innerHTML = html;
            modal.style.display = 'flex';
            window.currentReportIndex = index;
        }

        function closeReportModal() {
            document.getElementById('reportModal').style.display = 'none';
            window.currentReportIndex = null;
        }

        function exportReportPDF() {
            const index = window.currentReportIndex;
            if (index === null || index === undefined) {
                alert('No report selected');
                return;
            }
            const event = window.submittedReports[index];
            const review = event.review || {};
            const trainers = (event.trainers || []).map(t => t.trainerId?.name || 'Unknown').join(', ');

            const printWindow = window.open('', '_blank');
            const now = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

            let content = `
                <div style="max-width: 900px; margin: 0 auto; font-family: 'Segoe UI', system-ui, sans-serif; color: #111;">
                    <!-- Header -->
                    <div style="border-bottom: 3px solid #1e40af; padding-bottom: 12px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: flex-end;">
                        <div>
                            <div style="font-size: 22px; font-weight: 700; color: #1e40af; letter-spacing: 1px;">ARROW-PARK VENTURES</div>
                            <div style="font-size: 13px; color: #555;">Management System</div>
                        </div>
                        <div style="text-align: right;">
                            <div style="font-size: 11px; color: #666;">CONFIDENTIAL</div>
                            <div style="font-size: 12px; font-weight: 600;">Post-Event Wrap-Up Report</div>
                        </div>
                    </div>

                    <h1 style="font-size: 20px; margin: 0 0 6px 0; color: #111;">${event.name}</h1>
                    <div style="margin-bottom: 20px; color: #555; font-size: 13px;">
                        ${formatDate(event.startDate)} – ${formatDate(event.endDate)} &nbsp;&nbsp;|&nbsp;&nbsp; 
                        Trainers: <strong>${trainers}</strong>
                    </div>

                    <table style="width:100%; border-collapse: collapse; margin-bottom: 24px; font-size: 13px;">
                        <tr>
                            <td style="padding: 6px 10px; background:#f8f9fc; border:1px solid #e2e8f0; width: 180px;"><strong>Submitted</strong></td>
                            <td style="padding: 6px 10px; border:1px solid #e2e8f0;">${review.reportSubmittedAt ? new Date(review.reportSubmittedAt).toLocaleString() : '—'}</td>
                        </tr>
                        <tr>
                            <td style="padding: 6px 10px; background:#f8f9fc; border:1px solid #e2e8f0;"><strong>Submitted By</strong></td>
                            <td style="padding: 6px 10px; border:1px solid #e2e8f0;">${review.reportSubmittedBy?.name || '—'}</td>
                        </tr>
                    </table>
            `;

            // Attendance
            content += `
                <h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">1. Attendance</h3>
                <table style="width:100%; border-collapse: collapse; font-size:13px; margin-bottom:16px;">
                    <tr><td style="padding:4px 8px; border:1px solid #e2e8f0; width:200px;">Actual Attendees</td><td style="padding:4px 8px; border:1px solid #e2e8f0;">${review.actualAttendeeCount ?? 'Not recorded'}</td></tr>
                    <tr><td style="padding:4px 8px; border:1px solid #e2e8f0;">Registered Attendees</td><td style="padding:4px 8px; border:1px solid #e2e8f0;">${review.registeredAttendeeCount ?? 'N/A'}</td></tr>
                </table>
            `;

            // Activity Summary
            if (review.activitySessions && review.activitySessions.length) {
                content += `<h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">2. Activity Summary</h3>`;
                content += `<ul style="margin:0 0 12px 20px; padding:0;">`;
                review.activitySessions.forEach(s => {
                    content += `<li style="margin-bottom:4px;"><strong>${s.name}</strong> (${s.durationMinutes || 0} min, participation: ${s.participationLevel || 'medium'}) — ${s.description || ''}</li>`;
                });
                content += `</ul>`;
            }

            // Outcomes
            content += `<h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">3. Outcomes &amp; Impact</h3>`;
            if (review.scoutEngagement) content += `<p><strong>Scout Engagement:</strong> ${review.scoutEngagement}</p>`;
            if (review.skillsGained?.length) content += `<p><strong>Skills Gained:</strong> ${review.skillsGained.join(', ')}</p>`;
            if (review.notableAchievements) content += `<p><strong>Notable Achievements:</strong> ${review.notableAchievements}</p>`;

            // Challenges
            content += `<h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">4. Challenges &amp; Issues</h3>`;
            if (review.logisticalIssues) content += `<p><strong>Logistical Issues:</strong> ${review.logisticalIssues}</p>`;
            if (review.behavioralIssues) content += `<p><strong>Behavioral Issues:</strong> ${review.behavioralIssues}</p>`;
            if (review.suggestionsForImprovement) content += `<p><strong>Suggestions for Improvement:</strong> ${review.suggestionsForImprovement}</p>`;

            // Satisfaction
            if (review.satisfactionRatings) {
                content += `<h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">5. Satisfaction Ratings</h3>`;
                content += `<p><strong>Trainer Satisfaction:</strong> ${review.satisfactionRatings.trainerSatisfaction || 0}/5</p>`;
                content += `<p><strong>Scout Satisfaction:</strong> ${review.satisfactionRatings.scoutSatisfaction || 0}/5</p>`;
            }

            // Follow-up
            content += `<h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">6. Follow-Up Actions</h3>`;
            if (review.recommendedNextTraining) content += `<p><strong>Recommended Next Training:</strong> ${review.recommendedNextTraining}</p>`;
            if (review.scoutsNeedingSupport) content += `<p><strong>Scouts Needing Support:</strong> ${review.scoutsNeedingSupport}</p>`;
            if (review.adminTasks) content += `<p><strong>Admin Tasks:</strong> ${review.adminTasks}</p>`;

            // Narrative
            if (review.trainerReport) {
                content += `
                    <h3 style="font-size:14px; margin:20px 0 8px; color:#1e40af; border-bottom:1px solid #e2e8f0; padding-bottom:4px;">7. Event Report Narrative</h3>
                    <div style="white-space: pre-wrap; background:#f8f9fc; padding:14px; border:1px solid #e2e8f0; border-radius:4px; line-height:1.5;">
                        ${review.trainerReport.replace(/</g,'&lt;').replace(/>/g,'&gt;')}
                    </div>
                `;
            }

            content += `
                    <div style="margin-top: 40px; padding-top: 16px; border-top: 1px solid #ddd; font-size: 11px; color: #666; display:flex; justify-content: space-between;">
                        <div>Generated on ${now}</div>
                        <div>Arrow-Park Ventures • Confidential</div>
                    </div>
                </div>
            `;

            printWindow.document.write(`
                <html>
                <head>
                    <title>${event.name} - Wrap-Up Report</title>
                    <style>
                        @media print {
                            body { margin: 0; padding: 20px; }
                            h3 { page-break-after: avoid; }
                        }
                        body { font-family: 'Segoe UI', system-ui, sans-serif; line-height: 1.45; color: #222; }
                        h3 { color: #1e40af; font-size: 13px; margin: 18px 0 6px; }
                        p { margin: 4px 0; }
                    </style>
                </head>
                <body>${content}</body>
                </html>
            `);
            printWindow.document.close();
            printWindow.focus();
            setTimeout(() => printWindow.print(), 400);
        }

        function exportReportCSV() {
            const index = window.currentReportIndex;
            if (index === null || index === undefined) {
                alert('No report selected');
                return;
            }
            const event = window.submittedReports[index];
            const review = event.review || {};
            const trainers = (event.trainers || []).map(t => t.trainerId?.name || 'Unknown').join(' | ');

            const rows = [
                ['Field', 'Value'],
                ['Event Name', event.name],
                ['Event Start Date', event.startDate],
                ['Event End Date', event.endDate],
                ['Trainers', trainers],
                ['Report Submitted At', review.reportSubmittedAt],
                ['Submitted By', review.reportSubmittedBy?.name || ''],
                ['Actual Attendees', review.actualAttendeeCount || ''],
                ['Registered Attendees', review.registeredAttendeeCount || ''],
                ['Scout Engagement', review.scoutEngagement || ''],
                ['Skills Gained', (review.skillsGained || []).join('; ')],
                ['Notable Achievements', review.notableAchievements || ''],
                ['Logistical Issues', review.logisticalIssues || ''],
                ['Behavioral Issues', review.behavioralIssues || ''],
                ['Suggestions for Improvement', review.suggestionsForImprovement || ''],
                ['Trainer Satisfaction', review.satisfactionRatings?.trainerSatisfaction || ''],
                ['Scout Satisfaction', review.satisfactionRatings?.scoutSatisfaction || ''],
                ['Recommended Next Training', review.recommendedNextTraining || ''],
                ['Scouts Needing Support', review.scoutsNeedingSupport || ''],
                ['Admin Tasks', review.adminTasks || ''],
                ['Narrative Report', (review.trainerReport || '').replace(/\n/g, ' | ') ]
            ];

            let csvContent = rows.map(row => 
                row.map(field => `"${String(field || '').replace(/"/g, '""')}"`).join(',')
            ).join('\n');

            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.href = url;
            link.download = `wrapup_report_${event.name.replace(/[^a-z0-9]/gi, '_').toLowerCase()}_${new Date().toISOString().slice(0,10)}.csv`;
            link.style.display = 'none';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // Initial render
        document.addEventListener('DOMContentLoaded', function() {
            if (window.submittedReports && window.submittedReports.length > 0) {
                renderReportsTable(window.submittedReports);
            }

            // Keyboard escape for modal
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') {
                    const modal = document.getElementById('reportModal');
                    if (modal.style.display === 'flex') closeReportModal();
                }
            });
        });

        // Make functions globally available if needed
        window.showFullReport = showFullReport;
        window.filterReports = filterReports;
        window.exportReportPDF = exportReportPDF;
        window.exportReportCSV = exportReportCSV;
    </script>
</body>
</html>
