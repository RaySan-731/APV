<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style nonce="<%= cspNonce %>">
        .event-card { border:1px solid var(--border); border-radius:var(--radius); padding:1.25rem; margin-bottom:1rem; background:var(--card); }
        .event-card h3 { margin:0 0 0.5rem 0; font-size:1.15rem; color:var(--foreground); }
        .event-meta { display:flex; flex-wrap:wrap; gap:1rem; font-size:0.9rem; color:var(--muted-foreground); margin-bottom:0.75rem; }
        .event-meta div { display:flex; align-items:center; gap:0.25rem; }
        .rsvp-section { background:var(--muted); padding:0.75rem; border-radius:var(--radius); margin-top:0.75rem; }
        .rsvp-status { font-weight:600; margin-bottom:0.5rem; display:block; }
        .badge-invited { background:hsl(200,20%,90%); color:hsl(200,30%,20%); padding:0.25rem 0.5rem; border-radius:999px; font-size:0.75rem; }
        .badge-confirmed { background:hsl(140,60%,40%); color:white; }
        .badge-declined { background:hsl(0,70%,60%); color:white; }
        .badge-pending { background:hsl(30,80%,60%); color:white; }
        .filters { display:flex; gap:1rem; margin-bottom:1rem; flex-wrap:wrap; }
        .filter-btn { padding:0.5rem 1rem; border:1px solid var(--border); background:var(--card); border-radius:var(--radius); cursor:pointer; }
        .filter-btn.active { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); }
        .form-inline { display:flex; gap:0.5rem; align-items:flex-end; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path><path d="M3 6h18"></path><path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Events</h1>
            </header>

            <div class="dashboard-content">
                <div class="filters">
                    <button class="filter-btn active" data-filter="upcoming">Upcoming</button>
                    <button class="filter-btn" data-filter="past">Past Events</button>
                </div>

                <div id="upcomingEvents">
                    <% const upcoming = events && events.filter(e => e.status !== 'completed' && e.startDate && e.startDate >= new Date()) || []; %>
                    <h2>Upcoming Events (<%= upcoming.length %>)</h2>
                    <% if (!upcoming || upcoming.length === 0) { %>
                        <p class="placeholder-text">No upcoming events scheduled.</p>
                    <% } else { %>
                        <% upcoming.forEach(event => { %>
                            <div class="event-card" data-event-id="<%= event._id %>">
                                <h3><%= event.name || 'Unnamed Event' %></h3>
                                <div class="event-meta">
                                    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> <%= event.startDate ? new Date(event.startDate).toLocaleDateString() : 'TBD' %> - <%= event.endDate ? new Date(event.endDate).toLocaleDateString() : 'TBD' %></div>
                                    <div><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg> <%= event.location?.name || 'TBD' %></div>
                                    <div><span class="badge badge-primary"><%= event.eventType ? event.eventType.replace('_',' ') : 'Other' %></span></div>
                                </div>
                                <p><%= event.description || '' %></p>

                                <% const invitation = event.targetSchools?.find(s => schoolId && s.schoolId.toString() === schoolId.toString()); %>
                                <% if (invitation) { %>
                                    <div class="rsvp-section">
                                        <span class="rsvp-status">Your RSVP: <span class="badge badge-<%= invitation.rsvpStatus %>"><%= invitation.rsvpStatus %></span></span>
                                        <form class="form-inline rsvp-form" data-event-id="<%= event._id %>">
                                            <label>Attending count:</label>
                                            <input type="number" name="attendingCount" value="<%= invitation.attendance?.registered || 0 %>" min="0" style="padding:0.5rem;border:1px solid var(--border);border-radius:var(--radius);width:80px;">
                                            <button type="submit" class="btn btn-primary btn-sm">Update RSVP</button>
                                        </form>
                                    </div>
                                <% } else { %>
                                    <p class="placeholder-text">You are not invited to this event.</p>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div id="pastEvents" style="display:none;">
                    <h2>Past Events</h2>
                    <% const past = events && events.filter(e => e.status === 'completed' || (e.endDate && e.endDate < new Date())) || []; %>
                    <% if (!past || past.length === 0) { %>
                        <p class="placeholder-text">No past events.</p>
                    <% } else { %>
                        <% past.forEach(event => { %>
                            <div class="event-card">
                                <h3><%= event.name || 'Unnamed Event' %></h3>
                                <div class="event-meta">
                                    <div><%= event.startDate ? new Date(event.startDate).toLocaleDateString() : 'N/A' %> - <%= event.endDate ? new Date(event.endDate).toLocaleDateString() : 'N/A' %></div>
                                    <div><%= event.location?.name || 'TBD' %></div>
                                    <div><span class="badge badge-secondary"><%= event.eventType ? event.eventType.replace('_',' ') : 'Other' %></span></div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', function() {
            const filterBtns = document.querySelectorAll('.filter-btn');
            const upcomingDiv = document.getElementById('upcomingEvents');
            const pastDiv = document.getElementById('pastEvents');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    if (btn.dataset.filter === 'upcoming') {
                        upcomingDiv.style.display = 'block';
                        pastDiv.style.display = 'none';
                    } else {
                        upcomingDiv.style.display = 'none';
                        pastDiv.style.display = 'block';
                    }
                });
            });

            // RSVP form submission
            document.querySelectorAll('.rsvp-form').forEach(form => {
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const eventId = form.dataset.eventId;
                    const attendingCount = form.querySelector('[name="attendingCount"]').value;
                    const res = await fetch(`/api/school/events/${eventId}/attendance`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ rsvpStatus: 'confirmed', attendingCount })
                    });
                    const result = await res.json();
                    if (result.success) {
                        alert('RSVP updated');
                        location.reload();
                    } else {
                        alert('Error: ' + result.error);
                    }
                });
            });
        });
    </script>
</body>
</html>
