      <script nonce="<%= cspNonce %>">
        // Active Schools Modal functionality
        function openActiveSchoolsModal() {
          const modal = document.getElementById('activeSchoolsModal');
          const loadingEl = document.getElementById('activeSchoolsLoading');
          const contentEl = document.getElementById('activeSchoolsContent');
          const emptyEl = document.getElementById('activeSchoolsEmpty');
          
          // Show loading, hide others
          loadingEl.style.display = 'block';
          contentEl.style.display = 'none';
          emptyEl.style.display = 'none';
          modal.style.display = 'flex';

          // Fetch active schools data
          fetch('/api/schools/active', {
            headers: { 'Accept': 'application/json' }
          })
          .then(res => {
            if (!res.ok) {
              if (res.status === 403) {
                throw new Error('Access denied. You do not have permission to view schools.');
              } else if (res.status === 401) {
                throw new Error('Authentication required. Please log in.');
              }
              throw new Error('Failed to load schools');
            }
            return res.json();
          })
          .then(data => {
            loadingEl.style.display = 'none';
            if (data.success && data.schools && data.schools.length > 0) {
              populateActiveSchoolsTable(data.schools);
              contentEl.style.display = 'block';
              document.getElementById('activeSchoolsCount').textContent = data.schools.length;
            } else {
              emptyEl.style.display = 'block';
            }
          })
          .catch(err => {
            console.error('Error fetching active schools:', err);
            loadingEl.style.display = 'none';
            emptyEl.style.display = 'block';
            document.getElementById('activeSchoolsEmpty').innerHTML = '<p class="placeholder-text" style="color: var(--destructive);">' + err.message + '</p>';
          });
        }

        function closeActiveSchoolsModal() {
          const modal = document.getElementById('activeSchoolsModal');
          modal.style.display = 'none';
        }

        function populateActiveSchoolsTable(schools) {
          const tbody = document.getElementById('activeSchoolsTableBody');
          tbody.innerHTML = '';
          
          schools.forEach(school => {
            const tr = document.createElement('tr');
            const contact = school.contactPerson || {};
            const serviceStatus = school.serviceStatus || 'inactive';
            const badgeClass = serviceStatus === 'active' ? 'badge-success' : serviceStatus === 'on_hold' ? 'badge-warning' : 'badge-secondary';
            
            tr.innerHTML = `
              <td><strong>${school.name || '—'}</strong></td>
              <td>${school.address?.city || school.city || '—'}</td>
              <td>${school.region || '—'}</td>
              <td>${contact.name || '—'}</td>
              <td>${contact.phone || '—'}</td>
              <td>${(school.studentCount || 0).toLocaleString()}</td>
              <td><span class="badge ${badgeClass}">${serviceStatus.replace('_', ' ')}</span></td>
              <td>${school.participationMetrics?.totalEventsAttended || 0}</td>
              <td>${school.participationMetrics?.averageAttendanceRate || 0}%</td>
            `;
            tbody.appendChild(tr);
          });
        }

        (function attachExportHandlers() {
          const csvBtn = document.getElementById('exportActiveSchoolsCSV');
          const pdfBtn = document.getElementById('exportActiveSchoolsPDF');
          
          if (csvBtn) {
            csvBtn.addEventListener('click', function() {
              window.exportTable('csv', 'activeSchoolsTable');
            });
          }
          
          if (pdfBtn) {
            pdfBtn.addEventListener('click', function() {
              window.exportTable('pdf', 'activeSchoolsTable');
            });
          }
        })();

        document.addEventListener('click', function(event) {
          const modal = document.getElementById('activeSchoolsModal');
          if (event.target === modal) {
            closeActiveSchoolsModal();
          }
        });

        document.addEventListener('keydown', function(event) {
          if (event.key === 'Escape') {
            const modal = document.getElementById('activeSchoolsModal');
            if (modal && modal.style.display === 'flex') {
              closeActiveSchoolsModal();
            }
          }
        });

// Edit Program Modal functions
let currentEditProgramId = null;

async function openEditProgramModal(programId) {
  currentEditProgramId = programId;
  
  try {
    const response = await fetch(`/api/programs/${programId}`);
    const result = await response.json();
    
    if (response.ok && result.success) {
      const program = result.program;
      
      // Populate form fields
      document.getElementById('editProgramId').value = program._id;
      document.getElementById('editProgramName').value = program.name || '';
      document.getElementById('editProgramDescription').value = program.description || '';
      document.getElementById('editProgramCategory').value = program.category || 'leadership';
      document.getElementById('editAgeMin').value = program.ageGroup?.min || 8;
      document.getElementById('editAgeMax').value = program.ageGroup?.max || 16;
      document.getElementById('editProgramDuration').value = program.duration || 'half-day';
      document.getElementById('editMaxParticipants').value = program.maxParticipants || 10;
      document.getElementById('editPriceAmount').value = program.price?.amount || 0;
      document.getElementById('editPriceCurrency').value = program.price?.currency || 'USD';
      document.getElementById('editProgramStatus').value = program.status || 'active';
      
      document.getElementById('editProgramMessage').style.display = 'none';
      document.getElementById('editProgramModal').style.display = 'flex';
    } else {
      alert('Error loading program: ' + (result.error || 'Unknown error'));
    }
  } catch (err) {
    console.error('Error fetching program:', err);
    alert('Network error loading program');
  }
}

function closeEditProgramModal() {
  document.getElementById('editProgramModal').style.display = 'none';
  currentEditProgramId = null;
}

async function saveProgramEdit() {
  const programId = document.getElementById('editProgramId').value;
  
  const formData = {
    name: document.getElementById('editProgramName').value,
    description: document.getElementById('editProgramDescription').value,
    category: document.getElementById('editProgramCategory').value,
    ageMin: parseInt(document.getElementById('editAgeMin').value),
    ageMax: parseInt(document.getElementById('editAgeMax').value),
    duration: document.getElementById('editProgramDuration').value,
    maxParticipants: parseInt(document.getElementById('editMaxParticipants').value),
    priceAmount: parseFloat(document.getElementById('editPriceAmount').value),
    priceCurrency: document.getElementById('editPriceCurrency').value,
    status: document.getElementById('editProgramStatus').value
  };
  
  const messageEl = document.getElementById('editProgramMessage');
  messageEl.style.display = 'none';
  
  try {
    const response = await fetch(`/api/programs/${programId}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    });
    
    const result = await response.json();
    
    if (response.ok && result.success) {
      messageEl.textContent = '✓ Program updated successfully!';
      messageEl.className = 'message success';
      messageEl.style.display = 'block';
      setTimeout(() => {
        closeEditProgramModal();
        window.location.reload();
      }, 1000);
    } else {
      messageEl.textContent = '✗ ' + (result.error || 'Error updating program');
      messageEl.className = 'message error';
      messageEl.style.display = 'block';
    }
  } catch (err) {
    console.error('Error updating program:', err);
    messageEl.textContent = '✗ Network error';
    messageEl.className = 'message error';
    messageEl.style.display = 'block';
  }
}

// Close modal when clicking outside
document.addEventListener('click', function(event) {
  const editModal = document.getElementById('editProgramModal');
  if (event.target === editModal) {
    closeEditProgramModal();
  }
});


</script>

