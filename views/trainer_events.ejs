<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>My Events - Trainer Portal - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="icon" href="/favicon.ico" />
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <span>APV Trainer Portal</span>
                </div>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section">
                    <ul class="nav-list">
                        <li class="nav-item"><a href="/trainer/dashboard" class="nav-link">Home</a></li>
                        <li class="nav-item"><a href="/trainer/schools" class="nav-link">My Schools</a></li>
                        <li class="nav-item"><a href="/trainer/students" class="nav-link">Students</a></li>
                        <li class="nav-item"><a href="/trainer/events" class="nav-link active">Events</a></li>
                        <li class="nav-item"><a href="/trainer/profile" class="nav-link">My Profile</a></li>
                    </ul>
                </div>
            </nav>
            <div class="sidebar-footer">
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="dashboard-header">
                <h1>My Events</h1>
                <div class="user-info" style="display: flex; align-items: center; gap: 1rem;">
                    <div class="notification-bell" id="notificationBell" style="position: relative; cursor: pointer;">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span class="badge badge-danger" id="notificationBadge" style="position: absolute; top: -5px; right: -5px; display: none;">0</span>
                    </div>
                    <span>Welcome, <%= user.name %></span>
                </div>
            </header>

            <section class="dashboard-content">
                <!-- Notification Panel -->
                <div id="notificationPanel" class="notification-panel">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border); background: var(--card); position: sticky; top: 0; z-index: 1;">
                        <div style="display: flex; gap: 1rem;">
                            <button class="panel-tab active" data-tab="notifications">Notifications</button>
                            <button class="panel-tab" data-tab="messages">Messages</button>
                            <button class="panel-tab" data-tab="announcements">Announcements</button>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            <button id="markAllReadBtn" class="btn btn-sm btn-outline" style="border: none; background: transparent;">Mark all read</button>
                            <button id="closeNotificationPanel" class="btn btn-sm btn-outline" style="border: none; font-size: 1.2rem; line-height: 1; padding: 0.25rem 0.5rem;">&times;</button>
                        </div>
                    </div>
                    <div id="notificationPanelList" style="max-height: calc(100vh - 8rem); overflow-y: auto; padding: 0.5rem;"></div>
                </div>

                <!-- Message Modal -->
                <div id="messageModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
                    <div class="modal-content" style="background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow-card); width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; margin: 2rem;">
                        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid var(--border);">
                            <h3 id="modalMessageSubject" style="margin: 0;">Message</h3>
                            <button id="closeMessageModal" class="btn btn-sm btn-outline" style="border: none; font-size: 1.5rem; line-height: 1; cursor: pointer;">&times;</button>
                        </div>
                        <div id="modalMessageBody" class="card-content" style="padding: 1.5rem;"></div>
                    </div>
                </div>

                <!-- Accept/Decline Confirmation Modal -->
                <div id="confirmModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
                    <div class="modal-content" style="background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow-card); width: 100%; max-width: 500px; margin: 2rem;">
                        <div class="card-header" style="padding: 1.5rem; border-bottom: 1px solid var(--border);">
                            <h3 id="confirmModalTitle" style="margin: 0;">Confirm Action</h3>
                        </div>
                        <div class="card-content" style="padding: 1.5rem;">
                            <p id="confirmModalMessage">Are you sure?</p>
                            <div id="declineReasonContainer" style="display: none; margin-top: 1rem;">
                                <label>Reason (optional):</label>
                                <textarea id="declineReason" rows="3" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius);"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer" style="padding: 1rem 1.5rem; border-top: 1px solid var(--border); display: flex; gap: 0.5rem; justify-content: flex-end;">
                            <button class="btn btn-secondary" onclick="closeConfirmModal()">Cancel</button>
                            <button class="btn btn-primary" id="confirmModalBtn">Confirm</button>
                        </div>
                    </div>
                </div>

                <!-- Stats Grid -->
                <div class="stats-grid" id="trainerEventStats">
                    <div class="stat-card">
                        <div class="stat-icon">📅</div>
                        <div><div class="stat-number" id="upcomingEventsCount">0</div><div class="stat-label">Upcoming Events</div></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">✅</div>
                        <div><div class="stat-number" id="pendingAssignmentsCount">0</div><div class="stat-label">Pending Assignments</div></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">🏁</div>
                        <div><div class="stat-number" id="completedEventsCount">0</div><div class="stat-label">Completed Events</div></div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">📝</div>
                        <div><div class="stat-number" id="reportsDueCount">0</div><div class="stat-label">Reports Due</div></div>
                    </div>
                </div>

                <!-- Filters & Controls -->
                <div class="content-card" style="margin-bottom: 1.5rem;">
                    <div class="card-header">
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                            <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                                <h3>My Events</h3>
                                <input type="text" id="eventSearch" placeholder="Search events..." style="padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius); width: 200px;">
                                <select id="typeFilter" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <option value="">All Types</option>
                                    <option value="camp">Camp</option>
                                    <option value="hike">Hike</option>
                                    <option value="team_building">Team Building</option>
                                    <option value="training_session">Training Session</option>
                                    <option value="inter_school_competition">Inter-School Competition</option>
                                    <option value="other">Other</option>
                                </select>
                                <select id="statusFilter" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <option value="">All Statuses</option>
                                    <option value="assigned">Assigned</option>
                                    <option value="confirmed">Confirmed</option>
                                    <option value="declined">Declined</option>
                                    <option value="scheduled">Scheduled</option>
                                    <option value="in_progress">In Progress</option>
                                    <option value="completed">Completed</option>
                                    <option value="reviewed">Reviewed</option>
                                    <option value="cancelled">Cancelled</option>
                                </select>
                                <input type="date" id="startDateFilter" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                <input type="date" id="endDateFilter" style="padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius);">
                            </div>
                            <div style="display: flex; gap: 0.5rem;">
                                <button class="btn btn-secondary active" id="upcomingTabBtn" onclick="switchTab('upcoming')">Upcoming</button>
                                <button class="btn btn-secondary" id="pastTabBtn" onclick="switchTab('past')">Past</button>
                                <button class="btn btn-secondary" id="tableViewBtn">Table</button>
                                <button class="btn btn-secondary" id="calendarViewBtn">Calendar</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Table View -->
                <div id="tableView" class="content-card">
                    <div class="card-content">
                        <div class="table-responsive">
                        <table class="data-table" id="eventsTable">
                            <thead>
                                <tr>
                                    <th>Event Name</th>
                                    <th>Type</th>
                                    <th>Dates</th>
                                    <th>Location</th>
                                    <th>Status</th>
                                    <th>Your Role</th>
                                    <th>Assignment</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody id="eventsTableBody">
                                <!-- Events loaded via JS -->
                                </tbody>
                            </table>
                                </div>
                        <div id="eventsEmptyState" class="placeholder-text" style="display: none; text-align: center; padding: 2rem;">No events found.</div>
                    </div>
                </div>

                <!-- Calendar View (Month/Week/List) -->
                <div id="calendarView" class="content-card" style="display: none;">
                    <div class="card-header">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; gap: 0.5rem; align-items: center;">
                                <button class="btn btn-secondary" id="prevPeriodBtn">&lt; Previous</button>
                                <h3 id="calendarTitle">Calendar View</h3>
                                <button class="btn btn-secondary" id="nextPeriodBtn">Next &gt;</button>
                            </div>
                            <div style="display: flex; gap: 0.5rem;">
                                <select id="calendarViewType" class="btn btn-secondary">
                                    <option value="month">Month</option>
                                    <option value="week">Week</option>
                                    <option value="list">List</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="card-content" id="calendarContainer">
                        <!-- Calendar rendered via JS -->
                    </div>
                </div>
            </section>
        </main>
    </div>

    <!-- Load trainer events JavaScript -->
    <script src="/js/trainer_events.js"></script>
    <script>
      window.currentUserId = '<%= user.id %>';
    </script>
    <script src="/js/notifications.js"></script>
</body>
</html>
