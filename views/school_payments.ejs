<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payments - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style nonce="<%= cspNonce %>">
        .invoice-card { border:1px solid var(--border); border-radius:var(--radius); padding:1.25rem; margin-bottom:1rem; background:var(--card); display:flex; justify-content:space-between; align-items:flex-start; }
        .invoice-info h3 { margin:0 0 0.5rem 0; font-size:1.1rem; }
        .invoice-meta { font-size:0.9rem; color:var(--muted-foreground); margin-bottom:0.5rem; }
        .invoice-total { font-weight:600; font-size:1.1rem; color:var(--foreground); }
        .status-badge { display:inline-block; padding:0.25rem 0.5rem; border-radius:999px; font-size:0.75rem; font-weight:600; text-transform:uppercase; }
        .status-paid { background:hsl(140,60%,40%); color:white; }
        .status-issued { background:hsl(30,80%,60%); color:white; }
        .status-partial { background:hsl(40,80%,50%); color:white; }
        .status-overdue { background:hsl(0,70%,60%); color:white; }
        .status-sent { background:hsl(210,60%,50%); color:white; }
        .filters { display:flex; gap:0.5rem; margin-bottom:1.5rem; flex-wrap:wrap; }
        .filter-btn { padding:0.5rem 1rem; border:1px solid var(--border); background:var(--card); border-radius:var(--radius); cursor:pointer; }
        .filter-btn.active { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); }
        .stats-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-bottom:2rem; }
        .sent-toggle-btn { display:inline-flex; align-items:center; gap:0.4rem; padding:0.5rem 1rem; border:1px solid var(--border); background:var(--card); border-radius:var(--radius); cursor:pointer; font-size:0.875rem; font-weight:500; color:var(--foreground); margin-bottom:1.25rem; }
        .sent-toggle-btn:hover { background:var(--surface); }
        .sent-toggle-btn svg { width:16px; height:16px; }
        .sent-toggle-btn.active { background:var(--primary); color:var(--primary-foreground); border-color:var(--primary); }
        .sent-invoice-row { display:none; }
        .sent-section table { width:100%; border-collapse:collapse; margin-top:0.75rem; font-size:0.9rem; }
        .sent-section th, .sent-section td { padding:0.6rem 0.75rem; text-align:left; border-bottom:1px solid var(--border); }
        .sent-section th { color:var(--muted-foreground); font-weight:600; font-size:0.75rem; text-transform:uppercase; }
        .sent-section .send-note { display:block; margin:0.75rem 0 0; font-size:0.8rem; color:var(--muted-foreground); }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path><path d="M3 6h18"></path><path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Payments</h1>
            </header>

            <div class="dashboard-content">
                <!-- Summary Stats -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <span class="stat-label">Total Invoiced</span>
                        <span class="stat-value">KES <%= stats?.totalInvoiced ? stats.totalInvoiced.toLocaleString() : '0' %></span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Total Paid</span>
                        <span class="stat-value">KES <%= stats?.totalPaid ? stats.totalPaid.toLocaleString() : '0' %></span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Outstanding</span>
                        <span class="stat-value">KES <%= stats?.totalInvoiced - stats?.totalPaid ? (stats.totalInvoiced - stats.totalPaid).toLocaleString() : '0' %></span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Overdue Invoices</span>
                        <span class="stat-value"><%= stats?.overdueCount || 0 %></span>
                    </div>
                </div>

                <!-- Filters -->
                <div class="filters">
                    <button class="filter-btn active" data-filter="all">All</button>
                    <button class="filter-btn" data-filter="issued">Issued</button>
                    <button class="filter-btn" data-filter="sent">Sent</button>
                    <button class="filter-btn" data-filter="partial">Partial</button>
                    <button class="filter-btn" data-filter="overdue">Overdue</button>
                    <button class="filter-btn" data-filter="paid">Paid</button>
                </div>

                <!-- Toggle: Sent invoices by founder/admin -->
                <button id="sentToggle" class="sent-toggle-btn" onclick="toggleSentInvoices()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                    Invoices Sent by Founder / Admin
                </button>

                <!-- Sent-Invoices Sub-View -->
                <div id="sentSection" class="sent-section" style="display:none;margin-bottom:2rem;padding:1.25rem;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);">
                    <p class="send-note">Showing every invoice issued or transmitted to this school by a founder or administrator. The <strong>Issued By</strong> column shows who created the invoice; the <strong>Sent By</strong> column shows who transmitted it.</p>
                    <table id="sentInvoiceTable">
                        <thead>
                            <tr>
                                <th>Invoice #</th>
                                <th>Date</th>
                                <th>Due Date</th>
                                <th>Type</th>
                                <th>Total (KES)</th>
                                <th>Status</th>
                                <th>Issued By</th>
                                <th>Sent By</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="sentInvoiceBody"><tr><td colspan="9" style="text-align:center;color:var(--muted-foreground);padding:2rem;">Loading…</td></tr></tbody>
                    </table>
                </div>

                <!-- Invoice List -->
                <div class="invoice-list">
                    <% if (!invoices || invoices.length === 0) { %>
                        <div class="empty-state">
                            <p>No invoices found.</p>
                        </div>
                    <% } else { %>
                        <% invoices.forEach(invoice => { %>
                            <div class="invoice-card" data-status="<%= invoice.status %>">
                                <div class="invoice-info">
                                    <h3>Invoice <%= invoice.invoiceNumber %></h3>
                                    <div class="invoice-meta">
                                        Issued: <%= invoice.issueDate ? new Date(invoice.issueDate).toLocaleDateString() : 'N/A' %> • Due: <%= invoice.dueDate ? new Date(invoice.dueDate).toLocaleDateString() : 'N/A' %>
                                    </div>
                                    <div class="invoice-meta">
                                        Type: <%= invoice.invoiceType ? invoice.invoiceType.replace('_',' ') : 'Other' %> • Items: <%= invoice.items ? invoice.items.length : 0 %>
                                    </div>
                                </div>
                                <div style="text-align:right;">
                                    <div class="invoice-total">KES <%= invoice.totalAmount ? invoice.totalAmount.toLocaleString() : '0' %></div>
                                    <div style="margin:0.5rem 0;">
                                        <span class="status-badge status-<%= invoice.status || 'unknown' %>"><%= invoice.status || 'unknown' %></span>
                                    </div>
                                    <div style="display:flex;flex-wrap:wrap;gap:0.5rem;justify-content:flex-end;margin-top:0.5rem;">
                                        <a href="/api/school/invoices/<%= invoice._id %>/download" class="btn btn-outline btn-sm" target="_blank">Download Receipt</a>
                                        <% if (invoice.status && ['issued','sent','partial','overdue'].includes(invoice.status)) { %>
                                            <button class="btn btn-primary btn-sm pay-invoice-btn" data-invoice-id="<%= invoice._id %>" data-invoice-num="<%= invoice.invoiceNumber %>" data-invoice-balance="<%= ((invoice.totalAmount || 0) - (invoice.amountPaid || 0)).toFixed(2) %>">Pay with M-Pesa</button>
                                            <button class="btn btn-outline btn-sm raise-query-btn" data-invoice-id="<%= invoice._id %>" data-invoice-num="<%= invoice.invoiceNumber %>">Raise Query</button>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
            </div>
        </main>
    </div>

    <!-- Raise Query Modal -->
    <div id="queryModal" class="modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
        <div class="modal-content" style="background:var(--card);padding:2rem;border-radius:var(--radius);max-width:500px;width:90%;">
            <h3>Raise Payment Query</h3>
            <p id="queryInvoiceInfo" style="margin-bottom:1rem;color:var(--muted-foreground);"></p>
            <form id="queryForm">
                <input type="hidden" id="queryInvoiceId">
                <div class="form-group">
                    <label for="querySubject">Subject</label>
                    <input type="text" id="querySubject" name="subject" class="form-input" required placeholder="Payment query for invoice">
                </div>
                <div class="form-group">
                    <label for="queryBody">Message</label>
                    <textarea id="queryBody" name="body" class="form-input" rows="4" required placeholder="Describe your query..."></textarea>
                </div>
                <div class="form-actions" style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:1rem;">
                    <button type="button" class="btn btn-secondary" id="cancelQueryBtn">Cancel</button>
                    <button type="submit" class="btn btn-primary">Submit Query</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="payModal" class="modal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center;">
      <div class="modal-content" style="background:var(--card);padding:2rem;border-radius:var(--radius);max-width:500px;width:90%;">
        <h3>Pay Invoice</h3>
        <p id="payInvoiceInfo" style="margin-bottom:1rem;color:var(--muted-foreground);"></p>
        <form id="payForm">
          <input type="hidden" id="payInvoiceId">
          <div class="form-group">
            <label for="payPhone">Phone Number</label>
            <input type="text" id="payPhone" name="phoneNumber" class="form-input" required placeholder="07XXXXXXXX">
          </div>
          <div class="form-group">
            <label for="payAmount">Amount (KES)</label>
            <input type="text" id="payAmount" name="amount" class="form-input" readonly>
          </div>
          <div class="form-actions" style="display:flex;gap:0.5rem;justify-content:flex-end;margin-top:1rem;">
            <button type="button" class="btn btn-secondary" id="cancelPayBtn">Cancel</button>
            <button type="submit" class="btn btn-primary">Send STK Push</button>
          </div>
        </form>
      </div>
    </div>

    <script nonce="<%= cspNonce %>">
        document.addEventListener('DOMContentLoaded', function() {
            // Filter invoices
            const filterBtns = document.querySelectorAll('.filter-btn');
            const invoiceCards = document.querySelectorAll('.invoice-card');

            filterBtns.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterBtns.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    const filter = btn.dataset.filter;
                    invoiceCards.forEach(card => {
                        if (filter === 'all' || card.dataset.status === filter) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });

            // Raise query modal
            const modal = document.getElementById('queryModal');
            const cancelBtn = document.getElementById('cancelQueryBtn');
            const queryForm = document.getElementById('queryForm');
            const queryInvoiceInfo = document.getElementById('queryInvoiceInfo');

            document.querySelectorAll('.raise-query-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const invoiceId = btn.dataset.invoiceId;
                    const invoiceNum = btn.dataset.invoiceNum;
                    document.getElementById('queryInvoiceId').value = invoiceId;
                    queryInvoiceInfo.textContent = `Invoice: ${invoiceNum}`;
                    modal.style.display = 'flex';
                });
            });

            cancelBtn?.addEventListener('click', () => modal.style.display = 'none');
            window.addEventListener('click', e => { if (e.target === modal) modal.style.display = 'none'; });

            queryForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const invoiceId = document.getElementById('queryInvoiceId').value;
                const subject = document.getElementById('querySubject').value;
                const body = document.getElementById('queryBody').value;

                const res = await fetch(`/api/school/invoices/${invoiceId}/query`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ subject, message: body })
                });
                const result = await res.json();
                if (result.success) {
                    alert('Query submitted successfully');
                    modal.style.display = 'none';
                    queryForm.reset();
                } else {
                    alert('Error: ' + result.error);
                }
            });

            const payModal = document.getElementById('payModal');
            const cancelPayBtn = document.getElementById('cancelPayBtn');
            const payForm = document.getElementById('payForm');
            const payInvoiceInfo = document.getElementById('payInvoiceInfo');
            const payPhone = document.getElementById('payPhone');
            const payAmount = document.getElementById('payAmount');

            document.querySelectorAll('.pay-invoice-btn').forEach(btn => {
                btn.addEventListener('click', () => {
                    const invoiceId = btn.dataset.invoiceId;
                    const invoiceNum = btn.dataset.invoiceNum;
                    const invoiceBalance = btn.dataset.invoiceBalance || '0.00';
                    document.getElementById('payInvoiceId').value = invoiceId;
                    payInvoiceInfo.textContent = `Invoice: ${invoiceNum} — Balance KES ${parseFloat(invoiceBalance).toLocaleString()}`;
                    payAmount.value = invoiceBalance;
                    payPhone.value = <%- JSON.stringify(school.contactPerson?.phone || '') %>;
                    payModal.style.display = 'flex';
                });
            });

            cancelPayBtn?.addEventListener('click', () => payModal.style.display = 'none');

            payForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const invoiceId = document.getElementById('payInvoiceId').value;
                const phone = payPhone.value.trim();

                if (!phone) {
                    alert('Please enter your phone number to receive the STK prompt.');
                    return;
                }

                const res = await fetch(`/api/school/invoices/${invoiceId}/pay`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phoneNumber: phone })
                });
                const result = await res.json();

                if (result.success) {
                    alert(result.message || 'STK push sent. Please approve on your phone.');
                    payModal.style.display = 'none';
                    payForm.reset();
                    window.location.reload();
                } else {
                    alert('Payment error: ' + (result.error || 'Unable to initiate payment.'));
                }
            });

            // Sent invoices toggle state
            window.sentInvoicesLoaded = false;
            window.sentInvoicesVisible = false;
        });

        // Toggle function (called inline via onclick in EJS)
        async function toggleSentInvoices(btn) {
            const section  = document.getElementById('sentSection');
            const btnEl    = document.getElementById('sentToggle');
            const body     = document.getElementById('sentInvoiceBody');

            window.sentInvoicesVisible = !window.sentInvoicesVisible;

            if (!window.sentInvoicesLoaded) {
                body.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--muted-foreground);padding:2rem;">Loading…</td></tr>';
                section.style.display = 'block';

                try {
                    const res = await fetch('/api/school/sent-invoices');
                    const data = await res.json();
                    const invoices = data.invoices || [];

                    if (invoices.length === 0) {
                        body.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--muted-foreground);padding:2rem;">No invoices found.</td></tr>';
                    } else {
                        body.innerHTML = invoices.map(inv => {
                            const issuedName = inv.issuedBy?.name || '—';
                            const sentName   = inv.sentBy?.name   || '—';
                            return `
                                <tr data-status="${inv.status || ''}">
                                    <td><strong>Invoice ${inv.invoiceNumber || '—'}</strong></td>
                                    <td>${inv.issueDate ? new Date(inv.issueDate).toLocaleDateString() : '—'}</td>
                                    <td>${inv.dueDate ? new Date(inv.dueDate).toLocaleDateString() : '—'}</td>
                                    <td>${inv.invoiceType ? inv.invoiceType.replace('_',' ') : '—'}</td>
                                    <td>KES ${inv.totalAmount ? inv.totalAmount.toLocaleString() : '0'}</td>
                                    <td>${inv.status ? '<span class="status-badge status-' + inv.status + '">' + inv.status + '</span>' : '—'}</td>
                                    <td>${issuedName}</td>
                                    <td>${sentName}</td>
                                    <td><a href="/api/school/invoices/${inv._id || ''}/download" class="btn btn-outline btn-sm" target="_blank">Download</a></td>
                                </tr>`;
                        }).join('');
                    }

                    window.sentInvoicesLoaded = true;
                } catch (err) {
                    body.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--danger);padding:2rem;">Failed to load invoices.</td></tr>';
                }
            } else {
                section.style.display = window.sentInvoicesVisible ? 'block' : 'none';
            }

            if (window.sentInvoicesVisible) {
                btnEl.classList.add('active');
                btnEl.querySelector('svg').setAttribute('style','transform:rotate(180deg)');
            } else {
                btnEl.classList.remove('active');
                btnEl.querySelector('svg').removeAttribute('style');
            }
        }
    </script>
</body>
</html>
