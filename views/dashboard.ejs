                    <script nonce="<%= cspNonce %>">
function openSchoolAllocationModal(programId, programName, allocatedSchoolIds) {
  document.getElementById('modalProgramName').textContent = programName;
  document.getElementById('schoolAllocationProgramId').value = programId;
  
  const container = document.getElementById('schoolCheckboxContainer');
  // Clear all checkboxes
  const checkboxes = container.querySelectorAll('input[type="checkbox"]');
  checkboxes.forEach(cb => { cb.checked = false; });

  // Check already allocated schools
  if (allocatedSchoolIds && allocatedSchoolIds.length) {
    checkboxes.forEach(cb => {
      if (allocatedSchoolIds.includes(cb.value)) {
        cb.checked = true;
      }
    });
  }
  
  document.getElementById('schoolAllocationModal').style.display = 'flex';
  document.getElementById('schoolAllocationMessage').style.display = 'none';
}

function closeSchoolAllocationModal() {
  document.getElementById('schoolAllocationModal').style.display = 'none';
}

// Close modal when clicking outside
document.addEventListener('click', function(event) {
  const modal = document.getElementById('schoolAllocationModal');
  if (event.target === modal) {
    closeSchoolAllocationModal();
  }
});

async function saveSchoolAllocation() {
  const programId = document.getElementById('schoolAllocationProgramId').value;
  const container = document.getElementById('schoolCheckboxContainer');
  const checkedBoxes = container.querySelectorAll('input[type="checkbox"]:checked');
  const schoolIds = Array.from(checkedBoxes).map(cb => cb.value);
  
  const messageEl = document.getElementById('schoolAllocationMessage');
  messageEl.style.display = 'none';
  
  try {
    const response = await fetch(`/api/programs/${programId}/update-schools`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ schoolIds })
    });
    const result = await response.json();
    if (response.ok && result.success) {
      messageEl.textContent = '✓ Schools allocated successfully!';
      messageEl.className = 'message success';
      messageEl.style.display = 'block';
      setTimeout(() => {
        closeSchoolAllocationModal();
        window.location.reload();
      }, 1000);
    } else {
      messageEl.textContent = '✗ ' + (result.error || 'Error allocating schools');
      messageEl.className = 'message error';
      messageEl.style.display = 'block';
    }
  } catch (err) {
    console.error('Error allocating schools:', err);
    messageEl.textContent = '✗ Network error';
    messageEl.className = 'message error';
    messageEl.style.display = 'block';
  }
}
