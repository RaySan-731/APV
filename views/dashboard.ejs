                                        <div id="staff-step-indicator-0" style="position: relative; z-index: 1; background: white; padding: 0.5rem 1rem; border-radius: 1rem; font-size: 0.85rem; font-weight: bold; color: var(--primary);">Basic Info</div>
                                        <div id="staff-step-indicator-1" style="position: relative; z-index: 1; background: white; padding: 0.5rem 1rem; border-radius: 1rem; font-size: 0.85rem; font-weight: normal; color: var(--muted-foreground);">Contact</div>
                                        <div id="staff-step-indicator-2" style="position: relative; z-index: 1; background: white; padding: 0.5rem 1rem; border-radius: 1rem; font-size: 0.85rem; font-weight: normal; color: var(--muted-foreground);">Emergency</div>
                                        <div id="staff-step-indicator-3" style="position: relative; z-index: 1; background: white; padding: 0.5rem 1rem; border-radius: 1rem; font-size: 0.85rem; font-weight: normal; color: var(--muted-foreground);">Review</div>
                                    </div>

                                    <div class="form-grid">
