<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Financial Dashboard - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <script src="/js/chart.umd.min.js"></script>
    <style nonce="<%= cspNonce %>">
      .finance-card { border-left: 4px solid #007bff; }
      .finance-card.bg-primary { background-color: #007bff; color: white; }
      .finance-card.bg-success { background-color: #28a745; color: white; }
      .finance-card.bg-warning { background-color: #ffc107; color: black; }
      .finance-card.bg-info { background-color: #17a2b8; color: white; }
      .finance-card.bg-danger { background-color: #dc3545; color: white; }
      .chart-container { position: relative; height: 300px; width: 100%; }
      .alert-budget { border-left: 4px solid #ffc107; }
      .overdue-highlight { background-color: #fff3cd; border: 1px solid #ffeaa7; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../partials/sidebar', { user, page: 'finance/dashboard' }) %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Financial Dashboard</h1>
                <div class="btn-toolbar">
                    <a href="/finance/invoices" class="btn btn-outline-secondary btn-sm">View Invoices</a>
                    <a href="/finance/reports" class="btn btn-outline-primary btn-sm">Reports</a>
                    <a href="/finance/invoices/create" class="btn btn-primary btn-sm ms-2">New Invoice</a>
                </div>
            </header>

            <div class="container-fluid mt-4">
                <!-- Filters -->
                <form method="GET" action="/finance/dashboard" class="row g-3 mb-4">
                    <div class="col-md-3">
                        <select name="dateRange" class="form-select" onchange="this.form.submit()">
                            <option value="week" <%= dateRange === 'week' ? 'selected' : '' %>>Last 7 Days</option>
                            <option value="month" <%= dateRange === 'month' ? 'selected' : '' %>>Last Month</option>
                            <option value="quarter" <%= dateRange === 'quarter' ? 'selected' : '' %>>Last Quarter</option>
                            <option value="year" <%= dateRange === 'year' ? 'selected' : '' %>>Last Year</option>
                            <option value="custom" <%= dateRange === 'custom' ? 'selected' : '' %>>Custom Range</option>
                        </select>
                    </div>
                    <div class="col-md-3" style="<%= dateRange === 'custom' ? '' : 'display:none' %>">
                        <input type="date" name="startDate" class="form-control" value="<%= startDate || '' %>">
                    </div>
                    <div class="col-md-3" style="<%= dateRange === 'custom' ? '' : 'display:none' %>">
                        <input type="date" name="endDate" class="form-control" value="<%= endDate || '' %>">
                    </div>
                    <div class="col-md-3">
                        <select name="schoolId" class="form-select" onchange="this.form.submit()">
                            <option value="">All Schools</option>
                            <% schools.forEach(school => { %>
                                <option value="<%= school._id %>" <%= schoolId === school._id.toString() ? 'selected' : '' %>><%= school.name %></option>
                            <% }); %>
                        </select>
                    </div>
                </form>

                <!-- Key Metrics Cards -->
                <div class="row g-3 mb-4">
                    <div class="col-md-3">
                        <div class="card finance-card bg-primary">
                            <div class="card-body">
                                <h6 class="card-title">Total Revenue</h6>
                                <p class="fs-4 mb-0">KES <%= (summary.totalRevenue || 0).toLocaleString() %></p>
                                <small>Collected: KES <%= (summary.totalCollected || 0).toLocaleString() %></small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card finance-card bg-success">
                            <div class="card-body">
                                <h6 class="card-title">Outstanding</h6>
                                <p class="fs-4 mb-0">KES <%= (summary.outstandingBalance || 0).toLocaleString() %></p>
                                <small><%= summary.invoiceCount || 0 %> invoices</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card finance-card bg-warning">
                            <div class="card-body">
                                <h6 class="card-title">Total Expenses</h6>
                                <p class="fs-4 mb-0">KES <%= (summary.totalExpenses || 0).toLocaleString() %></p>
                                <small><%= summary.expenseCount || 0 %> expenses</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card finance-card <%= (summary.netIncome || 0) >= 0 ? 'bg-info' : 'bg-danger' %>">
                            <div class="card-body">
                                <h6 class="card-title">Net Income</h6>
                                <p class="fs-4 mb-0">KES <%= (summary.netIncome || 0).toLocaleString() %></p>
                                <small><%= (summary.netIncome || 0) >= 0 ? 'Profit' : 'Loss' %></small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Overdue Alert -->
                <% if (summary.overdueAmount > 0) { %>
                <div class="alert alert-danger overdue-highlight mb-4">
                    <h6 class="alert-heading">⚠️ Overdue Payments Alert</h6>
                    <p class="mb-2">KES <%= summary.overdueAmount.toLocaleString() %> outstanding from <%= summary.overdueCount %> overdue invoices</p>
                    <a href="/finance/invoices/overdue" class="alert-link">View Overdue Accounts</a>
                </div>
                <% } %>

                <!-- Charts Row -->
                <div class="row g-3 mb-4">
                    <!-- Revenue vs Expenses Trend -->
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Revenue vs Expenses Trend</h6>
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="revenueExpensesChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Methods -->
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Payment Methods</h6>
                            </div>
                            <div class="card-body">
                                <div class="chart-container">
                                    <canvas id="paymentMethodsChart"></canvas>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bottom Row -->
                <div class="row g-3">
                    <!-- Top Schools by Revenue -->
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">
                                <h6 class="card-title mb-0">Top Schools by Revenue</h6>
                            </div>
                            <div class="card-body">
                                <% if (topSchools && topSchools.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-sm">
                                        <thead>
                                            <tr>
                                                <th>School</th>
                                                <th>Revenue</th>
                                                <th>Collected</th>
                                                <th>Rate</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% topSchools.forEach(school => { %>
                                            <tr>
                                                <td><%= school.schoolName %></td>
                                                <td>KES <%= school.totalRevenue.toLocaleString() %></td>
                                                <td>KES <%= school.totalCollected.toLocaleString() %></td>
                                                <td>
                                                    <span class="badge bg-<%= school.collectionRate >= 80 ? 'success' : school.collectionRate >= 50 ? 'warning' : 'danger' %>">
                                                        <%= school.collectionRate.toFixed(1) %>%
                                                    </span>
                                                </td>
                                            </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                                <% } else { %>
                                <p class="text-muted">No revenue data available for the selected period.</p>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Expense Categories & Budget Alerts -->
                    <div class="col-md-6">
                        <div class="row g-3">
                            <!-- Expense Categories -->
                            <div class="col-12">
                                <div class="card">
                                    <div class="card-header">
                                        <h6 class="card-title mb-0">Expenses by Category</h6>
                                    </div>
                                    <div class="card-body">
                                        <% if (expenseByCategory && expenseByCategory.length > 0) { %>
                                        <div class="chart-container">
                                            <canvas id="expenseCategoriesChart"></canvas>
                                        </div>
                                        <% } else { %>
                                        <p class="text-muted">No expense data available.</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <!-- Budget Alerts -->
                            <% if (budgetAlerts && budgetAlerts.length > 0) { %>
                            <div class="col-12">
                                <div class="card alert-budget">
                                    <div class="card-header">
                                        <h6 class="card-title mb-0">⚠️ Budget Alerts</h6>
                                    </div>
                                    <div class="card-body">
                                        <% budgetAlerts.forEach(alert => { %>
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <div>
                                                <strong><%= alert.name %></strong>
                                                <% if (alert.eventName) { %>
                                                <br><small class="text-muted"><%= alert.eventName %></small>
                                                <% } %>
                                            </div>
                                            <div class="text-end">
                                                <div class="text-danger"><%= alert.usagePercent.toFixed(1) %>% used</div>
                                                <small class="text-muted">KES <%= alert.remaining.toLocaleString() %> remaining</small>
                                            </div>
                                        </div>
                                        <% }); %>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
        // Revenue vs Expenses Trend Chart
        const revenueExpensesCanvas = document.getElementById('revenueExpensesChart');
        const monthlyTrend = <%- JSON.stringify(monthlyTrend || []) %>;

        if (revenueExpensesCanvas) {
            const revenueExpensesCtx = revenueExpensesCanvas.getContext('2d');
            new Chart(revenueExpensesCtx, {
                type: 'line',
                data: {
                    labels: monthlyTrend.map(item => {
                        const date = new Date(item.month + '-01');
                        return date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
                    }),
                    datasets: [{
                        label: 'Revenue',
                        data: monthlyTrend.map(item => item.revenue),
                        borderColor: '#28a745',
                        backgroundColor: 'rgba(40, 167, 69, 0.1)',
                        tension: 0.4
                    }, {
                        label: 'Expenses',
                        data: monthlyTrend.map(item => item.expenses),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        tension: 0.4
                    }, {
                        label: 'Net Income',
                        data: monthlyTrend.map(item => item.netIncome),
                        borderColor: '#007bff',
                        backgroundColor: 'rgba(0, 123, 255, 0.1)',
                        tension: 0.4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'KES ' + value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return context.dataset.label + ': KES ' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        // Payment Methods Chart
        const paymentMethodsCanvas = document.getElementById('paymentMethodsChart');
        const paymentMethods = <%- JSON.stringify(paymentMethods || []) %>;

        if (paymentMethodsCanvas) {
            const paymentMethodsCtx = paymentMethodsCanvas.getContext('2d');
            new Chart(paymentMethodsCtx, {
                type: 'doughnut',
                data: {
                    labels: paymentMethods.map(method => method._id.replace('_', ' ').toUpperCase()),
                    datasets: [{
                        data: paymentMethods.map(method => method.totalAmount),
                        backgroundColor: [
                            '#007bff', '#28a745', '#ffc107', '#dc3545', '#6f42c1', '#17a2b8'
                        ]
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const total = context.dataset.data.reduce((a, b) => a + b, 0);
                                    const percentage = ((context.parsed / total) * 100).toFixed(1);
                                    return context.label + ': KES ' + context.parsed.toLocaleString() + ' (' + percentage + '%)';
                                }
                            }
                        }
                    }
                }
            });
        }

        // Expense Categories Chart
        const expenseCategoriesCanvas = document.getElementById('expenseCategoriesChart');
        const expenseByCategory = <%- JSON.stringify(expenseByCategory || []) %>;

        if (expenseCategoriesCanvas) {
            const expenseCategoriesCtx = expenseCategoriesCanvas.getContext('2d');
            new Chart(expenseCategoriesCtx, {
                type: 'bar',
                data: {
                    labels: expenseByCategory.map(cat => cat._id.replace('_', ' ').toUpperCase()),
                    datasets: [{
                        label: 'Amount',
                        data: expenseByCategory.map(cat => cat.totalAmount),
                        backgroundColor: '#ffc107',
                        borderColor: '#e0a800',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: function(value) {
                                    return 'KES ' + value.toLocaleString();
                                }
                            }
                        }
                    },
                    plugins: {
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    return 'KES ' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    }
                }
            });
        }

        document.querySelector('select[name="dateRange"]').addEventListener('change', function() {
            const custom = this.value === 'custom';
            document.getElementById('startDateDiv').style.display = custom ? 'block' : 'none';
            document.getElementById('endDateDiv').style.display = custom ? 'block' : 'none';
        });

        document.getElementById('mobileSidebarToggle').addEventListener('click', function() {
            document.getElementById('sidebar').classList.toggle('active');
        });
    </script>

    <script src="/js/main.js"></script>
</body>
</html>
