<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= event.name %> - Trainer Portal - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="icon" href="/favicon.ico" />
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <span>APV Trainer Portal</span>
                </div>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section">
                    <ul class="nav-list">
                        <li class="nav-item"><a href="/trainer/dashboard" class="nav-link">Home</a></li>
                        <li class="nav-item"><a href="/trainer/schools" class="nav-link">My Schools</a></li>
                        <li class="nav-item"><a href="/trainer/students" class="nav-link">Students</a></li>
                        <li class="nav-item"><a href="/trainer/events" class="nav-link active">Events</a></li>
                        <li class="nav-item"><a href="/trainer/profile" class="nav-link">My Profile</a></li>
                    </ul>
                </div>
            </nav>
            <div class="sidebar-footer">
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="dashboard-header">
                <div style="display: flex; align-items: center; gap: 1rem;">
                    <a href="/trainer/events" class="btn btn-outline" style="text-decoration: none;">← Back to Events</a>
                    <h1><%= event.name %></h1>
                </div>
                <div class="user-info" style="display: flex; align-items: center; gap: 1rem;">
                    <div class="notification-bell" id="notificationBell" style="position: relative; cursor: pointer;">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span class="badge badge-danger" id="notificationBadge" style="position: absolute; top: -5px; right: -5px; display: none;">0</span>
                    </div>
                    <span>Welcome, <%= user.name %></span>
                </div>
            </header>

            <section class="dashboard-content">
                <!-- Notification Panel -->
                <div id="notificationPanel" class="notification-panel">
                    <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border); background: var(--card); position: sticky; top: 0; z-index: 1;">
                        <div style="display: flex; gap: 1rem;">
                            <button class="panel-tab active" data-tab="notifications">Notifications</button>
                            <button class="panel-tab" data-tab="messages">Messages</button>
                            <button class="panel-tab" data-tab="announcements">Announcements</button>
                        </div>
                        <div style="display: flex; gap: 0.5rem;">
                            <button id="markAllReadBtn" class="btn btn-sm btn-outline" style="border: none; background: transparent;">Mark all read</button>
                            <button id="closeNotificationPanel" class="btn btn-sm btn-outline" style="border: none; font-size: 1.2rem; line-height: 1; padding: 0.25rem 0.5rem;">&times;</button>
                        </div>
                    </div>
                    <div id="notificationPanelList" style="max-height: calc(100vh - 8rem); overflow-y: auto; padding: 0.5rem;"></div>
                </div>

                <!-- Accept/Decline Confirmation Modal -->
                <div id="confirmModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
                    <div class="modal-content" style="background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow-card); width: 100%; max-width: 500px; margin: 2rem;">
                        <div class="card-header" style="padding: 1.5rem; border-bottom: 1px solid var(--border);">
                            <h3 id="confirmModalTitle" style="margin: 0;">Confirm Action</h3>
                        </div>
                        <div class="card-content" style="padding: 1.5rem;">
                            <p id="confirmModalMessage">Are you sure?</p>
                            <div id="declineReasonContainer" style="display: none; margin-top: 1rem;">
                                <label>Reason (optional):</label>
                                <textarea id="declineReason" rows="3" style="width: 100%; padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius);"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer" style="padding: 1rem 1.5rem; border-top: 1px solid var(--border); display: flex; gap: 0.5rem; justify-content: flex-end;">
                            <button class="btn btn-secondary" onclick="closeConfirmModal()">Cancel</button>
                            <button class="btn btn-primary" id="confirmModalBtn">Confirm</button>
                        </div>
                    </div>
                </div>

                <!-- Trainer Assignment Status (computed server-side) -->
                <% 
                    // Find the current trainer's assignment in this event
                     // staffId is passed from server (current staff's _id)
                     const trainersList = event.trainers || [];
                     const myAssignment = trainersList.find(t => {
                         if (!t.trainerId) return false;
                         const trainerId = t.trainerId._id ? t.trainerId._id.toString() : t.trainerId.toString();
                         return trainerId === staffId;
                     });
                    const assignmentStatus = myAssignment ? myAssignment.status : 'not_assigned';
                    const needsResponse = assignmentStatus === 'assigned' && ['scheduled', 'published', 'draft'].includes(event.status);
                 %>

                  <%
                      // === Server-side EJS helpers (duplicated from client JS for template rendering) ===
                      function formatEventType(type) {
                          const types = { 'camp': 'Camp', 'hike': 'Hike', 'team_building': 'Team Building', 'training_session': 'Training Session', 'inter_school_competition': 'Inter-School Competition', 'other': 'Other' };
                          return types[type] || type || 'Event';
                      }
                      function formatStatus(status) {
                          return status ? status.replace('_', ' ') : '';
                      }
                      function getStatusBadgeClass(status) {
                          const map = { 'draft': 'badge-secondary', 'scheduled': 'badge-accent', 'published': 'badge-primary', 'confirmed': 'badge-success', 'in_progress': 'badge-warning', 'completed': 'badge-success', 'reviewed': 'badge-primary', 'cancelled': 'badge-danger', 'archived': 'badge-secondary' };
                          return map[status] || 'badge-secondary';
                      }
                      function getEventTypeBadgeClass(type) {
                          const map = { 'camp': 'badge-primary', 'hike': 'badge-success', 'team_building': 'badge-accent', 'training_session': 'badge-secondary', 'inter_school_competition': 'badge-warning', 'other': 'badge-secondary' };
                          return map[type] || 'badge-secondary';
                      }
                      function formatRole(role) {
                          const roles = { 'lead_trainer': 'Lead Trainer', 'assistant_trainer': 'Assistant Trainer', 'coordinator': 'Coordinator', 'volunteer': 'Volunteer' };
                          return roles[role] || role || '';
                      }
                      function formatAssignmentStatus(status) {
                          return status ? status.replace('_', ' ') : '';
                      }
                      function getAssignmentStatusBadge(status) {
                          const map = { 'assigned': 'badge-warning', 'confirmed': 'badge-success', 'declined': 'badge-danger', 'removed': 'badge-danger' };
                          return map[status] || 'badge-secondary';
                      }
                      function formatRsvpStatus(status) {
                          return status ? status.replace('_', ' ') : '';
                      }
                      function getRsvpStatusBadge(status) {
                          const map = { 'invited': 'badge-secondary', 'confirmed': 'badge-success', 'declined': 'badge-danger', 'pending': 'badge-warning', 'no_response': 'badge-secondary' };
                          return map[status] || 'badge-secondary';
                      }
                      function getReviewStatusBadge(status) {
                          const map = { 'pending': 'badge-warning', 'approved': 'badge-success', 'needs_revision': 'badge-accent', 'rejected': 'badge-danger' };
                          return map[status] || 'badge-secondary';
                      }
                      function formatReviewStatus(status) {
                          return status ? status.replace('_', ' ') : '';
                      }
                  %>

                 <% if (needsResponse) { %>
                <!-- Assignment Action Buttons -->
                <div id="assignmentActions" style="margin-bottom: 1.5rem;">
                    <div class="content-card" style="border-left: 4px solid var(--warning);">
                        <div class="card-content">
                            <p><strong>Action Required:</strong> You have been assigned to this event. Please confirm your availability.</p>
                            <div style="display: flex; gap: 1rem; margin-top: 1rem;">
                                <button class="btn btn-success" onclick="confirmAccept()">✅ Accept Assignment</button>
                                <button class="btn btn-danger" onclick="confirmDecline()">❌ Decline Assignment</button>
                            </div>
                        </div>
                    </div>
                </div>
                <% } %>

                <!-- Event Details -->
                <div class="content-card" style="margin-bottom: 1.5rem;">
                    <div class="card-header">
                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                            <div>
                                <span class="badge <%= getEventTypeBadgeClass(event.eventType) %>" style="font-size: 0.875rem; margin-bottom: 0.5rem;"><%= formatEventType(event.eventType) %></span>
                                <h2 style="margin: 0;"><%= event.name %></h2>
                            </div>
                            <div style="text-align: right;">
                                <div><span class="badge <%= getStatusBadgeClass(event.status) %>" style="font-size: 1rem;"><%= formatStatus(event.status) %></span></div>
                                <% if (event.review?.reportSubmittedAt) { %>
                                    <div style="margin-top: 0.5rem;"><small>Report submitted: <%= new Date(event.review.reportSubmittedAt).toLocaleDateString() %></small></div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="card-content">
                        <% if (event.description) { %>
                            <p style="font-size: 1.1rem; color: var(--muted-foreground); margin-bottom: 1.5rem;"><%= event.description %></p>
                        <% } %>

                        <!-- Quick Info Grid -->
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; padding: 1rem; background: var(--muted); border-radius: var(--radius);">
                            <div>
                                <strong>📅 Date & Time</strong><br>
                                <%= new Date(event.startDate).toLocaleDateString('en-US', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %> at
                                <%= new Date(event.startDate).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %> -
                                <%= new Date(event.endDate).toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' }) %>
                            </div>
                            <div>
                                <strong>📍 Location</strong><br>
                                <%= event.location?.name || 'TBD' %><br>
                                <% if (event.location?.address) { %>
                                    <%= event.location.address %><br>
                                <% } %>
                                <% if (event.location?.city) { %>
                                    <%= event.location.city %>, <%= event.location?.region || '' %> <%= event.location?.country || '' %>
                                <% } %>
                                <% if (event.location?.coordinates) { %>
                                    <br><a href="https://www.google.com/maps?q=<%= event.location.coordinates.latitude %>,<%= event.location.coordinates.longitude %>" target="_blank">View on Map</a>
                                <% } %>
                            </div>
                            <div>
                                <strong>👥 Capacity</strong><br>
                                Max: <%= event.maxParticipants %> participants<br>
                                Estimated Scouts: <%= event.estimatedScoutCount || 0 %>
                            </div>
                            <div>
                                <strong>💰 Budget</strong><br>
                                Total: KES <%= event.budget?.total?.toLocaleString() || 0 %><br>
                                Cost per participant: KES <%= event.costPerParticipant?.toLocaleString() || 0 %>
                            </div>
                        </div>

                        <!-- Agenda -->
                        <% if (event.agenda) { %>
                            <div class="content-card" style="margin: 1rem 0;">
                                <div class="card-header"><h3>Agenda</h3></div>
                                <div class="card-content">
                                    <div style="white-space: pre-line;"><%= event.agenda %></div>
                                </div>
                            </div>
                        <% } %>

                        <!-- Required Equipment -->
                        <% if (event.requiredEquipment && event.requiredEquipment.length > 0) { %>
                            <div class="content-card" style="margin: 1rem 0;">
                                <div class="card-header"><h3>Required Equipment</h3></div>
                                <div class="card-content">
                                    <ul style="list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 0.5rem;">
                                        <% event.requiredEquipment.forEach(eq => { %>
                                            <li style="padding: 0.5rem; border: 1px solid var(--border); border-radius: var(--radius); display: flex; justify-content: space-between; align-items: center;">
                                                <span><%= eq.item %> <small style="color: var(--muted-foreground);">(x<%= eq.quantity %>)</small></span>
                                                <span class="badge badge-secondary"><%= eq.providedBy || 'APV' %></span>
                                            </li>
                                        <% }); %>
                                    </ul>
                                </div>
                            </div>
                        <% } %>

                        <!-- Prerequisites -->
                        <% if (event.prerequisites && event.prerequisites.length > 0) { %>
                            <div class="content-card" style="margin: 1rem 0;">
                                <div class="card-header"><h3>Prerequisites</h3></div>
                                <div class="card-content">
                                    <ul>
                                        <% event.prerequisites.forEach(pr => { %>
                                            <li style="margin-bottom: 0.5rem;">
                                                <%= pr.description %>
                                                <% if (pr.mandatory) { %>
                                                    <span class="badge badge-danger" style="margin-left: 0.5rem;">Mandatory</span>
                                                <% } %>
                                            </li>
                                        <% }); %>
                                    </ul>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Trainer Assignments -->
                <div class="content-card" style="margin-bottom: 1.5rem;">
                    <div class="card-header"><h3>Training Team</h3></div>
                    <div class="card-content">
                        <% if (event.trainers && event.trainers.length > 0) { %>
                            <div style="display: grid; gap: 0.75rem;">
                                <% event.trainers.forEach(t => { %>
                                    <div style="padding: 0.75rem; border: 1px solid var(--border); border-radius: var(--radius); display: flex; justify-content: space-between; align-items: center;">
                                        <div>
                                            <strong><%= t.trainerId?.name || 'Unknown Trainer' %></strong>
                                            <div style="font-size: 0.875rem; color: var(--muted-foreground);">
                                                <%= formatRole(t.role) %> |
                                                Status: <span class="badge <%= getAssignmentStatusBadge(t.status) %>"><%= formatAssignmentStatus(t.status) %></span>
                                                <% if (t.notes) { %>
                                                    <br><em>"<%= t.notes %>"</em>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <p class="placeholder-text">No other trainers assigned yet.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Schools & RSVPs -->
                <div class="content-card" style="margin-bottom: 1.5rem;">
                    <div class="card-header"><h3>Invited Schools</h3></div>
                    <div class="card-content">
                        <% if (event.targetSchools && event.targetSchools.length > 0) { %>
                            <div class="table-responsive">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>School</th>
                                        <th>Contact</th>
                                        <th>RSVP Status</th>
                                        <th>Registered</th>
                                        <th>Attended</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% event.targetSchools.forEach(s => { %>
                                        <tr>
                                            <td>
                                                <strong><%= s.schoolId?.name || 'Unknown School' %></strong><br>
                                                <small><%= s.schoolId?.city || '' %>, <%= s.schoolId?.region || '' %></small>
                                            </td>
                                            <td>
                                                <%= s.schoolId?.contactPerson || '—' %><br>
                                                <small><%= s.schoolId?.contactEmail || '' %></small>
                                            </td>
                                            <td><span class="badge <%= getRsvpStatusBadge(s.rsvpStatus) %>"><%= formatRsvpStatus(s.rsvpStatus) %></span></td>
                                            <td><%= s.attendance?.registered || 0 %></td>
                                            <td><%= s.attendance?.attended || 0 %></td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                                </div>
                        <% } else { %>
                            <p class="placeholder-text">No schools invited yet.</p>
                        <% } %>
                    </div>
                </div>

                <!-- Report Section -->
                <% if (event.status === 'completed') { %>
                    <div class="content-card" style="margin-bottom: 1.5rem;">
                        <div class="card-header">
                            <h3>Post-Event Wrap-Up Report</h3>
                            <% if (!event.review?.reportSubmittedAt) { %>
                                <span class="badge badge-warning">Action Required</span>
                            <% } %>
                        </div>
                        <div class="card-content">
                            <% if (event.review?.reportSubmittedAt) { %>
                                <div style="margin-bottom: 1rem; padding: 1rem; background: var(--muted); border-radius: var(--radius);">
                                    <p><strong>Submitted:</strong> <%= new Date(event.review.reportSubmittedAt).toLocaleString() %></p>
                                    <p><strong>Actual Attendees:</strong> <%= event.review.actualAttendeeCount ?? 'Not recorded' %>
                                        <% if (event.review.registeredAttendeeCount != null) { %> / <%= event.review.registeredAttendeeCount %> registered <% } %>
                                    </p>
                                </div>

                                <% if (event.review.activitySessions?.length) { %>
                                <div style="margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <h4>Activity Summary</h4>
                                    <ul style="margin: 0.5rem 0; padding-left: 1.25rem;">
                                    <% event.review.activitySessions.forEach(s => { %>
                                        <li><%= s.name %> <small>(<%= s.durationMinutes ?? 0 %> min, participation: <%= s.participationLevel ?? 'N/A' %>)</small><% if (s.description) { %> — <%= s.description %><% } %></li>
                                    <% }); %>
                                    </ul>
                                    <% if (event.review.newToolsUsed || event.review.newMethodsUsed) { %>
                                        <p><strong>New Tools/Methods Used:</strong>
                                            <% const parts2=[]; if (event.review.newToolsUsed) parts2.push(event.review.newToolsUsed); if (event.review.newMethodsUsed) parts2.push(event.review.newMethodsUsed); %>
                                            <%= parts2.join(' / ') %>
                                        </p>
                                    <% } %>
                                </div>
                                <% } %>

                                <% if (event.review.skillsGained?.length || event.review.notableAchievements) { %>
                                <div style="margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <h4>Outcomes &amp; Impact</h4>
                                    <% if (event.review.scoutEngagement) { %><p><strong>Scout Engagement:</strong> <span class="badge <%= event.review.scoutEngagement==='High'?'badge-success':event.review.scoutEngagement==='Low'?'badge-danger':'badge-warning' %>"><%= event.review.scoutEngagement %></span></p><% } %>
                                    <% if (event.review.skillsGained?.length) { %><p><strong>Skills Gained:</strong> <%= event.review.skillsGained.join(', ') %></p><% } %>
                                    <% if (event.review.notableAchievements) { %><p><strong>Achievements:</strong> <%= event.review.notableAchievements %></p><% } %>
                                </div>
                                <% } %>

                                <% if (event.review.logisticalIssues || event.review.behavioralIssues || event.review.suggestionsForImprovement) { %>
                                <div style="margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <h4>Challenges &amp; Issues</h4>
                                    <% if (event.review.logisticalIssues) { %><p><strong>Logistical:</strong> <%= event.review.logisticalIssues %></p><% } %>
                                    <% if (event.review.behavioralIssues) { %><p><strong>Behavioral:</strong> <%= event.review.behavioralIssues %></p><% } %>
                                    <% if (event.review.suggestionsForImprovement) { %><p><strong>Suggestions:</strong> <%= event.review.suggestionsForImprovement %></p><% } %>
                                </div>
                                <% } %>

                                <% if (event.review.satisfactionRatings) { %>
                                <div style="margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <h4>Satisfaction Ratings</h4>
                                    <p><strong>Trainer Satisfaction:</strong> <%= '&#9733;'.repeat(event.review.satisfactionRatings.trainerSatisfaction || 0) + '&#9734;'.repeat(5 - (event.review.satisfactionRatings.trainerSatisfaction || 0)) %> (<%= event.review.satisfactionRatings.trainerSatisfaction || 0 %>/5)</p>
                                    <p><strong>Scout Satisfaction:</strong> <%= '&#9733;'.repeat(event.review.satisfactionRatings.scoutSatisfaction || 0) + '&#9734;'.repeat(5 - (event.review.satisfactionRatings.scoutSatisfaction || 0)) %> (<%= event.review.satisfactionRatings.scoutSatisfaction || 0 %>/5)</p>
                                </div>
                                <% } %>

                                <% if (event.review.recommendedNextTraining || event.review.scoutsNeedingSupport || event.review.adminTasks) { %>
                                <div style="margin-bottom: 1rem; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius);">
                                    <h4>Follow-Up Actions</h4>
                                    <% if (event.review.recommendedNextTraining) { %><p><strong>Recommended Next Training:</strong> <%= event.review.recommendedNextTraining %></p><% } %>
                                    <% if (event.review.scoutsNeedingSupport) { %><p><strong>Scouts Needing Support:</strong> <%= event.review.scoutsNeedingSupport %></p><% } %>
                                    <% if (event.review.adminTasks) { %><p><strong>Admin Tasks:</strong> <%= event.review.adminTasks %></p><% } %>
                                </div>
                                <% } %>

                                <div style="margin-bottom: 1rem; padding: 1rem; background: var(--muted); border-radius: var(--radius);">
                                    <h4>Event Report</h4>
                                    <div style="white-space: pre-line;"><%= event.review.trainerReport %></div>
                                </div>

                                <% if (event.review.reviewStatus) { %>
                                    <div style="padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); margin-top: 1rem;">
                                        <h4>Admin Review</h4>
                                        <p><strong>Status:</strong> <span class="badge <%= getReviewStatusBadge(event.review.reviewStatus) %>"><%= formatReviewStatus(event.review.reviewStatus) %></span></p>
                                        <% if (event.review.reviewNotes) { %>
                                            <p><strong>Feedback:</strong> <%= event.review.reviewNotes %></p>
                                        <% } %>
                                        <% if (event.review.reviewedBy) { %>
                                            <p><small>Reviewed by: <%= event.review.reviewedBy.name || 'Admin' %> on <%= new Date(event.review.reviewedAt).toLocaleDateString() %></small></p>
                                        <% } %>
                                    </div>
                                <% } %>
                            <% } else { %>
                                <form id="reportForm" onsubmit="submitReport(event)">
                                    <!-- Event Overview (auto-populated display) -->
                                    <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--muted); border-radius: var(--radius); font-size: 0.9rem;">
                                        <h4 style="margin-top: 0;">Event Overview</h4>
                                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.75rem;">
                                            <div><strong>Event:</strong> <%= event.name %></div>
                                            <div><strong>Date:</strong> <%= new Date(event.startDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></div>
                                            <div><strong>Location:</strong> <%= event.location?.name || 'TBD' %></div>
                                            <div><strong>Registered:</strong> <span id="summaryRegistered">0</span></div>
                                            <div><strong>Trainers:</strong> <%= event.trainers?.length || 0 %></div>
                                        </div>
                                    </div>

                                    <!-- 1. Attendance -->
                                    <fieldset style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight: 600; padding: 0 0.5rem;">1. Attendance</legend>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                            <div>
                                                <label for="registeredAttendeeCount" style="display:block; margin-bottom:0.35rem; font-weight:500;">Registered Attendees</label>
                                                <input type="number" id="registeredAttendeeCount" name="registeredAttendeeCount" min="0" placeholder="e.g. 50"
                                                       style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                            </div>
                                            <div>
                                                <label for="actualAttendeeCount" style="display:block; margin-bottom:0.35rem; font-weight:500;">Actual Attendees</label>
                                                <input type="number" id="actualAttendeeCount" name="actualAttendeeCount" min="0" required
                                                       style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                            </div>
                                        </div>
                                    </fieldset>

                                    <!-- 2. Activity Summary -->
                                    <fieldset style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight: 600; padding: 0 0.5rem;">2. Activity Summary</legend>
                                        <div style="margin-bottom: 1rem;">
                                            <label style="display:block; margin-bottom:0.35rem; font-weight:500;">Sessions / Activities Conducted</label>
                                            <div id="sessionList">
                                                <div class="session-row" style="display:grid; grid-template-columns: 1fr 2fr 80px 120px; gap:0.5rem; align-items:end; margin-bottom:0.5rem;">
                                                    <div>
                                                        <label style="font-size:0.85rem;">Session Name</label>
                                                        <input type="text" name="sessionName_0" placeholder="e.g. Leadership Drill"
                                                               style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                                    </div>
                                                    <div>
                                                        <label style="font-size:0.85rem;">Description</label>
                                                        <input type="text" name="sessionDesc_0" placeholder="Brief description"
                                                               style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                                    </div>
                                                    <div>
                                                        <label style="font-size:0.85rem;">Duration (min)</label>
                                                        <input type="number" name="sessionDuration_0" min="0" placeholder="60"
                                                               style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                                    </div>
                                                    <div>
                                                        <label style="font-size:0.85rem;">Participation</label>
                                                        <select name="sessionParticipation_0"
                                                                style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                                            <option value="high">High</option>
                                                            <option value="medium" selected>Medium</option>
                                                            <option value="low">Low</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-secondary" id="addSessionBtn" style="margin-top:0.5rem;">+ Add Session</button>
                                        </div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                            <div>
                                                <label for="newToolsUsed" style="display:block; margin-bottom:0.35rem; font-weight:500;">New Tools / Equipment Used</label>
                                                <input type="text" id="newToolsUsed" name="newToolsUsed" placeholder="e.g. Portable PA system, climbing gear"
                                                       style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                            </div>
                                            <div>
                                                <label for="newMethodsUsed" style="display:block; margin-bottom:0.35rem; font-weight:500;">New Methods Used</label>
                                                <input type="text" id="newMethodsUsed" name="newMethodsUsed" placeholder="e.g. Peer-led facilitation"
                                                       style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                            </div>
                                        </div>
                                    </fieldset>

                                    <!-- 3. Outcomes & Impact -->
                                    <fieldset style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight: 600; padding: 0 0.5rem;">3. Outcomes &amp; Impact</legend>
                                        <div style="margin-bottom: 1rem;">
                                            <label style="display:block; margin-bottom:0.35rem; font-weight:500;">Scout Engagement Level</label>
                                            <select name="scoutEngagement"
                                                    style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%; max-width:300px;">
                                                <option value="High">High</option>
                                                <option value="Medium" selected>Medium</option>
                                                <option value="Low">Low</option>
                                            </select>
                                        </div>
                                        <div style="margin-bottom: 1rem;">
                                            <label style="display:block; margin-bottom:0.35rem; font-weight:500;">Skills Gained / Reinforced <small>(comma-separated)</small></label>
                                            <input type="text" name="skillsGained" placeholder="e.g. Leadership, Teamwork, Discipline, Navigation"
                                                   style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                        </div>
                                        <div>
                                            <label for="notableAchievements" style="display:block; margin-bottom:0.35rem; font-weight:500;">Notable Achievements</label>
                                            <textarea id="notableAchievements" name="notableAchievements" rows="3"
                                                      placeholder="Badges earned, competitions won, milestones reached..."
                                                      style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;"></textarea>
                                        </div>
                                    </fieldset>

                                    <!-- 4. Challenges & Issues -->
                                    <fieldset style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight: 600; padding: 0 0.5rem;">4. Challenges &amp; Issues</legend>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                            <div>
                                                <label for="logisticalIssues" style="display:block; margin-bottom:0.35rem; font-weight:500;">Logistical Issues</label>
                                                <textarea id="logisticalIssues" name="logisticalIssues" rows="3"
                                                          placeholder="Venue, equipment, timing problems..."
                                                          style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;"></textarea>
                                            </div>
                                            <div>
                                                <label for="behavioralIssues" style="display:block; margin-bottom:0.35rem; font-weight:500;">Behavioral / Participation Concerns</label>
                                                <textarea id="behavioralIssues" name="behavioralIssues" rows="3"
                                                          placeholder="Any notable concerns..."
                                                          style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;"></textarea>
                                            </div>
                                        </div>
                                        <div style="margin-top: 1rem;">
                                            <label for="suggestionsForImprovement" style="display:block; margin-bottom:0.35rem; font-weight:500;">Suggestions for Improvement</label>
                                            <textarea id="suggestionsForImprovement" name="suggestionsForImprovement" rows="3"
                                                      placeholder="How can future events be improved?"
                                                      style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;"></textarea>
                                        </div>
                                    </fieldset>

                                    <!-- 5. Satisfaction Ratings -->
                                    <fieldset style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight: 600; padding: 0 0.5rem;">5. Satisfaction Ratings</legend>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                                            <div>
                                                <label style="display:block; margin-bottom:0.35rem; font-weight:500;">How satisfied were you with this event?</label>
                                                <div class="star-rating" id="trainerSatisfaction" data-value="3" style="font-size:1.5rem; cursor:pointer; color:var(--muted); letter-spacing:0.25rem;">
                                                    <span data-val="1">&#9733;</span>
                                                    <span data-val="2">&#9733;</span>
                                                    <span data-val="3">&#9733;</span>
                                                    <span data-val="4">&#9734;</span>
                                                    <span data-val="5">&#9734;</span>
                                                </div>
                                                <input type="hidden" name="trainerSatisfaction" id="trainerSatisfactionInput" value="3">
                                            </div>
                                            <div>
                                                <label style="display:block; margin-bottom:0.35rem; font-weight:500;">How satisfied were the scouts?</label>
                                                <div class="star-rating" id="scoutSatisfaction" data-value="3" style="font-size:1.5rem; cursor:pointer; color:var(--muted); letter-spacing:0.25rem;">
                                                    <span data-val="1">&#9733;</span>
                                                    <span data-val="2">&#9733;</span>
                                                    <span data-val="3">&#9733;</span>
                                                    <span data-val="4">&#9734;</span>
                                                    <span data-val="5">&#9734;</span>
                                                </div>
                                                <input type="hidden" name="scoutSatisfaction" id="scoutSatisfactionInput" value="3">
                                            </div>
                                        </div>
                                    </fieldset>

                                    <!-- 6. Follow-Up Actions (Optional) -->
                                    <fieldset style="border: 1px dashed var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight:600; padding:0 0.5rem; color:var(--muted-foreground);">6. Follow-Up Actions <small>(Optional)</small></legend>
                                        <div class="form-grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
                                            <div>
                                                <label for="recommendedNextTraining" style="display:block; margin-bottom:0.35rem; font-weight:500;">Recommended Next Training</label>
                                                <input type="text" id="recommendedNextTraining" name="recommendedNextTraining"
                                                       placeholder="e.g. Advanced Navigation Camp"
                                                       style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                            </div>
                                            <div>
                                                <label for="adminTasks" style="display:block; margin-bottom:0.35rem; font-weight:500;">Admin Tasks Needed</label>
                                                <input type="text" id="adminTasks" name="adminTasks"
                                                       placeholder="e.g. Issue certificates, process payments"
                                                       style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                                            </div>
                                        </div>
                                        <div style="margin-top:1rem;">
                                            <label for="scoutsNeedingSupport" style="display:block; margin-bottom:0.35rem; font-weight:500;">Scouts Needing Extra Support / Mentoring</label>
                                            <textarea id="scoutsNeedingSupport" name="scoutsNeedingSupport" rows="3"
                                                      placeholder="List any scouts flagged for follow-up mentoring or extra support..."
                                                      style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;"></textarea>
                                        </div>
                                    </fieldset>

                                    <!-- 7. General Event Report Narrative -->
                                    <fieldset style="border: 1px solid var(--border); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem;">
                                        <legend style="font-weight: 600; padding: 0 0.5rem;">7. General Event Report</legend>
                                        <div>
                                            <label for="trainerReport" style="display:block; margin-bottom:0.35rem; font-weight:500;">Event Report</label>
                                            <textarea id="trainerReport" name="trainerReport" rows="6" required
                                                      placeholder="Summarise the overall event — highlights, observations, closing remarks..."
                                                      style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;"></textarea>
                                        </div>
                                    </fieldset>

                                    <button type="submit" class="btn btn-primary" id="submitReportBtn">Submit Wrap-Up Report</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>

                <!-- Admin Notes (if any) -->
                <% if (event.adminNotes) { %>
                    <div class="content-card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--accent);">
                        <div class="card-header"><h3>Admin Notes</h3></div>
                        <div class="card-content">
                            <div style="white-space: pre-line;"><%= event.adminNotes %></div>
                        </div>
                    </div>
                <% } %>
            </section>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
        // Trainer detail page specific JS
        let currentEventId = '<%= event._id %>';
        let myTrainerAssignment = null;

        // Find the current trainer's assignment status
        const eventData = <%- JSON.stringify(event) %>;
        // We'll derive from event.trainers which has trainerId objects

        function confirmAccept() {
            showConfirmModal('Accept Event', 'Are you sure you want to accept this event assignment?', false, async () => {
                await submitResponse('accept');
            });
        }

        function confirmDecline() {
            showConfirmModal('Decline Event', 'Are you sure you want to decline this event assignment? Please provide a reason (optional).', true, async (reason) => {
                await submitResponse('decline', reason);
            });
        }

        function showConfirmModal(title, message, needsReason, onConfirm) {
            const modal = document.getElementById('confirmModal');
            document.getElementById('confirmModalTitle').textContent = title;
            document.getElementById('confirmModalMessage').textContent = message;
            const reasonContainer = document.getElementById('declineReasonContainer');
            reasonContainer.style.display = needsReason ? 'block' : 'none';
            document.getElementById('declineReason').value = '';
            modal.style.display = 'flex';

            document.getElementById('confirmModalBtn').onclick = async () => {
                const reason = needsReason ? document.getElementById('declineReason').value.trim() : null;
                closeConfirmModal();
                await onConfirm(reason);
            };
        }

        function closeConfirmModal() {
            document.getElementById('confirmModal').style.display = 'none';
        }

        async function submitResponse(action, reason = null) {
            try {
                const url = `/trainer/events/${currentEventId}/${action}`;
                const options = { method: 'POST', headers: { 'Content-Type': 'application/json' } };
                if (action === 'decline' && reason !== undefined) {
                    options.body = JSON.stringify({ reason });
                }

                const response = await fetch(url, options);
                const data = await response.json();

                if (data.success) {
                    alert(`Event ${action === 'accept' ? 'accepted' : 'declined'} successfully!`);
                    window.location.reload();
                } else {
                    alert(`Error: ${data.error}`);
                }
            } catch (err) {
                console.error('Error:', err);
                alert('Connection error');
            }
        }

        async function submitReport(e) {
            e.preventDefault();
            const submitBtn = document.getElementById('submitReportBtn');
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';

            const form = document.getElementById('reportForm');
            const formData = new FormData(form);

            const sessions = [];
            let idx = 0;
            while (true) {
                const name = formData.get(`sessionName_${idx}`);
                if (!name && idx === 0) break;
                if (!name) break;
                sessions.push({
                    name: name.trim(),
                    description: (formData.get(`sessionDesc_${idx}`) || '').trim(),
                    durationMinutes: parseInt(formData.get(`sessionDuration_${idx}`)) || undefined,
                    participationLevel: formData.get(`sessionParticipation_${idx}`)
                });
                idx++;
            }

            const payload = {
                registeredAttendeeCount: formData.get('registeredAttendeeCount') ? parseInt(formData.get('registeredAttendeeCount')) : undefined,
                actualAttendeeCount: parseInt(formData.get('actualAttendeeCount')),
                activitySessions: sessions,
                newToolsUsed: formData.get('newToolsUsed') || undefined,
                newMethodsUsed: formData.get('newMethodsUsed') || undefined,
                scoutEngagement: formData.get('scoutEngagement'),
                skillsGained: formData.get('skillsGained') ? formData.get('skillsGained').split(',').map(s => s.trim()).filter(Boolean) : [],
                notableAchievements: formData.get('notableAchievements') || undefined,
                logisticalIssues: formData.get('logisticalIssues') || undefined,
                behavioralIssues: formData.get('behavioralIssues') || undefined,
                suggestionsForImprovement: formData.get('suggestionsForImprovement') || undefined,
                satisfactionRatings: {
                    trainerSatisfaction: parseInt(formData.get('trainerSatisfaction')),
                    scoutSatisfaction: parseInt(formData.get('scoutSatisfaction'))
                },
                recommendedNextTraining: formData.get('recommendedNextTraining') || undefined,
                scoutsNeedingSupport: formData.get('scoutsNeedingSupport') || undefined,
                adminTasks: formData.get('adminTasks') || undefined,
                trainerReport: formData.get('trainerReport')
            };

            try {
                const response = await fetch(`/trainer/events/${currentEventId}/submit-report`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const data = await response.json();
                if (data.success) {
                    alert('Report submitted successfully!');
                    window.location.reload();
                } else {
                    alert('Failed to submit report: ' + data.error);
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Wrap-Up Report';
                }
            } catch (err) {
                console.error('Error:', err);
                alert('Connection error');
                submitBtn.disabled = false;
                submitBtn.textContent = 'Submit Wrap-Up Report';
            }
        }

        function initStarRating(containerId, inputId) {
            const container = document.getElementById(containerId);
            const input = document.getElementById(inputId);
            const stars = container.querySelectorAll('span[data-val]');

            function setRating(val) {
                container.dataset.value = val;
                input.value = val;
                stars.forEach(s => {
                    const rated = parseInt(s.dataset.val) <= val;
                    s.style.color = rated ? 'var(--accent)' : 'var(--muted)';
                    s.classList.toggle('rated', rated);
                });
            }

            stars.forEach(s => {
                s.addEventListener('click', () => setRating(parseInt(s.dataset.val)));
                s.classList.add('rated');
            });

            setRating(parseInt(container.dataset.value) || 3);
        }

        initStarRating('trainerSatisfaction', 'trainerSatisfactionInput');
        initStarRating('scoutSatisfaction', 'scoutSatisfactionInput');

        let sessionCount = 0;
        document.getElementById('addSessionBtn')?.addEventListener('click', function () {
            sessionCount++;
            const list = document.getElementById('sessionList');
            const row = document.createElement('div');
            row.className = 'session-row';
            row.style.cssText = 'display:grid; grid-template-columns: 1fr 2fr 80px 120px; gap:0.5rem; align-items:end; margin-bottom:0.5rem;';
            row.innerHTML = `
                <div>
                    <label style="font-size:0.85rem;">Session Name</label>
                    <input type="text" name="sessionName_${sessionCount}" placeholder="e.g. Team Challenge"
                           style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                </div>
                <div>
                    <label style="font-size:0.85rem;">Description</label>
                    <input type="text" name="sessionDesc_${sessionCount}" placeholder="Brief description"
                           style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                </div>
                <div>
                    <label style="font-size:0.85rem;">Duration (min)</label>
                    <input type="number" name="sessionDuration_${sessionCount}" min="0" placeholder="60"
                           style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                </div>
                <div>
                    <label style="font-size:0.85rem;">Participation</label>
                    <select name="sessionParticipation_${sessionCount}"
                            style="padding:0.5rem; border:1px solid var(--border); border-radius:var(--radius); width:100%;">
                        <option value="high">High</option>
                        <option value="medium" selected>Medium</option>
                        <option value="low">Low</option>
                    </select>
                </div>
            `;
            list.appendChild(row);
        });

        (function prefillSummary() {
            const summaryEl = document.getElementById('summaryRegistered');
            const regInput = document.getElementById('registeredAttendeeCount');
            if (!summaryEl || !regInput) return;
            const totalRegistered = (<%- JSON.stringify(event) %>.targetSchools || []).reduce((sum, s) => {
                return sum + (s.attendance ? (s.attendance.registered || 0) : 0);
            }, 0);
            summaryEl.textContent = totalRegistered;
            if (!regInput.value) regInput.value = totalRegistered || '';
        })();

        }

        // Helper functions (same as trainer_events.js)
        function formatEventType(type) {
            const types = { 'camp': 'Camp', 'hike': 'Hike', 'team_building': 'Team Building', 'training_session': 'Training Session', 'inter_school_competition': 'Inter-School Competition', 'other': 'Other' };
            return types[type] || type;
        }

        function formatStatus(status) {
            return status.replace('_', ' ');
        }

        function getStatusBadgeClass(status) {
            const map = { 'draft': 'badge-secondary', 'scheduled': 'badge-accent', 'published': 'badge-primary', 'confirmed': 'badge-success', 'in_progress': 'badge-warning', 'completed': 'badge-success', 'reviewed': 'badge-primary', 'cancelled': 'badge-danger', 'archived': 'badge-secondary' };
            return map[status] || 'badge-secondary';
        }

        function getEventTypeBadgeClass(type) {
            const map = { 'camp': 'badge-primary', 'hike': 'badge-success', 'team_building': 'badge-accent', 'training_session': 'badge-secondary', 'inter_school_competition': 'badge-warning', 'other': 'badge-secondary' };
            return map[type] || 'badge-secondary';
        }

        function formatRole(role) {
            const roles = { 'lead_trainer': 'Lead Trainer', 'assistant_trainer': 'Assistant Trainer', 'coordinator': 'Coordinator', 'volunteer': 'Volunteer' };
            return roles[role] || role;
        }

        function formatAssignmentStatus(status) {
            return status.replace('_', ' ');
        }

        function getAssignmentStatusBadge(status) {
            const map = { 'assigned': 'badge-warning', 'confirmed': 'badge-success', 'declined': 'badge-danger', 'removed': 'badge-danger' };
            return map[status] || 'badge-secondary';
        }

        function formatRsvpStatus(status) {
            return status.replace('_', ' ');
        }

        function getRsvpStatusBadge(status) {
            const map = { 'invited': 'badge-secondary', 'confirmed': 'badge-success', 'declined': 'badge-danger', 'pending': 'badge-warning', 'no_response': 'badge-secondary' };
            return map[status] || 'badge-secondary';
        }

        function formatReviewStatus(status) {
            return status.replace('_', ' ');
        }

        function getReviewStatusBadge(status) {
            const map = { 'pending': 'badge-warning', 'approved': 'badge-success', 'needs_revision': 'badge-accent', 'rejected': 'badge-danger' };
            return map[status] || 'badge-secondary';
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>

    <script nonce="<%= cspNonce %>">
      window.currentUserId = '<%= user.id %>';
    </script>
    <script src="/js/notifications.js"></script>
</body>
</html>
