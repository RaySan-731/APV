                       </div>

                       <div class="chart-card">
                         <h4>Event Effectiveness by Type</h4>
                         <div class="chart-wrap"><canvas id="eventEngagementChart" height="220"></canvas></div>
                       </div>

                       <div class="chart-card">
                         <h4>Top Schools by Engagement</h4>
                         <div class="chart-wrap"><canvas id="schoolParticipationChart" height="220"></canvas></div>
                       </div>

                       <div class="chart-card">
                         <h4>Schools by Service Status</h4>
                         <div class="chart-wrap"><canvas id="schoolStatusChart" height="220"></canvas></div>
                       </div>

                       <div class="chart-card">
                         <h4>School Onboarding Trend</h4>
                         <div class="chart-wrap"><canvas id="onboardingTrendChart" height="220"></canvas></div>
