                     <div class="analytics-insights">
                       Data is computed from live event, school, and feedback records. Use the time range selector above to analyze different periods. Charts update automatically when you change the range or click Refresh.
                     </div>
                 <% } else if (page === 'staff') { %>
                    <div class="stats-grid">
                        <div class="stat-card"><div class="stat-icon">👥</div><div><div class="stat-number"><%= stats ? stats.totalStaff : 0 %></div><div class="stat-label">Total Staff</div></div></div>
                        <div class="stat-card"><div class="stat-icon">🟢</div><div><div class="stat-number"><%= stats ? stats.activeStaff : 0 %></div><div class="stat-label">Active Staff</div></div></div>
                        <div class="stat-card"><div class="stat-icon">🛑</div><div><div class="stat-number"><%= stats ? stats.onLeaveStaff : 0 %></div><div class="stat-label">On Leave</div></div></div>
                        <div class="stat-card"><div class="stat-icon">📊</div><div><div class="stat-number"><%= stats ? stats.avgAttendance : 0 %>%</div><div class="stat-label">Avg Attendance</div></div></div>
                    </div>
                    <div class="content-card">
                        <div class="card-header">
                            <h3>Staff Directory</h3>
                            <div class="filter-bar">
                                <input type="text" id="staffSearch" placeholder="Search staff..." class="filter-input filter-input--wider">
                                <select id="roleFilter" class="filter-select">
                                    <option value="">All Roles</option>
                                    <option value="admin">Admin</option>
                                    <option value="founder">Founder</option>
                                    <option value="school_admin">School Admin</option>
                                    <option value="senior trainer">Senior Trainer</option>
                                    <option value="trainer">Trainer</option>
                                    <option value="supervisor">Supervisor</option>
                                    <option value="coordinator">Coordinator</option>
                                    <option value="staff">Staff</option>
                                </select>
                                <select id="statusFilter" class="filter-select">
                                    <option value="">All Status</option>
                                    <option value="Active">Active</option>
                                    <option value="On Leave">On Leave</option>
                                    <option value="Inactive">Inactive</option>
                                    <option value="Suspended">Suspended</option>
                                </select>
                                <select id="staffSortOrder" class="filter-select">
                                    <option value="name-asc">Name (A–Z)</option>
                                    <option value="name-desc">Name (Z–A)</option>
                                    <option value="id-asc">ID (Low–High)</option>
                                    <option value="id-desc">ID (High–Low)</option>
                                </select>
                                <button class="btn btn-primary" onclick="openAddStaffModal()">+ Add Staff</button>
                            </div>
                        </div>
                        <div class="card-content">
                            <div class="table-export-bar">
                                <span class="table-export-label"><strong id="staffTable-countLabel">0</strong> records</span>
                                <div class="table-export-actions">
                                    <button class="btn btn-sm btn-outline" onclick="exportTable('csv','staffTable')">Export CSV</button>
                                    <button class="btn btn-sm btn-primary" onclick="exportTable('pdf','staffTable')">Export PDF</button>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="data-table" id="staffTable">
                                <thead>
                                    <tr>
                                        <th>ID Number</th>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <% if (staffList && staffList.length > 0) { %>
                                    <% staffList.forEach(staff => { %>
                                        <tr data-role="<%= staff.role %>" data-status="<%= staff.status %>" data-name="<%= staff.name.toLowerCase() %>" data-email="<%= staff.email.toLowerCase() %>" data-id="<%= (staff.idNumber || '').toLowerCase() %>">
                                            <td class="id-cell"><%- staff.idNumber || '<span class="muted-text">—</span>' %></td>
                                            <td class="name-cell"><strong><%= staff.name %></strong></td>
                                            <td class="email-cell"><%= staff.email %></td>
                                            <td class="role-cell"><span class="badge badge-<%= getRoleBadgeClass(staff.role) %>"><%= staff.role %></span></td>
                                            <td class="status-cell"><span class="badge badge-<%= getStatusBadgeClass(staff.status) %>"><%= staff.status %></span></td>
                                            <td class="actions-cell">
                                                <div class="action-dropdown">
                                                    <button type="button" class="btn btn-sm btn-outline action-toggle" data-staff-id="<%= staff._id %>" aria-label="Staff actions">Actions ▾</button>
                                                    <div class="action-menu" style="display: none;">
                                                        <button type="button" class="action-item" onclick="viewStaffProfile('<%= staff._id %>')">👁 View Profile</button>
                                                        <button type="button" class="action-item" onclick="editStaff('<%= staff._id %>')">✏️ Edit</button>
                                                        <button type="button" class="action-item text-danger" onclick="deleteStaff('<%= staff._id %>')">🗑 Delete</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="6" class="placeholder-text">No staff entries found. Add your first staff member below.</td></tr>
                                <% } %>
                            </tbody>
                        </table>
                        <script type="application/json" data-export-config="staffTable">
{"title":"Staff List","filename":"staff_list","excludeColumns":["Actions"],"updateCount":"staffTable-countLabel"}
</script>
                        </div>
                    </div>

