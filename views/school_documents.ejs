<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Documents - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style>
        .upload-zone { border:2px dashed var(--border); border-radius:var(--radius); padding:2rem; text-align:center; cursor:pointer; transition:var(--transition-base); margin-bottom:1.5rem; }
        .upload-zone:hover { border-color:var(--primary); background:hsl(140,45%,98%); }
        .upload-zone svg { width:48px;height:48px;color:var(--muted-foreground); margin-bottom:0.5rem; }
        .doc-list { list-style:none; padding:0; margin:0; }
        .doc-item { display:flex; align-items:center; justify-content:space-between; padding:1rem; border:1px solid var(--border); border-radius:var(--radius); margin-bottom:0.5rem; background:var(--card); }
        .doc-info { display:flex; align-items:center; gap:0.75rem; }
        .doc-icon { width:40px;height:40px;display:flex;align-items:center;justify-content:center;background:var(--secondary);border-radius:var(--radius); }
        .doc-meta { font-size:0.85rem; color:var(--muted-foreground); }
        .doc-actions { display:flex; gap:0.5rem; }
        .badge { padding:0.25rem 0.5rem; border-radius:999px; font-size:0.75rem; font-weight:600; }
        .badge-contract { background:hsl(200,70%,90%); color:hsl(200,70%,30%); }
        .badge-insurance { background:hsl(140,70%,90%); color:hsl(140,70%,30%); }
        .badge-permission { background:hsl(40,70%,90%); color:hsl(40,70%,30%); }
        .badge-payment { background:hsl(25,70%,90%); color:hsl(25,70%,30%); }
        .badge-certificate { background:hsl(280,70%,90%); color:hsl(280,70%,30%); }
        .badge-other { background:hsl(0,0%,90%); color:hsl(0,0%,30%); }
        .hidden-input { display:none; }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar') %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path><path d="M3 6h18"></path><path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">Documents</h1>
            </header>

            <div class="dashboard-content">
                <!-- Upload Section -->
                <div class="card">
                    <div class="card-header">
                        <h2>Upload New Document</h2>
                    </div>
                    <div class="card-body">
                        <div class="upload-zone" id="uploadZone">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="17 8 12 3 7 8"></polyline>
                                <line x1="12" y1="3" x2="12" y2="15"></line>
                            </svg>
                            <p>Drop files here or click to browse</p>
                            <p class="text-muted" style="font-size:0.85rem;margin-top:0.5rem;">Supported: PDF, DOC, DOCX, XLS, XLSX, TXT, ZIP, RAR, JPG, PNG, GIF. Max 10MB.</p>
                        </div>
                        <form id="uploadForm" enctype="multipart/form-data" style="display:none;">
                            <input type="file" id="fileInput" name="document" class="hidden-input" accept=".pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar,.jpg,.jpeg,.png,.gif">
                        </form>
                        <div id="uploadDetails" style="display:none;margin-top:1rem;">
                            <div class="form-grid" style="gap:0.75rem;max-width:600px;">
                                <div class="form-group">
                                    <label for="docType">Document Type</label>
                                    <select id="docType" name="documentType" class="form-input" required>
                                        <option value="contract">Contract</option>
                                        <option value="insurance">Insurance</option>
                                        <option value="permission_slip">Permission Slip</option>
                                        <option value="payment_receipt">Payment Receipt</option>
                                        <option value="certificate">Certificate</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="docName">Display Name</label>
                                    <input type="text" id="docName" name="name" class="form-input" placeholder="Enter document name">
                                </div>
                                <div class="form-group">
                                    <label for="docDesc">Description</label>
                                    <input type="text" id="docDesc" name="description" class="form-input" placeholder="Optional description">
                                </div>
                                <div class="form-group">
                                    <label for="docExpiry">Expiry Date (if applicable)</label>
                                    <input type="date" id="docExpiry" name="expiryDate" class="form-input">
                                </div>
                                <div class="form-actions" style="display:flex;gap:0.5rem;">
                                    <button type="button" class="btn btn-secondary" id="cancelUpload">Cancel</button>
                                    <button type="button" class="btn btn-primary" id="submitUpload">Upload</button>
                                </div>
                            </div>
                        </div>
                        <div id="uploadStatus" style="margin-top:1rem;"></div>
                    </div>
                </div>

                <!-- Documents List -->
                <div class="card">
                    <div class="card-header">
                        <h2>Your Documents</h2>
                    </div>
                    <div class="card-body">
                        <% if (!documents || documents.length === 0) { %>
                            <div class="empty-state">
                                <p>No documents uploaded yet.</p>
                            </div>
                        <% } else { %>
                            <ul class="doc-list">
                                <% documents.forEach(doc => { %>
                                    <li class="doc-item">
                                        <div class="doc-info">
                                            <div class="doc-icon">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:24px;height:24px;">
                                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                                    <polyline points="14,2 14,8 20,8"></polyline>
                                                </svg>
                                            </div>
                                            <div>
                                                <div class="doc-name"><%= doc.name %></div>
                                                <div class="doc-meta">
                                                    Uploaded <%= new Date(doc.uploadedAt).toLocaleDateString() %> by <%= doc.uploadedBy?.name || 'System' %> • <%= doc.mimeType %> • <%= (doc.fileSize / 1024).toFixed(1) %> KB
                                                </div>
                                                <div style="margin-top:0.25rem;">
                                                    <span class="badge badge-<%= doc.documentType %>"><%= doc.documentType.replace('_',' ') %></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="doc-actions">
                                            <a href="<%= doc.url %>" class="btn btn-outline btn-sm" target="_blank">View</a>
                                            <a href="<%= doc.url %>" class="btn btn-primary btn-sm" download>Download</a>
                                        </div>
                                    </li>
                                <% }) %>
                            </ul>
                        <% } %>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const uploadZone = document.getElementById('uploadZone');
            const fileInput = document.getElementById('fileInput');
            const uploadForm = document.getElementById('uploadForm');
            const uploadDetails = document.getElementById('uploadDetails');
            const cancelUpload = document.getElementById('cancelUpload');
            const submitUpload = document.getElementById('submitUpload');
            const uploadStatus = document.getElementById('uploadStatus');

            let selectedFile = null;

            uploadZone.addEventListener('click', () => fileInput.click());

            uploadZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                uploadZone.style.borderColor = 'var(--primary)';
            });

            uploadZone.addEventListener('dragleave', () => {
                uploadZone.style.borderColor = 'var(--border)';
            });

            uploadZone.addEventListener('drop', (e) => {
                e.preventDefault();
                uploadZone.style.borderColor = 'var(--border)';
                if (e.dataTransfer.files.length) {
                    handleFile(e.dataTransfer.files[0]);
                }
            });

            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length) {
                    handleFile(e.target.files[0]);
                }
            });

            function handleFile(file) {
                if (file.size > 10 * 1024 * 1024) {
                    alert('File too large. Max 10MB.');
                    return;
                }
                selectedFile = file;
                uploadZone.style.display = 'none';
                uploadForm.style.display = 'block';
                uploadDetails.style.display = 'block';
                document.getElementById('docName').value = file.name.replace(/\.[^/.]+$/, '');
                uploadStatus.innerHTML = `<p>Selected: <strong>${file.name}</strong> (${(file.size/1024).toFixed(1)} KB)</p>`;
            }

            cancelUpload?.addEventListener('click', () => {
                uploadZone.style.display = 'block';
                uploadForm.style.display = 'none';
                uploadDetails.style.display = 'none';
                fileInput.value = '';
                selectedFile = null;
                uploadStatus.innerHTML = '';
            });

            submitUpload?.addEventListener('click', async () => {
                const formData = new FormData();
                formData.append('document', selectedFile);
                formData.append('documentType', document.getElementById('docType').value);
                formData.append('name', document.getElementById('docName').value || selectedFile.name);
                formData.append('description', document.getElementById('docDesc').value);
                formData.append('expiryDate', document.getElementById('docExpiry').value);

                try {
                    const res = await fetch('/api/school/documents', {
                        method: 'POST',
                        body: formData
                    });
                    const result = await res.json();
                    if (result.success) {
                        alert('Document uploaded successfully');
                        location.reload();
                    } else {
                        alert('Error: ' + result.error);
                    }
                } catch (err) {
                    alert('Upload failed: ' + err.message);
                }
            });
        });
    </script>
</body>
</html>
