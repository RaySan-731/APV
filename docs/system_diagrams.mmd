## 5. System Flowchart

```mermaid
flowchart TD
    Start([User arrives]) --> CheckAuth{Has<br/>Session?}

    CheckAuth -->|No| ShowLogin[Show Login Page]
    ShowLogin --> EnterCreds[Enter Email/Password]
    EnterCreds --> Validate[Validate Credentials]
    Validate -->|Invalid| ShowError[Error Message]
    ShowError --> EnterCreds
    Validate -->|Valid| CreateSession[Create Session<br/>Store User Data]

    CheckAuth -->|Yes| GetRole[Get User Role]

    CreateSession --> GetRole

    GetRole -->|Admin| AdminHome[Admin Dashboard]
    GetRole -->|Trainer| TrainerHome[Trainer Dashboard]
    GetRole -->|School Admin| SchoolHome[School Dashboard]

    AdminHome --> AdminChoose{Select Action}
    AdminChoose -->|New Event| EventWizard[Event Creation Wizard]
    EventWizard --> Step1[Enter Event Details]
    Step1 --> Step2[Assign Trainers]
    Step2 --> CheckAvail{All<br/>Available?}
    CheckAvail -->|No| Reassign[Reassignment UI]
    Reassign --> Step2
    CheckAvail -->|Yes| Step3[Select Schools]
    Step3 --> Step4[Set RSVP Deadline]
    Step4 --> Publish{Publish?}
    Publish -->|Yes| SendInv[Send Invitations]
    SendInv --> Track[Track RSVPs]
    Publish -->|No| SaveDraft[Save as Draft]
    SaveDraft --> AdminHome
    Track --> AdminHome

    AdminChoose -->|Staff List| StaffList[Staff Management]
    StaffList --> StaffOps{CRUD?}
    StaffOps -->|Add| AddStaff[Add Staff Form]
    StaffOps -->|Edit| EditStaff[Edit Staff Form]
    AddStaff --> SaveStaff[Save + Notify]
    EditStaff --> UpdateStaff[Update + Log]
    SaveStaff --> AdminHome
    UpdateStaff --> AdminHome

    AdminChoose -->|Reports| ReportGen[Report Generator]
    ReportGen --> SelectType{Report Type?}
    SelectType -->|School| SchoolRpt[School Report]
    SelectType -->|Event| EventRpt[Event Report]
    SelectType -->|Finance| FinanceRpt[Finance Report]
    SchoolRpt --> RunQuery[Run Aggregation]
    EventRpt --> RunQuery
    FinanceRpt --> RunQuery
    RunQuery --> Format[Format Results]
    Format --> Export{Export?}
    Export -->|PDF| GenPDF[Generate PDF]
    Export -->|Excel| GenCSV[Generate CSV]
    Export -->|No| ViewScreen[Display in Browser]
    GenPDF --> DownPDF[Download]
    GenCSV --> DownCSV[Download]
    DownPDF --> AdminHome
    DownCSV --> AdminHome
    ViewScreen --> AdminHome

    TrainerHome --> TrainerChoose{Trainer Action}
    TrainerChoose -->|My Events| MyEvents[Event Calendar]
    MyEvents --> ViewEvents[List Events]
    ViewEvents --> SelectEvent[Select Event]
    SelectEvent --> EventDetail[Event Details]

    EventDetail --> Pending{Status?}
    Pending -->|Upcoming| AcceptDecline{Accept?}
    AcceptDecline -->|Yes| AcceptEvent[Accept + Confirm]
    AcceptEvent --> TrainerHome
    AcceptDecline -->|No| DeclineEvent[Decline + Reason]
    DeclineEvent --> TrainerHome

    Pending -->|Completed| SubmitReport[Submit Report Form]
    SubmitReport --> UploadFiles[Upload Photos<br/>(max 10MB)]
    UploadFiles --> WriteReport[Write Summary]
    WriteReport --> SendReport[Submit for Review]
    SendReport --> NotifyAdmin[Notify Admin]
    NotifyAdmin --> TrainerHome

    SchoolHome --> SchoolChoose{School Action}
    SchoolChoose -->|Upcoming Events| UpcomingList[Invited Events]
    UpcomingList --> RSVP{RSVP?}
    RSVP -->|Yes| ConfirmRSVP[Confirm Attendance]
    RSVP -->|No| DeclineRSVP[Decline]
    ConfirmRSVP --> SendConfirm[Send Confirmation]
    DeclineRSVP --> SendDecline[Send Decline]
    SendConfirm --> SchoolHome
    SendDecline --> SchoolHome

    classDef start fill:#c8e6c9,stroke:#2e7d32,stroke-width:3px
    classDef process fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    classDef decision fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    classDef io fill:#fce4ec,stroke:#c2185b,stroke-width:2px

    class Start,AcceptEvent,SaveStaff,UpdateStaff,DownPDF,DownCSV,SendConfirm start
    class EnterCreds,EventWizard,Step1,Step2,Step3,Step4,StaffList,AddStaff,EditStaff,ReportGen,RunQuery,Format,MyEvents,SelectEvent,SubmitReport,UploadFiles,WriteReport,UpcomingList,ConfirmRSVP process
