<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>School Dashboard - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>

        <!-- Main Content -->
        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title">School Dashboard</h1>
                <div class="header-actions">
                    <div class="notification-container">
                        <button type="button" class="notification-bell" id="notificationBell" aria-label="Toggle notifications">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                            </svg>
                            <% if (stats.unreadNotifications > 0) { %>
                            <span class="badge badge-danger"><%= stats.unreadNotifications %></span>
                            <% } %>
                        </button>
                        <div id="notificationDropdown" class="notification-dropdown" style="display: none;">
                            <div class="dropdown-header">
                                <h3>Notifications</h3>
                            </div>
                            <div id="notificationList" style="max-height: 300px; overflow-y: auto;">
                                <% if (notifications.recent && notifications.recent.length > 0) { %>
                                    <% notifications.recent.forEach(notification => { %>
                                        <div class="notification-item <%= notification.type %> <%= notification.isRead ? '' : 'unread' %>">
                                            <div class="notification-content">
                                                <h4><%= notification.title %></h4>
                                                <p><%= notification.message %></p>
                                                <small><%= new Date(notification.createdAt).toLocaleString() %></small>
                                            </div>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="placeholder-text">No new notifications</div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <a href="/school/messages" class="btn btn-outline">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:20px;height:20px;margin-right:0.5rem;">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        Messages
                        <% if (stats.unreadMessages > 0) { %>
                        <span class="badge badge-primary"><%= stats.unreadMessages %></span>
                        <% } %>
                    </a>
                </div>
            </header>

            <div class="dashboard-content">
                <!-- Welcome Section -->
                <section class="welcome-section card">
                    <div class="welcome-content">
                        <h2>Welcome back, <strong><%= user.name %></strong></h2>
                        <p class="school-name"><%= school.name %> - <span class="status-badge status-<%= school.serviceStatus %>"><%= school.serviceStatus.replace('_', ' ').toUpperCase() %></span></p>
                    </div>
                    <div class="welcome-actions">
                        <a href="/school/profile" class="btn btn-secondary">Edit Profile</a>
                        <a href="/school/events" class="btn btn-primary">View Events</a>
                    </div>
                </section>

                <!-- Pending Actions Banner -->
                <% if (pendingActions && pendingActions.length > 0) { %>
                <section class="pending-actions">
                    <h3>Pending Actions</h3>
                    <div class="actions-grid">
                        <% pendingActions.forEach(action => { %>
                            <a href="<%= action.actionUrl %>" class="action-card">
                                <div class="action-icon">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <% if (action.type === 'payment') { %>
                                            <path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                                        <% } else if (action.type === 'message') { %>
                                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                                        <% } else if (action.type === 'notification') { %>
                                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                                        <% } %>
                                    </svg>
                                </div>
                                <div class="action-details">
                                    <span class="action-count"><%= action.count %></span>
                                    <span class="action-message"><%= action.message %></span>
                                </div>
                            </a>
                        <% }) %>
                    </div>
                </section>
                <% } %>

                <!-- Stats Grid -->
                <section class="stats-section">
                    <div class="stat-card">
                        <div class="stat-icon scouts">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value"><%= stats.totalScouts %></span>
                            <span class="stat-label">Active Scouts</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon groups">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2l3 3 3-3v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V2l3 3 3-3z"></path>
                                <path d="M2 12h20"></path>
                                <path d="M6 12v8"></path>
                                <path d="M18 12v8"></path>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value"><%= stats.activeGroupsCount %></span>
                            <span class="stat-label">Scout Groups</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon events">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value"><%= stats.upcomingEventsCount %></span>
                            <span class="stat-label">Upcoming Events</span>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon payments">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="12" y1="1" x2="12" y2="23"></line>
                                <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                            </svg>
                        </div>
                        <div class="stat-info">
                            <span class="stat-value">KES <%= stats.totalPaidThisYear ? stats.totalPaidThisYear.toLocaleString() : '0' %></span>
                            <span class="stat-label">Paid This Year</span>
                        </div>
                    </div>
                </section>

                <!-- Next Event & Service Status -->
                <div class="grid-2">
                    <section class="card next-event">
                        <h3>Next Event</h3>
                        <% if (nextEvent) { %>
                            <div class="event-preview">
                                <h4><%= nextEvent.name %></h4>
                                <p class="event-type"><%= nextEvent.eventType.replace('_', ' ') %></p>
                                <div class="event-dates">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;display:inline;vertical-align:middle;margin-right:4px;">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    <%= new Date(nextEvent.startDate).toLocaleDateString() %> - <%= new Date(nextEvent.endDate).toLocaleDateString() %>
                                </div>
                                <div class="event-location">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:16px;height:16px;display:inline;vertical-align:middle;margin-right:4px;">
                                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                        <circle cx="12" cy="10" r="3"></circle>
                                    </svg>
                                    <%= nextEvent.location?.name || 'TBD' %>
                                </div>
                                <a href="/school/events/<%= nextEvent._id %>" class="btn btn-primary btn-sm">View Details</a>
                            </div>
                        <% } else { %>
                            <p class="placeholder-text">No upcoming events scheduled.</p>
                        <% } %>
                    </section>

                    <section class="card service-status">
                        <h3>Service Status</h3>
                        <div class="status-indicator">
                            <div class="status-light status-<%= school.serviceStatus %>"></div>
                            <span class="status-text"><%= school.serviceStatus.replace('_', ' ') %></span>
                        </div>
                        <div class="service-details">
                            <p><strong>Onboarding Date:</strong> <%= new Date(school.onboardingDate).toLocaleDateString() %></p>
                            <% if (stats.daysSinceLastVisit !== null) { %>
                                <p><strong>Days Since Last Visit:</strong> <%= stats.daysSinceLastVisit %></p>
                            <% } else { %>
                                <p><strong>Last Visit:</strong> No visits recorded</p>
                            <% } %>
                        </div>
                        <a href="/school/profile" class="btn btn-outline btn-sm">Update Profile</a>
                    </section>
                </div>

                <!-- Recent Notifications -->
                <section class="card notifications-section">
                    <div class="section-header">
                        <h3>Recent Notifications</h3>
                        <a href="/school/notifications" class="view-all">View All</a>
                    </div>
                    <% if (notifications.recent && notifications.recent.length > 0) { %>
                        <ul class="notification-list">
                            <% notifications.recent.forEach(n => { %>
                                <li class="notification-item <%= n.type %> <%= n.isRead ? '' : 'unread' %>">
                                    <div class="notification-content">
                                        <h4><%= n.title %></h4>
                                        <p><%= n.message %></p>
                                        <small><%= new Date(n.createdAt).toLocaleString() %></small>
                                    </div>
                                </li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p class="placeholder-text">No notifications</p>
                    <% } %>
                </section>

                <!-- Quick Links -->
                <section class="quick-links">
                    <a href="/school/scouts" class="quick-link-card">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                        </svg>
                        <span>Manage Scouts</span>
                    </a>
                    <a href="/school/events" class="quick-link-card">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Events Calendar</span>
                    </a>
                    <a href="/school/payments" class="quick-link-card">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="1" x2="12" y2="23"></line>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                        </svg>
                        <span>Payment History</span>
                    </a>
                    <a href="/school/documents" class="quick-link-card">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14,2 14,8 20,8"></polyline>
                        </svg>
                        <span>Documents</span>
                    </a>
                    <a href="/school/messages" class="quick-link-card">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span>Contact Founder</span>
                    </a>
                </section>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Notification dropdown toggle
            const bell = document.getElementById('notificationBell');
            const dropdown = document.getElementById('notificationDropdown');
            if (bell && dropdown) {
                bell.addEventListener('click', (e) => {
                    e.stopPropagation();
                    dropdown.style.display = dropdown.style.display === 'none' ? 'block' : 'none';
                });
                document.addEventListener('click', () => dropdown.style.display = 'none');
            }

            // Mobile sidebar toggle
            const mobileToggle = document.getElementById('mobileSidebarToggle');
            const sidebar = document.getElementById('sidebar');
            if (mobileToggle && sidebar) {
                mobileToggle.addEventListener('click', () => {
                    sidebar.classList.toggle('mobile-open');
                });
            }
        });
    </script>
</body>
</html>
