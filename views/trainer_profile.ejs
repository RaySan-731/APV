<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Profile - Trainer Portal</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
    <style>
        /* Profile page specific styles */
        .profile-header {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            padding: 2rem;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-hover) 100%);
            color: white;
            border-radius: var(--radius);
            margin-bottom: 1.5rem;
            position: relative;
            overflow: hidden;
        }
        
        .profile-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -20%;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,0.05);
            border-radius: 50%;
        }
        
        .profile-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,0.2);
            border: 3px solid rgba(255,255,255,0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            font-weight: bold;
            color: white;
            text-transform: uppercase;
        }
        
        .profile-header-info h1 {
            font-size: 1.75rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }
        
        .profile-header-info .role-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: rgba(255,255,255,0.15);
            padding: 0.375rem 0.75rem;
            border-radius: 999px;
            font-size: 0.875rem;
            backdrop-filter: blur(4px);
        }
        
        .profile-section {
            background: var(--card);
            border-radius: var(--radius);
            box-shadow: var(--shadow-card);
            overflow: hidden;
            margin-bottom: 1.5rem;
        }
        
        .profile-section-header {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .profile-section-header h3 {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--foreground);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .profile-section-header h3 svg {
            width: 20px;
            height: 20px;
            color: var(--primary);
        }
        
        .profile-section-content {
            padding: 1.5rem;
        }
        
        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1rem;
        }
        
        .info-item {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
        }
        
        .info-label {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--muted-foreground);
            font-weight: 600;
        }
        
        .info-value {
            font-size: 0.95rem;
            color: var(--foreground);
            padding: 0.5rem;
            background: var(--muted);
            border-radius: 6px;
            min-height: 40px;
        }
        
        .info-value input, .info-value select {
            width: 100%;
            border: none;
            background: transparent;
            font-size: inherit;
            color: inherit;
            padding: 0;
            font-family: inherit;
        }
        
        .info-value input:focus {
            outline: none;
            box-shadow: 0 0 0 2px var(--ring);
        }
        
        .profile-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 1rem;
        }
        
        .profile-stat-card {
            background: linear-gradient(135deg, var(--muted) 0%, var(--card) 100%);
            padding: 1.25rem;
            border-radius: var(--radius);
            text-align: center;
            border: 1px solid var(--border);
            transition: var(--transition-base);
        }
        
        .profile-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-soft);
        }
        
        .profile-stat-icon {
            width: 32px;
            height: 32px;
            margin: 0 auto 0.5rem;
            color: var(--primary);
        }
        
        .profile-stat-value {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--foreground);
            margin-bottom: 0.25rem;
        }
        
        .profile-stat-label {
            font-size: 0.75rem;
            color: var(--muted-foreground);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
        }
        
        .schools-badge-list {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
        }
        
        .school-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.875rem;
            background: var(--secondary);
            border: 1px solid var(--border);
            border-radius: 999px;
            font-size: 0.875rem;
            color: var(--foreground);
        }
        
        .cert-status-active { color: #16a34a; font-weight: 600; }
        .cert-status-pending { color: #d97706; font-weight: 600; }
        .cert-status-expired { color: #dc2626; font-weight: 600; }
        
        .form-actions {
            padding: 1rem 1.5rem;
            background: var(--muted);
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 0.75rem;
        }
        
        .form-actions .btn {
            min-width: 120px;
        }
        
        .profile-completion {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            background: var(--secondary);
            border-radius: var(--radius);
            margin-bottom: 1.5rem;
        }
        
        .completion-bar {
            flex: 1;
            height: 8px;
            background: var(--border);
            border-radius: 4px;
            overflow: hidden;
        }
        
        .completion-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--primary), var(--accent));
            border-radius: 4px;
            transition: width 0.4s ease;
        }
        
        .completion-text {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--foreground);
            min-width: 80px;
            text-align: right;
        }
        
        .empty-state {
            text-align: center;
            padding: 2rem;
            color: var(--muted-foreground);
        }
        
         .empty-state svg {
             width: 48px;
             height: 48px;
             margin-bottom: 1rem;
             opacity: 0.5;
         }
         
         /* Schools badge list */
         .schools-badge-list {
             display: flex;
             flex-wrap: wrap;
             gap: 0.5rem;
         }
         
         .school-badge {
             display: inline-flex;
             align-items: center;
             gap: 0.5rem;
             padding: 0.5rem 0.875rem;
             background: var(--secondary);
             border: 1px solid var(--border);
             border-radius: 999px;
             font-size: 0.875rem;
             color: var(--foreground);
         }
         
         /* Certification status colors */
         .cert-status-active {
             color: #16a34a;
             font-weight: 600;
         }
         .cert-status-pending {
             color: #d97706;
             font-weight: 600;
         }
         .cert-status-expired {
             color: #dc2626;
             font-weight: 600;
         }
         
         @media (max-width: 768px) {
            .profile-header {
                flex-direction: column;
                text-align: center;
            }
            
            .profile-section {
                border-radius: 0;
            }
        }
    </style>
</head>
<body>
    <div class="dashboard-layout">
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-brand">
                    <span>APV Trainer Portal</span>
                </div>
            </div>
            <nav class="sidebar-nav">
                <div class="nav-section">
                    <ul class="nav-list">
                        <li class="nav-item"><a href="/trainer/dashboard" class="nav-link">Home</a></li>
                        <li class="nav-item"><a href="/trainer/schools" class="nav-link">My Schools</a></li>
                        <li class="nav-item"><a href="/trainer/students" class="nav-link">Students</a></li>
                        <li class="nav-item"><a href="/trainer/events" class="nav-link">Events</a></li>
                        <li class="nav-item"><a href="/trainer/profile" class="nav-link active">My Profile</a></li>
                    </ul>
                </div>
            </nav>
            <div class="sidebar-footer">
                <a href="/logout" class="logout-btn">Logout</a>
            </div>
        </aside>

        <main class="main-content">
            <header class="dashboard-header">
                <h1>My Profile</h1>
                <div class="user-info" style="display: flex; align-items: center; gap: 1rem;">
                    <div class="notification-bell" id="notificationBell" style="position: relative; cursor: pointer;">
                        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                        <span class="badge badge-danger" id="notificationBadge" style="position: absolute; top: -5px; right: -5px; display: none;">0</span>
                    </div>
                    <span>Welcome, <%= user.name %></span>
                </div>
            </header>

            <section class="dashboard-content">
                <!-- Profile Header -->
                <div class="profile-header">
                    <div class="profile-avatar">
                        <%= (trainer.name ? trainer.name.charAt(0).toUpperCase() : 'T') %>
                    </div>
                    <div class="profile-header-info">
                        <h1><%= trainer.name || 'Trainer' %></h1>
                        <div class="role-badge">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                <circle cx="12" cy="7" r="4"></circle>
                            </svg>
                            <%= trainer.role.charAt(0).toUpperCase() + trainer.role.slice(1) %>
                            <span style="background: rgba(255,255,255,0.2); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;">ID: <%= trainer.idNumber || 'N/A' %></span>
                        </div>
                    </div>
                </div>

                <!-- Profile Completion Indicator -->
                <%
                    // Calculate profile completion
                    const requiredFields = ['name', 'email', 'phone'];
                    const optionalFields = ['idNumber', 'dateOfBirth', 'address.street', 'address.city', 'address.country', 'emergencyContact.name', 'emergencyContact.phone'];
                    let filledRequired = 0;
                    let filledOptional = 0;
                    
                    if (trainer.name) filledRequired++;
                    if (trainer.email) filledRequired++;
                    if (trainer.phone) filledRequired++;
                    
                    if (trainer.idNumber) filledOptional++;
                    if (trainer.dateOfBirth) filledOptional++;
                    if (trainer.address?.street) filledOptional++;
                    if (trainer.address?.city) filledOptional++;
                    if (trainer.address?.country) filledOptional++;
                    if (trainer.emergencyContact?.name) filledOptional++;
                    if (trainer.emergencyContact?.phone) filledOptional++;
                    
                    const requiredPercent = Math.round((filledRequired / requiredFields.length) * 100);
                    const optionalPercent = Math.round((filledOptional / optionalFields.length) * 100);
                    const totalPercent = Math.round((requiredPercent + optionalPercent) / 2);
                %>
                <div class="profile-completion">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle>
                        <path d="M12 16v-4"></path>
                        <path d="M12 8h.01"></path>
                    </svg>
                    <div class="completion-bar">
                        <div class="completion-fill" style="width: <%= totalPercent %>%"></div>
                    </div>
                    <div class="completion-text"><%= totalPercent %>% Complete</div>
                </div>

                <!-- Quick Stats -->
                <div class="profile-stats">
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 2l3 3 3-3v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V2l3 3 3-3z"></path>
                                <path d="M2 12h20"></path>
                                <path d="M6 12v8"></path>
                                <path d="M18 12v8"></path>
                            </svg>
                        </div>
                        <div class="profile-stat-value"><%= trainer.performanceMetrics?.eventsCompleted || 0 %></div>
                        <div class="profile-stat-label">Events Completed</div>
                    </div>
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                <circle cx="9" cy="7" r="4"></circle>
                                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                            </svg>
                        </div>
                        <div class="profile-stat-value"><%= trainer.performanceMetrics?.schoolsVisited || 0 %></div>
                        <div class="profile-stat-label">Schools Visited</div>
                    </div>
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14,2 14,8 20,8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                            </svg>
                        </div>
                        <div class="profile-stat-value"><%= trainer.performanceMetrics?.reportsSubmitted || 0 %></div>
                        <div class="profile-stat-label">Reports Submitted</div>
                    </div>
                    <div class="profile-stat-card">
                        <div class="profile-stat-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 15l-2 0 2-4-2-4 4 4 4-4-2 4 2 0-2 4z"></path>
                                <path d="M12 2l3 3 3-3v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5l3-3z"></path>
                            </svg>
                        </div>
                        <div class="profile-stat-value"><%= typeof trainer.performanceMetrics?.averageFeedbackRating === 'number' ? trainer.performanceMetrics.averageFeedbackRating.toFixed(1) : 'N/A' %></div>
                        <div class="profile-stat-label">Performance Rating</div>
                    </div>
                </div>

                <!-- Main Profile Grid -->
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 1.5rem;">
                    <!-- Left Column -->
                    <div class="profile-section">
                        <div class="profile-section-header">
                            <h3>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                                Personal Information
                            </h3>
                        </div>
                        <div class="profile-section-content">
                            <form id="profileForm" class="form-grid">
                                <input type="hidden" name="staffId" value="<%= trainer._id %>">
                                <div class="info-item">
                                    <span class="info-label">Full Name</span>
                                    <div class="info-value"><%= trainer.name %></div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Email Address</span>
                                    <div class="info-value"><%= trainer.email %></div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Phone Number</span>
                                    <div class="info-value">
                                        <input type="tel" name="phone" value="<%= trainer.phone || '' %>" placeholder="+254 XXX XXX XXX">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">ID Number</span>
                                    <div class="info-value"><%= trainer.idNumber || 'Not set' %></div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Date of Birth</span>
                                    <div class="info-value">
                                        <%= trainer.dateOfBirth ? new Date(trainer.dateOfBirth).toLocaleDateString() : 'Not set' %>
                                    </div>
                                </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="profile-section">
                        <div class="profile-section-header">
                            <h3>
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                                    <circle cx="12" cy="10" r="3"></circle>
                                </svg>
                                Location & Contact
                            </h3>
                        </div>
                        <div class="profile-section-content">
                            <div class="info-grid">
                                <div class="info-item">
                                    <span class="info-label">Street Address</span>
                                    <div class="info-value">
                                        <input type="text" name="street" value="<%= trainer.address?.street || '' %>" placeholder="Enter street address">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">City</span>
                                    <div class="info-value">
                                        <input type="text" name="city" value="<%= trainer.address?.city || '' %>" placeholder="Enter city">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">State/Province</span>
                                    <div class="info-value">
                                        <input type="text" name="state" value="<%= trainer.address?.state || '' %>" placeholder="Enter state">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Zip/Postal Code</span>
                                    <div class="info-value">
                                        <input type="text" name="zipCode" value="<%= trainer.address?.zipCode || '' %>" placeholder="Enter zip code">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Country</span>
                                    <div class="info-value">
                                        <input type="text" name="country" value="<%= trainer.address?.country || 'Kenya' %>" placeholder="Enter country">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Employment & Emergency Section -->
                <div class="profile-section">
                    <div class="profile-section-header">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
                            </svg>
                            Employment & Emergency
                        </h3>
                    </div>
                    <div class="profile-section-content">
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem;">
                            <div class="info-grid">
                                <h4 style="margin-bottom: 1rem; color: var(--muted-foreground); font-size: 0.875rem; text-transform: uppercase; font-weight: 600;">Employment Details</h4>
                                <div class="info-item">
                                    <span class="info-label">Role</span>
                                    <div class="info-value" style="text-transform: capitalize;"><%= trainer.role %></div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Status</span>
                                    <div class="info-value">
                                        <span class="badge badge-<%= trainer.status === 'Active' ? 'success' : trainer.status === 'On Leave' ? 'warning' : 'danger' %>"><%= trainer.status %></span>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Department</span>
                                    <div class="info-value"><%= trainer.department || 'Training' %></div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Start Date</span>
                                    <div class="info-value">
                                        <%= trainer.employmentStartDate ? new Date(trainer.employmentStartDate).toLocaleDateString() : 'Not set' %>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="info-grid">
                                <h4 style="margin-bottom: 1rem; color: var(--muted-foreground); font-size: 0.875rem; text-transform: uppercase; font-weight: 600;">Emergency Contact</h4>
                                <div class="info-item">
                                    <span class="info-label">Contact Name</span>
                                    <div class="info-value">
                                        <input type="text" name="emergencyContactName" value="<%= trainer.emergencyContact?.name || '' %>" placeholder="Emergency contact name">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Relationship</span>
                                    <div class="info-value">
                                        <input type="text" name="emergencyContactRelationship" value="<%= trainer.emergencyContact?.relationship || '' %>" placeholder="e.g., Spouse, Parent">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Phone Number</span>
                                    <div class="info-value">
                                        <input type="tel" name="emergencyContactPhone" value="<%= trainer.emergencyContact?.phone || '' %>" placeholder="Emergency phone">
                                    </div>
                                </div>
                                <div class="info-item">
                                    <span class="info-label">Email Address</span>
                                    <div class="info-value">
                                        <input type="email" name="emergencyContactEmail" value="<%= trainer.emergencyContact?.email || '' %>" placeholder="Emergency email">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="form-actions">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                        </div>
                    </form>
                </div>

                 <!-- Assigned Schools -->
                <div class="profile-section">
                    <div class="profile-section-header">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                <polyline points="9 22 9 12 15 12 15 22"></polyline>
                            </svg>
                            Assigned Schools (<%= trainer.assignedSchools ? trainer.assignedSchools.length : 0 %>)
                        </h3>
                    </div>
                    <div class="profile-section-content">
                        <% if (trainer.assignedSchools && trainer.assignedSchools.length > 0) { %>
                            <div class="schools-badge-list">
                                <% trainer.assignedSchools.forEach(function(assignment) { %>
                                    <div class="school-badge">
                                        <span><%= assignment.schoolId ? (typeof assignment.schoolId === 'object' ? assignment.schoolId.name : assignment.schoolId) : 'School' %></span>
                                        <span class="badge badge-<%= assignment.status === 'active' ? 'success' : 'warning' %>" style="font-size: 0.75rem; padding: 2px 6px;"><%= assignment.status %></span>
                                    </div>
                                <% }); %>
                            </div>
                        <% } else { %>
                            <div class="empty-state">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                                </svg>
                                <p>No schools assigned yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- Leave Requests -->
                <div class="profile-section">
                    <div class="profile-section-header">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="16" y1="2" x2="16" y2="6"></line>
                                <line x1="8" y1="2" x2="8" y2="6"></line>
                                <line x1="3" y1="10" x2="21" y2="10"></line>
                                <path d="M9 16v-4"></path>
                                <path d="M12 16v-4"></path>
                            </svg>
                            Leave Requests
                        </h3>
                    </div>
                    <div class="profile-section-content">
                         <!-- Leave History -->
                         <h4 style="margin-bottom: 1rem; color: var(--foreground);">Leave History</h4>
                         <div id="trainerLeaveHistory">
                             <% if (trainer.leaveHistory && trainer.leaveHistory.length > 0) { %>
                                 <% trainer.leaveHistory.forEach((leave) => { %>
                                     <div class="leave-item" style="padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 0.5rem; background: var(--muted);">
                                         <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                             <div>
                                                 <strong><%= leave.type ? leave.type.charAt(0).toUpperCase() + leave.type.slice(1) : 'Leave' %></strong> —
                                                 <%= leave.startDate ? new Date(leave.startDate).toLocaleDateString() : 'N/A' %> to <%= leave.endDate ? new Date(leave.endDate).toLocaleDateString() : 'N/A' %>
                                             </div>
                                             <span class="badge badge-<%= leave.status === 'approved' ? 'success' : leave.status === 'rejected' ? 'danger' : leave.status === 'postponed' ? 'warning' : 'warning' %>">
                                                 <%= leave.status.charAt(0).toUpperCase() + leave.status.slice(1) %>
                                             </span>
                                         </div>
                                         <% if (leave.notes) { %>
                                             <p style="margin: 0.5rem 0; color: var(--muted-foreground); font-size: 0.875rem;">Notes: <%= leave.notes %></p>
                                         <% } %>
                                         <% if (leave.approvedBy) { %>
                                             <p style="margin: 0; color: var(--muted-foreground); font-size: 0.75rem;">
                                                 Reviewed by: <%= leave.approvedBy %> on <%= leave.approvedDate ? new Date(leave.approvedDate).toLocaleDateString() : 'N/A' %>
                                             </p>
                                         <% } %>
                                     </div>
                                 <% }) %>
                             <% } else { %>
                                 <p class="placeholder-text">No leave requests yet.</p>
                             <% } %>
                         </div>

                        <!-- Request New Leave Form -->
                        <h4 style="margin-top: 1.5rem; margin-bottom: 1rem; color: var(--foreground);">Request New Leave</h4>
                        <form id="leaveRequestForm" class="form-grid">
                            <label>Leave Type
                                <select name="type" required>
                                    <option value="annual">Annual Leave</option>
                                    <option value="sick">Sick Leave</option>
                                    <option value="emergency">Emergency Leave</option>
                                    <option value="training">Training/Workshop</option>
                                    <option value="maternity">Maternity Leave</option>
                                </select>
                            </label>
                            <label>Start Date
                                <input type="date" name="startDate" required>
                            </label>
                            <label>End Date
                                <input type="date" name="endDate" required>
                            </label>
                            <label style="grid-column: 1 / -1;">Notes (optional)
                                <textarea name="notes" rows="3" placeholder="Reason for leave, special circumstances..."></textarea>
                            </label>
                            <div class="form-actions" style="padding: 0; background: none; border: none;">
                                <button type="submit" class="btn btn-primary">Submit Leave Request</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Certifications -->
                <div class="profile-section">
                    <div class="profile-section-header">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M12 15l-2 0 2-4-2-4 4 4 4-4-2 4 2 0-2 4z"></path>
                                <path d="M9 3v6a3 3 0 0 0 6 0v-3"></path>
                                <path d="M9 17v-6"></path>
                            </svg>
                            Certifications & Training
                        </h3>
                    </div>
                    <div class="profile-section-content">
                        <div id="certificationsList">
                            <% if (trainer.certifications && trainer.certifications.length > 0) { %>
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Certification</th>
                                            <th>Issuer</th>
                                            <th>Issue Date</th>
                                            <th>Expiry Date</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    <% trainer.certifications.forEach((cert, idx) => { %>
                                        <tr>
                                            <td><strong><%= cert.name %></strong></td>
                                            <td><%= cert.issuer %></td>
                                            <td><%= cert.issueDate ? new Date(cert.issueDate).toLocaleDateString() : '—' %></td>
                                            <td><%= cert.expiryDate ? new Date(cert.expiryDate).toLocaleDateString() : 'No expiry' %></td>
                                            <td>
                                                <span class="cert-status-<%= cert.status %>">
                                                    <%= cert.status.charAt(0).toUpperCase() + cert.status.slice(1) %>
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline" onclick="deleteCert(<%= idx %>)" style="color: var(--destructive); border-color: var(--destructive);">Delete</button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <div class="empty-state">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M12 15l-2 0 2-4-2-4 4 4 4-4-2 4 2 0-2 4z"></path>
                                        <path d="M9 3v6a3 3 0 0 0 6 0v-3"></path>
                                        <path d="M9 17v-6"></path>
                                    </svg>
                                    <p>No certifications added yet.</p>
                                </div>
                            <% } %>
                        </div>
                        <h4 style="margin-top: 1.5rem; margin-bottom: 1rem; color: var(--foreground);">Add New Certification</h4>
                        <form id="addCertForm" class="form-grid">
                            <label>Certification Name
                                <input type="text" name="name" required placeholder="e.g., First Aid Certification">
                            </label>
                            <label>Issuing Organization
                                <input type="text" name="issuer" required placeholder="e.g., Red Cross">
                            </label>
                            <label>Issue Date
                                <input type="date" name="issueDate" required>
                            </label>
                            <label>Expiry Date (optional)
                                <input type="date" name="expiryDate" placeholder="Leave blank if no expiry">
                            </label>
                            <label>Status
                                <select name="status">
                                    <option value="active">Active</option>
                                    <option value="pending">Pending</option>
                                    <option value="expired">Expired</option>
                                </select>
                            </label>
                            <div class="form-actions" style="padding: 0; background: none; border: none;">
                                <button type="submit" class="btn btn-primary">Add Certification</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Notes Section (if any) -->
                <% if (trainer.notes) { %>
                <div class="profile-section">
                    <div class="profile-section-header">
                        <h3>
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                <polyline points="14,2 14,8 20,8"></polyline>
                                <line x1="16" y1="13" x2="8" y2="13"></line>
                                <line x1="16" y1="17" x2="8" y2="17"></line>
                            </svg>
                            Notes
                        </h3>
                    </div>
                    <div class="profile-section-content">
                        <p style="color: var(--muted-foreground); line-height: 1.7;"><%= trainer.notes %></p>
                    </div>
                </div>
                <% } %>
            </section>
        </main>
    </div>

    <script>
        function showToast(message, type = 'info', duration = 3000) {
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            toast.textContent = message;
            toast.style.cssText = 'position: fixed; top: 20px; right: 20px; padding: 1rem 1.5rem; border-radius: 8px; color: white; font-weight: 500; z-index: 10000; opacity: 0; transform: translateY(-20px); transition: all 0.3s ease;';
            if (type === 'success') toast.style.backgroundColor = '#28a745';
            else if (type === 'error') toast.style.backgroundColor = '#dc3545';
            else if (type === 'warning') toast.style.backgroundColor = '#ffc107';
            else toast.style.backgroundColor = '#6c757d';
            document.body.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; }, 10);
            setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateY(-20px)'; setTimeout(() => document.body.removeChild(toast), 300); }, duration);
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Profile update
            document.getElementById('profileForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const payload = {
                    phone: formData.get('phone').trim(),
                    street: formData.get('street').trim(),
                    city: formData.get('city').trim(),
                    state: formData.get('state').trim(),
                    zipCode: formData.get('zipCode').trim(),
                    country: formData.get('country').trim(),
                    emergencyContactName: formData.get('emergencyContactName').trim(),
                    emergencyContactRelationship: formData.get('emergencyContactRelationship').trim(),
                    emergencyContactPhone: formData.get('emergencyContactPhone').trim(),
                    emergencyContactEmail: formData.get('emergencyContactEmail').trim()
                };
                try {
                    const res = await fetch('/api/trainer/profile', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Profile updated successfully', 'success');
                        // Reload to reflect changes
                        setTimeout(() => window.location.reload(), 800);
                    } else {
                        showToast('Error: ' + (result.error || 'Update failed'), 'error');
                    }
                } catch (err) {
                    console.error('Error:', err);
                    showToast('Network error', 'error');
                }
            });

            // Add certification
            document.getElementById('addCertForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const payload = {
                    name: formData.get('name').trim(),
                    issuer: formData.get('issuer').trim(),
                    issueDate: formData.get('issueDate'),
                    expiryDate: formData.get('expiryDate') || null,
                    status: formData.get('status')
                };
                try {
                    const res = await fetch('/api/trainer/certifications', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Certification added', 'success');
                        window.location.reload();
                    } else {
                        showToast('Error: ' + (result.error || 'Failed to add'), 'error');
                    }
                } catch (err) {
                    console.error('Error:', err);
                    showToast('Network error', 'error');
                }
            });

            // Leave request submission
            document.getElementById('leaveRequestForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                const formData = new FormData(this);
                const payload = {
                    type: formData.get('type'),
                    startDate: formData.get('startDate'),
                    endDate: formData.get('endDate'),
                    notes: formData.get('notes').trim()
                };
                
                // Validate dates
                if (new Date(payload.startDate) > new Date(payload.endDate)) {
                    showToast('End date must be after start date', 'error');
                    return;
                }

                try {
                    const res = await fetch('/api/trainer/leave/request', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const result = await res.json();
                    if (result.success) {
                        showToast('Leave request submitted successfully', 'success');
                        window.location.reload();
                    } else {
                        showToast('Error: ' + (result.error || 'Failed to submit'), 'error');
                    }
                } catch (err) {
                    console.error('Error:', err);
                    showToast('Network error', 'error');
                }
            });
        });

        async function deleteCert(index) {
            if (!confirm('Delete this certification?')) return;
            try {
                const res = await fetch(`/api/trainer/certifications/${index}`, { method: 'DELETE' });
                const result = await res.json();
                if (result.success) {
                    showToast('Certification deleted', 'success');
                    window.location.reload();
                } else {
                    showToast('Error: ' + (result.error || 'Delete failed'), 'error');
                }
            } catch (err) {
                console.error('Error:', err);
                showToast('Network error', 'error');
            }
        }
    </script>

    <!-- Notification Panel -->
    <div id="notificationPanel" class="notification-panel" style="display: none;">
        <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-bottom: 1px solid var(--border); background: var(--card); position: sticky; top: 0; z-index: 1;">
            <div style="display: flex; gap: 1rem;">
                <button class="panel-tab active" data-tab="notifications">Notifications</button>
                <button class="panel-tab" data-tab="messages">Messages</button>
                <button class="panel-tab" data-tab="announcements">Announcements</button>
            </div>
            <div style="display: flex; gap: 0.5rem;">
                <button id="markAllReadBtn" class="btn btn-sm btn-outline" style="border: none; background: transparent;">Mark all read</button>
                <button id="closeNotificationPanel" class="btn btn-sm btn-outline" style="border: none; font-size: 1.2rem; line-height: 1; padding: 0.25rem 0.5rem;">&times;</button>
            </div>
        </div>
        <div id="notificationPanelList" style="max-height: calc(100vh - 8rem); overflow-y: auto; padding: 0.5rem;"></div>
    </div>

    <!-- Message Modal -->
    <div id="messageModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
        <div class="modal-content" style="background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow-card); width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; margin: 2rem;">
            <div class="card-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.5rem; border-bottom: 1px solid var(--border);">
                <h3 id="modalMessageSubject" style="margin: 0;">Message</h3>
                <button id="closeMessageModal" class="btn btn-sm btn-outline" style="border: none; font-size: 1.5rem; line-height: 1; cursor: pointer;" onclick="closeMessageModal()">&times;</button>
            </div>
            <div id="modalMessageBody" class="card-content" style="padding: 1.5rem;"></div>
        </div>
    </div>

    <script>
      window.currentUserId = '<%= user.id %>';
    </script>
    <script src="/js/notifications.js"></script>
</body>
</html>
