                       <div class="kpi-card"><div class="icon">👨‍🎓</div><div><div class="value" id="kpiTotalStudents">0</div><div class="label">Active Students</div></div></div>
                       <div class="kpi-card"><div class="icon">⚡</div><div><div class="value" id="kpiStaffProductivity">0</div><div class="label">Events per Trainer</div></div></div>
                       <div class="kpi-card"><div class="icon">📈</div><div><div class="value" id="kpiSchoolParticipation">0</div><div class="label">School Participation</div></div></div>
                       <div class="kpi-card"><div class="icon">🎯</div><div><div class="value" id="kpiEventEngagement">0</div><div class="label">Event Engagement</div></div></div>
                       <div class="kpi-card"><div class="icon">⏱</div><div><div class="value" id="kpiBookingLeadTime">0</div><div class="label">Avg Lead Days</div></div></div>
                     </div>

