<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pkg ? 'Edit' : 'Create' %> Service Package - Arrow-Park Ventures</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="icon" href="/favicon.ico">
</head>
<body>
    <div class="dashboard-layout">
        <%- include('../partials/sidebar', { user, page: 'finance/service-packages' }) %>

        <main class="main-content">
            <header class="dashboard-header">
                <button class="mobile-sidebar-toggle" id="mobileSidebarToggle">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 12h18"></path>
                        <path d="M3 6h18"></path>
                        <path d="M3 18h18"></path>
                    </svg>
                </button>
                <h1 class="page-title"><%= pkg ? 'Edit' : 'Create' %> Service Package</h1>
                <a href="/finance/service-packages" class="btn btn-outline-secondary btn-sm">Back to List</a>
            </header>

            <div class="container-fluid mt-4">
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-body">
                                <form action="/finance/service-packages<%= pkg ? '/' + pkg._id : '/save' %>" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label">Package Name (ID) *</label>
                                        <input type="text" name="name" class="form-control" 
                                            value="<%= pkg?.name || '' %>" <%= pkg ? 'readonly' : 'required' %>>
                                        <small class="text-muted">e.g., basic, standard, premium (cannot be changed after creation)</small>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Display Name *</label>
                                        <input type="text" name="displayName" class="form-control" value="<%= pkg?.displayName || '' %>" required>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Description</label>
                                        <textarea name="description" class="form-control" rows="3"><%= pkg?.description || '' %></textarea>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Pricing Model *</label>
                                        <select name="pricingModel" class="form-select" required>
                                            <option value="per_student" <%= pkg?.pricingModel === 'per_student' ? 'selected' : '' %>>Per Student</option>
                                            <option value="per_event" <%= pkg?.pricingModel === 'per_event' ? 'selected' : '' %>>Per Event</option>
                                            <option value="monthly_retainer" <%= pkg?.pricingModel === 'monthly_retainer' ? 'selected' : '' %>>Monthly Retainer</option>
                                            <option value="quarterly" <%= pkg?.pricingModel === 'quarterly' ? 'selected' : '' %>>Quarterly</option>
                                            <option value="annual" <%= pkg?.pricingModel === 'annual' ? 'selected' : '' %>>Annual</option>
                                        </select>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Rate Per Student (KES)</label>
                                            <input type="number" name="ratePerStudent" class="form-control" min="0" step="0.01" value="<%= pkg?.ratePerStudent || 0 %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Monthly Retainer (KES)</label>
                                            <input type="number" name="monthlyRetainer" class="form-control" min="0" step="0.01" value="<%= pkg?.monthlyRetainer || 0 %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Per Event Fee (KES)</label>
                                            <input type="number" name="perEventFee" class="form-control" min="0" step="0.01" value="<%= pkg?.perEventFee || 0 %>">
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label">Included Features</label>
                                        <div id="features">
                                            <% (pkg?.features || []).forEach((f, i) => { %>
                                                <div class="row g-2 mb-2 feature-row">
                                                    <div class="col-md-5">
                                                        <input type="text" name="features[<%= i %>][name]" class="form-control" value="<%= f.name %>" placeholder="Feature name">
                                                    </div>
                                                    <div class="col-md-5">
                                                        <input type="text" name="features[<%= i %>][description]" class="form-control" value="<%= f.description %>" placeholder="Description">
                                                    </div>
                                                    <div class="col-md-2">
                                                        <select name="features[<%= i %>][included]" class="form-select">
                                                            <option value="true" <%= f.included ? 'selected' : '' %>>Included</option>
                                                            <option value="false" <%= !f.included ? 'selected' : '' %>>Optional</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm mt-2" onclick="addFeatureRow()">Add Feature</button>
                                    </div>

                                    <div class="row g-3 mb-3">
                                        <div class="col-md-4">
                                            <label class="form-label">Invoice Prefix</label>
                                            <input type="text" name="invoicePrefix" class="form-control" value="<%= pkg?.invoicePrefix || 'INV' %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Payment Terms (Days)</label>
                                            <input type="number" name="paymentTermsDays" class="form-control" value="<%= pkg?.paymentTermsDays || 30 %>">
                                        </div>
                                        <div class="col-md-4">
                                            <label class="form-label">Currency</label>
                                            <select name="currency" class="form-select">
                                                <option value="KES" <%= pkg?.currency === 'KES' ? 'selected' : '' %>>KES</option>
                                                <option value="USD" <%= pkg?.currency === 'USD' ? 'selected' : '' %>>USD</option>
                                                <option value="EUR" <%= pkg?.currency === 'EUR' ? 'selected' : '' %>>EUR</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="mb-3 form-check">
                                        <input type="checkbox" name="isActive" class="form-check-input" id="isActive" <%= pkg?.isActive !== false ? 'checked' : '' %>>
                                        <label class="form-check-label" for="isActive">Active</label>
                                    </div>

                                    <button type="submit" class="btn btn-primary">Save Package</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script nonce="<%= cspNonce %>">
    function addFeatureRow() {
        const container = document.getElementById('features');
        const index = container.children.length;
        const row = document.createElement('div');
        row.className = 'row g-2 mb-2 feature-row';
        row.innerHTML = `
            <div class="col-md-5">
                <input type="text" name="features[${index}][name]" class="form-control" placeholder="Feature name">
            </div>
            <div class="col-md-5">
                <input type="text" name="features[${index}][description]" class="form-control" placeholder="Description">
            </div>
            <div class="col-md-2">
                <select name="features[${index}][included]" class="form-select">
                    <option value="true">Included</option>
                    <option value="false">Optional</option>
                </select>
            </div>
        `;
        container.appendChild(row);
    }
    </script>

    <script src="/js/main.js"></script>
</body>
</html>
