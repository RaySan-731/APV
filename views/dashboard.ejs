                     <script nonce="<%= cspNonce %>">
         // Expose current user and programs to client-side scripts
         window.currentUser = <%- JSON.stringify({
           id: user.id,
           role: user.role,
           name: user.name,
           email: user.email
         }) %>;
         window.allPrograms = <%- JSON.stringify(allPrograms || []) %>;
       </script>

      <!-- Notifications Dropdown JavaScript -->
      <script nonce="<%= cspNonce %>">
        (function() {
          'use strict';

          const notificationBell = document.getElementById('notificationBell');
          const notificationDropdown = document.getElementById('notificationDropdown');
          if (!notificationBell || !notificationDropdown) {
            console.warn('Notification bell elements not found');
            return;
          }
          const notificationList = document.getElementById('notificationList');
          const notificationBadge = document.getElementById('notificationBadge');
          const markAllReadBtn = document.getElementById('markAllReadBtn');
          const tabButtons = document.querySelectorAll('.tab-btn');
          const notificationsTabContent = document.getElementById('notificationsTabContent');
          const composeTabContent = document.getElementById('composeTabContent');
          
          let currentTab = 'notifications';
          let notificationsData = { announcements: [], messages: [] };
          let unreadCounts = { announcements: 0, messages: 0 };

          // Toggle dropdown
          notificationBell.addEventListener('click', function(e) {
            e.stopPropagation();
            const isVisible = notificationDropdown.style.display === 'block';
            notificationDropdown.style.display = isVisible ? 'none' : 'block';
            if (!isVisible) {
              // Always reset to the Notifications tab when the bell opens the dropdown.
              // This prevents the user from seeing only the Compose form (or an old tab state)
              // even though the badge shows there are unread notifications.
              currentTab = 'notifications';
              tabButtons.forEach(b => b.classList.remove('active'));
              const notificationsTabBtn = Array.from(tabButtons).find(b => b.dataset.tab === 'notifications');
              if (notificationsTabBtn) notificationsTabBtn.classList.add('active');

              if (notificationsTabContent) notificationsTabContent.style.display = 'block';
              if (composeTabContent) composeTabContent.style.display = 'none';

              loadNotificationsData();
            }
          });

          // Close dropdown when clicking outside
           document.addEventListener('click', function(e) {
             if (!notificationDropdown.contains(e.target) && !notificationBell.contains(e.target)) {
               notificationDropdown.style.display = 'none';
             }
           });


          // Tab switching
          tabButtons.forEach(btn => {
            btn.addEventListener('click', function() {
              tabButtons.forEach(b => b.classList.remove('active'));
              this.classList.add('active');
              currentTab = this.dataset.tab;
              
              if (currentTab === 'notifications') {
                if (notificationsTabContent) notificationsTabContent.style.display = 'block';
                if (composeTabContent) composeTabContent.style.display = 'none';
                renderNotifications();
              } else if (currentTab === 'compose') {
                if (notificationsTabContent) notificationsTabContent.style.display = 'none';
                if (composeTabContent) composeTabContent.style.display = 'block';
              }
            });
          });

          // Fetch notifications data (announcements + messages)
          async function loadNotificationsData() {
            try {
              // Fetch recent announcements (limit 5)
              const annRes = await fetch('/api/announcements?limit=5');
              const annData = await annRes.json();
              notificationsData.announcements = annData.announcements || [];

              // Fetch recent messages (inbox, limit 5)
              const msgRes = await fetch('/api/messages?folder=inbox&limit=5');
              const msgData = await msgRes.json();
              notificationsData.messages = msgData.messages || [];
              unreadCounts.messages = msgData.unreadCount || 0;
              unreadCounts.announcements = notificationsData.announcements.filter(a => !isAnnouncementAcknowledged(a)).length;

              updateBadge();
              if (currentTab === 'notifications') {
                renderNotifications();
              }
            } catch (err) {
              console.error('Error loading notifications:', err);
              notificationList.innerHTML = '<div class="notification-dropdown-empty">Failed to load notifications</div>';
            }
          }

          // Update badge count
          function updateBadge() {
            const totalUnread = unreadCounts.announcements + unreadCounts.messages;
            if (notificationBadge) {
              if (totalUnread > 0) {
                notificationBadge.textContent = totalUnread > 99 ? '99+' : totalUnread;
                notificationBadge.style.display = 'flex';
              } else {
                notificationBadge.style.display = 'none';
              }
            }

            // Show/hide mark all read button
            if (markAllReadBtn) {
              markAllReadBtn.style.display = totalUnread > 0 ? 'block' : 'none';
            }
          }

          // Render notifications list
          function renderNotifications() {
            if (!notificationList) return;
            let items = [];

            // Combine announcements and messages
            const annItems = notificationsData.announcements.map(a => ({
              type: 'announcement',
              title: a.title,
              subtitle: `Announcement • ${new Date(a.createdAt).toLocaleDateString()}`,
              date: new Date(a.createdAt),
              unread: !isAnnouncementAcknowledged(a),
              priority: a.priority,
              _id: a._id
            }));
            const msgItems = (notificationsData.messages || []).map(m => ({
              type: 'message',
              title: m.subject || '(No subject)',
              subtitle: `From: ${m.senderId?.name || 'Unknown'}`,
              date: new Date(m.sentAt),
              unread: !isMessageRead(m),
              priority: m.priority,
              _id: m._id
            }));
            items = [...annItems, ...msgItems].sort((a, b) => b.date - a.date);

            // Render items
            if (items.length === 0) {
              notificationList.innerHTML = '<div class="notification-dropdown-empty">No notifications</div>';
              return;
            }

            notificationList.innerHTML = items.map(item => `
              <div class="notification-dropdown-item ${item.unread ? 'unread' : ''}" data-id="${item._id}" data-type="${item.type}">
                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                  <div style="flex: 1;">
                    <div style="font-weight: 500; margin-bottom: 0.25rem;">${escapeHtml(item.title)}</div>
                    <div style="font-size: 0.85rem; color: var(--muted-foreground);">${escapeHtml(item.subtitle)}</div>
                  </div>
                  ${item.priority === 'urgent' || item.priority === 'high' ? '<span class="badge badge-warning" style="margin-left: 0.5rem;">!</span>' : ''}
                </div>
                ${item.unread ? '<div style="width: 8px; height: 8px; background: var(--primary); border-radius: 50%; position: absolute; right: 0.75rem; top: 50%; transform: translateY(-50%);"></div>' : ''}
              </div>
            `).join('');

             // Add click handlers for notification items
             document.querySelectorAll('.notification-dropdown-item').forEach(item => {
               item.addEventListener('click', function() {
                 const type = this.dataset.type;
                 const id = this.dataset.id;
                 notificationDropdown.style.display = 'none';
                 if (type === 'announcement') {
                   viewAnnouncementModal(id);
                 } else if (type === 'message') {
                   viewMessageModal(id);
                 }
               });
             });
          }

          // Helper: Check if announcement is acknowledged by current user
          function isAnnouncementAcknowledged(ann) {
            return ann.acknowledgments?.some(a => a.staffId === (window.currentUser?.id));
          }

          // Helper: Check if message is read
          function isMessageRead(msg) {
            return msg.recipients?.some(r => {
              const staffId = r.staffId ? (r.staffId._id ? r.staffId._id.toString() : r.staffId.toString()) : null;
              return staffId === (window.currentUser?.id) && r.status === 'read';
            });
          }

          // Escape HTML to prevent XSS
          function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
          }

          // Mark all as read (acknowledge announcements + mark messages as read)
          async function markAllRead() {
            try {
              // Mark all unread announcements as acknowledged
              for (const ann of notificationsData.announcements) {
                if (!isAnnouncementAcknowledged(ann)) {
                  await fetch(`/api/announcements/${ann._id}/acknowledge`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ notes: '' })
                  });
                }
              }
              // Mark all unread messages as read
              for (const msg of notificationsData.messages || []) {
                if (!isMessageRead(msg)) {
                  await fetch(`/api/messages/${msg._id}/read`, { method: 'POST' });
                }
              }
              // Reload
              loadNotificationsData();
            } catch (err) {
              console.error('Error marking all as read:', err);
            }
          }

          markAllReadBtn?.addEventListener('click', markAllRead);

          async function markMessageAsRead(msgId) {
            try {
              await fetch(`/api/messages/${msgId}/read`, { method: 'POST' });
            } catch (err) {
              console.error('Error marking read:', err);
            }
          }

          // ============ COMPOSE FUNCTIONALITY ============
          const composeForm = document.getElementById('dropdownComposeForm');
          const composeMessageEl = document.getElementById('composeMessage');
          
          composeForm?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const recipientIds = Array.from(document.getElementById('composeRecipientSelect').selectedOptions).map(o => o.value);
            const subject = document.getElementById('composeSubject').value.trim();
            const body = document.getElementById('composeBody').value.trim();
            const priority = document.getElementById('composePriority').value;
            const isImportant = document.getElementById('composeImportant').checked;
            const parentMessageId = document.getElementById('composeParentMessageId')?.value || undefined;

            if (!recipientIds.length || !body) {
              showComposeError('Please fill in required fields');
              return;
            }

            try {
              const res = await fetch('/api/messages/send', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ recipientIds, subject, body, priority, isImportant, parentMessageId })
              });
              const data = await res.json();
              if (data.success) {
                composeForm.reset();
                showComposeSuccess('Message sent!');
                // Refresh notifications data
                loadNotificationsData();
                // Switch to notifications tab after short delay
                setTimeout(() => {
                  document.querySelector('[data-tab="notifications"]').click();
                }, 1000);
              } else {
                showComposeError(data.error || 'Failed to send');
              }
            } catch (err) {
              console.error('Error sending message:', err);
              showComposeError('Network error');
            }
          });

          function showComposeError(msg) {
            composeMessageEl.textContent = msg;
            composeMessageEl.style.display = 'block';
            composeMessageEl.className = 'message error';
            setTimeout(() => { composeMessageEl.style.display = 'none'; }, 3000);
          }

          function showComposeSuccess(msg) {
            composeMessageEl.textContent = msg;
            composeMessageEl.style.display = 'block';
            composeMessageEl.className = 'message success';
            setTimeout(() => { composeMessageEl.style.display = 'none'; }, 3000);
          }

          function closeCompose() {
            composeForm.reset();
            document.querySelector('[data-tab="notifications"]').click();
          }
          window.closeCompose = closeCompose;

          // Announcement form (admin/founder only)
          <% if (['admin', 'founder', 'commissioner', 'supervisor'].includes(user.role)) { %>
          const announcementForm = document.getElementById('dropdownAnnouncementForm');
          const announcementFormSection = document.getElementById('announcementFormSection');
          const announcementFormMessage = document.getElementById('announcementFormMessage');

          // Add toggle to show announcement form
          const composeTab = document.querySelector('[data-tab="compose"]');
          const announcementToggle = document.createElement('div');
          announcementToggle.innerHTML = '<p style="font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 0.5rem;"><a href="#" id="showAnnouncementForm" style="color: var(--primary);">+ Create Announcement</a></p>';
          composeTabContent.insertBefore(announcementToggle.firstChild, composeTabContent.firstChild);

          document.getElementById('showAnnouncementForm')?.addEventListener('click', function(e) {
            e.preventDefault();
            announcementFormSection.style.display = announcementFormSection.style.display === 'none' ? 'block' : 'none';
          });

          announcementForm?.addEventListener('submit', async function(e) {
            e.preventDefault();
            const title = document.getElementById('announcementTitle').value.trim();
            const content = document.getElementById('announcementContent').value.trim();
            const priority = document.getElementById('announcementPriority').value;
            const requiresAcknowledgment = document.getElementById('announcementRequiresAck').checked;

            if (!title || !content) {
              announcementFormMessage.textContent = 'Title and content are required';
              announcementFormMessage.style.display = 'block';
              announcementFormMessage.className = 'message error';
              return;
            }

            try {
              const res = await fetch('/api/announcements', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  title,
                  content,
                  targetType: 'all_staff',
                  priority,
                  requiresAcknowledgment,
                  sendEmail: true,
                  sendAsNotification: true,
                  deliveryType: 'immediate'
                })
              });
              const data = await res.json();
              if (data.success) {
                announcementForm.reset();
                announcementFormMessage.textContent = 'Announcement posted!';
                announcementFormMessage.style.display = 'block';
                announcementFormMessage.className = 'message success';
                announcementFormSection.style.display = 'none';
                // Refresh notifications
                loadNotificationsData();
                setTimeout(() => {
                  document.querySelector('[data-tab="notifications"]').click();
                }, 1000);
              } else {
                announcementFormMessage.textContent = data.error || 'Failed to post';
                announcementFormMessage.style.display = 'block';
                announcementFormMessage.className = 'message error';
              }
            } catch (err) {
              console.error('Error posting announcement:', err);
              announcementFormMessage.textContent = 'Network error';
              announcementFormMessage.style.display = 'block';
              announcementFormMessage.className = 'message error';
            }
          });
          <% } %>

          // ============ VIEW MODALS ============
          let currentAnnouncement = null;
          let currentMessage = null;

          function openModal(id) {
            document.getElementById(id).style.display = 'flex';
          }

          function closeModal(id) {
            document.getElementById(id).style.display = 'none';
          }

          function closeAnnouncementModal() {
            closeModal('announcementModal');
            currentAnnouncement = null;
            // Refresh notifications list to reflect acknowledgment
            loadNotificationsData();
          }
          window.closeAnnouncementModal = closeAnnouncementModal;

          function closeMessageModal() {
            closeModal('messageDetailModal');
            currentMessage = null;
          }
          window.closeMessageModal = closeMessageModal;

          async function acknowledgeAnnouncement() {
            if (!currentAnnouncement) return;
            try {
              await fetch(`/api/announcements/${currentAnnouncement._id}/acknowledge`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ notes: '' })
              });
              closeAnnouncementModal();
            } catch (err) {
              console.error('Error acknowledging:', err);
            }
          }
          window.acknowledgeAnnouncement = acknowledgeAnnouncement;

          function replyFromModal() {
            const msg = currentMessage;
            if (!msg) return;

            const subject = msg.subject || '(No subject)';
            const rawSender = msg.senderId;
            const senderId = rawSender ? (rawSender._id || rawSender) : null;
            const messageId = msg._id || '';

            closeMessageModal();

            // Open the notification dropdown if it's not already visible
            if (notificationDropdown && notificationDropdown.style.display !== 'block') {
              notificationDropdown.style.display = 'block';
            }

            // Switch to compose tab
            const composeTab = document.querySelector('[data-tab="compose"]');
            if (composeTab) composeTab.click();

            // Pre-fill for reply
            const subjectInput = document.getElementById('composeSubject');
            if (subjectInput) subjectInput.value = 'Re: ' + subject;

            const parentInput = document.getElementById('composeParentMessageId');
            if (parentInput) parentInput.value = messageId;

            // Try to pre-select the original sender as recipient
            const recipientSelect = document.getElementById('composeRecipientSelect');
            if (recipientSelect && senderId) {
              Array.from(recipientSelect.options).forEach(opt => opt.selected = false);
              const senderOption = Array.from(recipientSelect.options).find(opt => opt.value === senderId.toString());
              if (senderOption) {
                senderOption.selected = true;
              }
            }
          }
           window.replyFromModal = replyFromModal;

           // View announcement in modal
           async function viewAnnouncementModal(id) {
            try {
              const res = await fetch(`/api/announcements/${id}`);
              const data = await res.json();
              if (data.announcement || data.success) {
                const ann = data.announcement || data;
                currentAnnouncement = ann;
                document.getElementById('modalAnnouncementTitle').textContent = ann.title;
                document.getElementById('announcementMeta').innerHTML = `
                  <strong>Posted:</strong> ${new Date(ann.createdAt).toLocaleString()}
                  ${ann.acknowledgmentDeadline ? ` | <strong>Acknowledge by:</strong> ${new Date(ann.acknowledgmentDeadline).toLocaleDateString()}` : ''}
                `;
                document.getElementById('announcementContent').innerHTML = ann.content.replace(/\n/g, '<br>');

                // Show/hide acknowledge button for non-admins
                const ackBtn = document.getElementById('acknowledgeBtn');
                if (ackBtn) {
                  const alreadyAcked = ann.acknowledgments?.some(a => a.staffId === window.currentUser?.id);
                  ackBtn.style.display = alreadyAcked ? 'none' : 'block';
                }

                // Show metrics for admins
                const metricsEl = document.getElementById('announcementMetrics');
                if (metricsEl) {
                  if (ann.metrics) {
                    document.getElementById('metricRecipients').textContent = ann.metrics.recipientCount || ann.metrics.sentCount || '—';
                    document.getElementById('metricAcknowledged').textContent = ann.metrics.acknowledgedCount || 0;
                    metricsEl.style.display = 'block';
                  } else {
                    metricsEl.style.display = 'none';
                  }
                }

                openModal('announcementModal');
              }
            } catch (err) {
              console.error('Error loading announcement:', err);
              alert('Failed to load announcement');
            }
          }

          // View message in modal
          async function viewMessageModal(id) {
            try {
              const res = await fetch(`/api/messages/${id}`);
              const data = await res.json();
              if (data.message) {
                const msg = data.message;
                currentMessage = msg;
                document.getElementById('modalMessageSubject').textContent = msg.subject || '(No subject)';
                
                let messageHtml = `
                  <div style="margin-bottom: 1rem; color: var(--muted-foreground);">
                    <strong>From:</strong> ${msg.senderId?.name || 'Unknown'} (${msg.senderId?.role || ''})<br>
                    <strong>Date:</strong> ${new Date(msg.sentAt).toLocaleString()}
                    ${msg.priority ? `<br><strong>Priority:</strong> ${msg.priority}` : ''}
                  </div>
                  <div style="line-height: 1.6; white-space: pre-wrap;">${escapeHtml(msg.body)}</div>
                `;
                document.getElementById('messageDetailContent').innerHTML = messageHtml;
                
                // Load thread replies
                loadThreadReplies(id);
                
                 // Mark as read if not sender
                 if (msg.senderId?._id !== window.currentUser?.id) {
                  await fetch(`/api/messages/${id}/read`, { method: 'POST' });
                  // Update unread counts
                  unreadCounts.messages = Math.max(0, unreadCounts.messages - 1);
                  updateBadge();
                }
                
                openModal('messageDetailModal');
              }
            } catch (err) {
              console.error('Error loading message:', err);
              alert('Failed to load message');
            }
          }

          async function loadThreadReplies(parentMessageId) {
            try {
              const res = await fetch(`/api/messages/thread/${parentMessageId}`);
              const data = await res.json();
              const threadContainer = document.getElementById('threadReplies');

              let html = '';

              if (data.success && data.replies && data.replies.length > 0) {
                const repliesHtml = data.replies.map(reply => `
                  <div style="padding: 1rem; background: var(--muted); border-radius: var(--radius); margin-bottom: 0.5rem;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                      <strong>${reply.senderId?.name || 'Unknown'}</strong>
                      <small>${new Date(reply.sentAt).toLocaleString()}</small>
                    </div>
                    <div style="white-space: pre-wrap;">${escapeHtml(reply.body)}</div>
                  </div>
                `).join('');

                html = '<h5>Replies</h5>' + repliesHtml;

                // Add a Reply button at the bottom of the thread section
                html += `
                  <div style="margin-top: 0.75rem; text-align: right;">
                    <button type="button" class="btn btn-sm btn-outline" onclick="replyToThread('${parentMessageId}')">
                      Reply to thread
                    </button>
                  </div>
                `;
              } else {
                // Even if no replies yet, we can still allow replying to start the thread
                html = `
                  <div style="margin-top: 0.5rem; text-align: right;">
                    <button type="button" class="btn btn-sm btn-outline" onclick="replyToThread('${parentMessageId}')">
                      Reply to this message
                    </button>
                  </div>
                `;
              }

              threadContainer.innerHTML = html;
            } catch (err) {
              console.error('Error loading thread:', err);
            }
          }

          function replyToThread(parentMessageId) {
            if (!parentMessageId) return;

            closeMessageModal();

            // Open the notification dropdown if it's not already visible
            if (notificationDropdown && notificationDropdown.style.display !== 'block') {
              notificationDropdown.style.display = 'block';
            }

            // Switch to compose tab in the notification dropdown
            const composeTab = document.querySelector('[data-tab="compose"]');
            if (composeTab) composeTab.click();

            const subject = currentMessage?.subject || '(No subject)';
            const subjectInput = document.getElementById('composeSubject');
            if (subjectInput) subjectInput.value = 'Re: ' + subject;

            const parentInput = document.getElementById('composeParentMessageId');
            if (parentInput) parentInput.value = parentMessageId;

            // Try to pre-select the original sender if possible
            const recipientSelect = document.getElementById('composeRecipientSelect');
            const rawSender = currentMessage?.senderId;
            const senderId = rawSender ? (rawSender._id || rawSender) : null;

            if (recipientSelect && senderId) {
              Array.from(recipientSelect.options).forEach(opt => opt.selected = false);
              const senderOption = Array.from(recipientSelect.options).find(opt => opt.value === senderId.toString());
              if (senderOption) senderOption.selected = true;
            }
          }
          window.replyToThread = replyToThread;

          // Load initial notifications (populates badge count and caches data for instant dropdown open)
          loadNotificationsData();

        })();

       </script>

       <!-- School Onboarding Modal JavaScript -->
       <script nonce="<%= cspNonce %>">
         (function() {
           'use strict';

           const onboardingModal = document.getElementById('onboardingModal');
           const onboardingForm = document.getElementById('onboardingForm');
           const onboardingTitle = document.getElementById('onboardingModalTitle');
           const prevStepBtn = document.getElementById('prevStepBtn');
           const nextStepBtn = document.getElementById('nextStepBtn');
           const steps = document.querySelectorAll('.onboarding-step');
           const messageEl = document.getElementById('onboardingMessage');
           let currentStep = 0;
           let editingSchoolId = null;

           // Expose globally for onclick handlers
           window.DashboardUtils = window.DashboardUtils || {};

           // Helper: Show step
           function showStep(index) {
             steps.forEach((step, i) => {
               step.style.display = i === index ? 'grid' : 'none';
             });
             // Update step indicators
             document.querySelectorAll('[id^="step-indicator-"]').forEach((el, i) => {
               el.style.fontWeight = i === index ? 'bold' : 'normal';
               el.style.color = i === index ? 'var(--primary)' : 'var(--muted-foreground)';
             });
             prevStepBtn.style.display = index === 0 ? 'none' : 'inline-block';
             nextStepBtn.textContent = index === steps.length - 1 ? 'Save School' : 'Next Step';
            }

            let isEditingMode = false;

            // Open modal for creating new school or editing existing
            window.DashboardUtils.openOnboardingModal = function(schoolId = null) {
              editingSchoolId = schoolId;

              if (schoolId) {
                isEditingMode = true;
                onboardingTitle.textContent = 'Edit School';

                // Record the school id for deduplication (so the update handler can exclude this record)
                document.querySelector('[name="schoolId"]').value = schoolId;

                // Fetch school data via the onboarding-data endpoint (flat field names matching the form)
                fetch(`/api/schools/${schoolId}/onboard-data`)
                  .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                  })
                  .then(result => {
                    if (!result.success) throw new Error(result.error || 'Failed');

                    const data = result.data;
                    document.querySelector('[name="name"]').value = data.name || '';
                    document.querySelector('[name="street"]').value = data.street || '';
                    document.querySelector('[name="city"]').value = data.city || '';
                    document.querySelector('[name="state"]').value = data.state || '';
                    document.querySelector('[name="zipCode"]').value = data.zipCode || '';
                    document.querySelector('[name="country"]').value = data.country || 'Kenya';
                    document.querySelector('[name="zone"]').value = data.zone || '';
                    document.querySelector('[name="region"]').value = data.region || '';
                    document.querySelector('[name="studentCount"]').value = data.studentCount || 0;

                    document.querySelector('[name="contactName"]').value = data.contactName || '';
                    document.querySelector('[name="contactEmail"]').value = data.contactEmail || '';
                    document.querySelector('[name="contactPhone"]').value = data.contactPhone || '';
                    document.querySelector('[name="contactPosition"]').value = data.contactPosition || '';

                    document.querySelector('[name="notes"]').value = data.notes || '';

                    if (data.programId) {
                      const programSelect = document.getElementById('programSelect');
                      programSelect.value = data.programId;
                      programSelect.dispatchEvent(new Event('change'));
                      if (data.ratePerStudent) {
                        document.getElementById('ratePerStudent').value = data.ratePerStudent;
                      }
                    }
                    document.querySelector('[name="primaryTrainerId"]').value = data.primaryTrainerId || '';
                    showStep(0);
                  })
                  .catch(err => {
                    console.error('Error loading school:', err);
                    // Reset edit state so submit always routes to the correct endpoint
                    editingSchoolId = null;
                    isEditingMode = false;
                    showMessage('Failed to load school data: ' + err.message, true);
                    // Return to clean create mode
                    onboardingTitle.textContent = 'Onboard New School';
                    onboardingForm.reset();
                    showStep(0);
                  });
              } else {
                editingSchoolId = null;
                isEditingMode = false;
                onboardingTitle.textContent = 'Onboard New School';
                onboardingForm.reset();
                showStep(0);
              }
              onboardingModal.style.display = 'flex';
            };

            function closeOnboardingModal() {
              onboardingModal.style.display = 'none';
              editingSchoolId = null;
              isEditingMode = false;
              window._onboardingSubmitBusy = false;
              messageEl.style.display = 'none';
            }
           window.closeOnboardingModal = closeOnboardingModal;

           function showMessage(msg, isError = false) {
             messageEl.textContent = msg;
             messageEl.style.display = 'block';
             messageEl.className = isError ? 'message error' : 'message success';
             setTimeout(() => { messageEl.style.display = 'none'; }, 3000);
           }

           // Step navigation
           function validateStep(index) {
             if (index === 0) {
               const name = document.querySelector('[name="name"]').value.trim();
               if (!name) {
                 showMessage('School name is required', true);
                 return false;
               }
             }
             if (index === 1) {
               const email = document.querySelector('[name="contactEmail"]').value.trim();
               const phone = document.querySelector('[name="contactPhone"]').value.trim();
               if (!email || !phone) {
                 showMessage('Contact email and phone are required', true);
                 return false;
               }
             }
             if (index === 2) {
               const programId = document.getElementById('programSelect').value;
               if (!programId) {
                 showMessage('Please select a program', true);
                 return false;
               }
             }
             return true;
           }

           prevStepBtn.addEventListener('click', () => {
             if (currentStep > 0) {
               currentStep--;
               showStep(currentStep);
             }
           });

           nextStepBtn.addEventListener('click', () => {
             if (!validateStep(currentStep)) return;
             if (currentStep < steps.length - 1) {
               currentStep++;
               showStep(currentStep);
             } else {
               submitOnboardingForm();
             }
           });

           // Program price auto-fill
           document.getElementById('programSelect')?.addEventListener('change', function() {
             const selected = this.options[this.selectedIndex];
             const price = selected.dataset.price || '0';
             document.getElementById('ratePerStudent').value = price;
             document.getElementById('selectedProgramPrice').textContent = `Rate: KES ${price}`;
           });

            // Form submission
            async function submitOnboardingForm() {
              if (window._onboardingSubmitBusy) return;
              window._onboardingSubmitBusy = true;
              const formData = {
               name: document.querySelector('[name="name"]').value.trim(),
               street: document.querySelector('[name="street"]').value.trim(),
               city: document.querySelector('[name="city"]').value.trim(),
               state: document.querySelector('[name="state"]').value.trim(),
               zipCode: document.querySelector('[name="zipCode"]').value.trim(),
               country: document.querySelector('[name="country"]').value.trim(),
               zone: document.querySelector('[name="zone"]').value.trim(),
               region: document.querySelector('[name="region"]').value.trim(),
               studentCount: parseInt(document.querySelector('[name="studentCount"]').value) || 0,
               contactName: document.querySelector('[name="contactName"]').value.trim(),
               contactEmail: document.querySelector('[name="contactEmail"]').value.trim(),
               contactPhone: document.querySelector('[name="contactPhone"]').value.trim(),
               contactPosition: document.querySelector('[name="contactPosition"]').value.trim(),
               notes: document.querySelector('[name="notes"]').value.trim(),
               programId: document.getElementById('programSelect').value,
               primaryTrainerId: document.querySelector('[name="primaryTrainerId"]').value || null,
               schoolId: document.querySelector('[name="schoolId"]')?.value || ''
              };

              try {
                let url, method, data;
                if (editingSchoolId && isEditingMode) {
                 url = `/api/schools/${editingSchoolId}/update`;
                 method = 'POST';
                 data = formData;
               } else {
                 url = '/dashboard/schools/onboard';
                 method = 'POST';
                 data = formData;
               }
                const res = await fetch(url, {
                  method: method,
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify(data)
                });
                const result = await res.json();
                if (result.duplicate && result.schoolId) {
                  // A school with the same name already exists in the system (create flow only)
                  showMessage(`⚠ School "${result.schoolName}" already exists. Redirecting to existing record...`, false);
                  setTimeout(() => {
                    window.location.href = `/dashboard/schools/${result.schoolId}`;
                  }, 1500);
                } else if (result.success || result.school) {
                  if (editingSchoolId) {
                    // Edit mode: show a blocking confirmation popup so the user always sees the success message
                    const savedName = (result.school && result.school.name) || (document.querySelector('[name="name"]').value.trim());
                    closeOnboardingModal();
                    setTimeout(() => {
                      window.alert('School "' + savedName + '" updated successfully! Changes have been saved.');
                      window.location.reload();
                    }, 100);
                  } else {
                    showMessage('School onboarded successfully!');
                    closeOnboardingModal();
                    window.location.reload();
                  }
                } else {
                  showMessage(result.error || 'Operation failed', true);
                  window._onboardingSubmitBusy = false;
                }
              } catch (err) {
                console.error('Error saving school:', err);
                editingSchoolId = null;
                isEditingMode = false;
                window._onboardingSubmitBusy = false;
                showMessage('Network error', true);
              }
            }

            // Initialize: show first step
            showStep(0);

         })();

         // Also expose at window level for inline onclick handlers
         window.openOnboardingModal = function(schoolId) {
           window.DashboardUtils.openOnboardingModal(schoolId);
         };
       </script>

      <% if (page === 'analytics') { %>
         <script src="/js/chart.umd.min.js"></script>
        <script src="/js/analytics_dashboard.js"></script>
